<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        xmlns:widgets="clr-namespace:DynamicIsland.Views.Widgets"
        Title="Dynamic Island"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="680" Height="580"
        MinWidth="680" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootTranslateTransform" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Ambient halo / back-glow responding to media artwork accent and bass FFT (zero-shader radial falloff) -->
        <Border x:Name="PillGlow" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="120" Height="28" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop x:Name="PillGlowColor" Color="#FF9F0A" Offset="0" />
                    <GradientStop x:Name="PillGlowSecondaryColor" Color="#55FF9F0A" Offset="0.52" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Living Island Nature Theme Underlay (Behind Pill: Vines, Stems, Leaves, Blossoms) -->
        <core:IslandNatureThemeControl x:Name="IslandThemeUnderlay"
                                      Layer="Underlay"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- The morphing pill. Width/Height/CornerRadius are driven per-frame by analytical springs + gooey deformation. -->
        <Grid x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="148" Height="30" Background="Transparent"
              RenderTransformOrigin="0.5,0"
              MouseMove="Pill_MouseMove"
              MouseLeave="Pill_MouseLeave"
              PreviewMouseDown="Pill_PreviewMouseDown"
              PreviewMouseWheel="Pill_PreviewMouseWheel">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PillDeformScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Outward Concave Bezel Ears (Left & Right) for MacBook-style Hardware Notch -->
            <Path x:Name="NotchLeftEar" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="-10,0,0,0" Width="10" Height="10"
                  Data="M 0,0 L 10,0 L 10,10 A 10,10 0 0 1 0,0 Z"
                  Fill="{DynamicResource PillNotchEarBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
            <Path x:Name="NotchRightEar" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,0,-10,0" Width="10" Height="10"
                  Data="M 0,10 L 0,0 L 10,0 A 10,10 0 0 1 0,10 Z"
                  Fill="{DynamicResource PillNotchEarBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Morphing dynamic island capsule surface (Dark / Light adaptive) -->
            <Border x:Name="PillBackground" CornerRadius="0,0,15,15" Background="{DynamicResource PillBackgroundBrush}">
                <Border.Effect>
                    <DropShadowEffect x:Name="PillDropShadow" BlurRadius="28" ShadowDepth="4" Direction="270"
                                      Opacity="0.55" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
            </Border>

            <!-- Frosted Inner Sheen / Specular Light Wash -->
            <Border x:Name="PillGlassSheen" CornerRadius="0,0,15,15" Background="{DynamicResource PillGlassSheenBrush}" IsHitTestVisible="False" />

            <!-- Hairline Outer Refraction Rim -->
            <Border x:Name="PillStroke" CornerRadius="0,0,15,15" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource PillStrokeBrush}" />

            <!-- Hardware Notch Simulated TrueDepth Camera Lens & Privacy LED -->
            <Grid x:Name="NotchCameraHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,3,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Camera Lens with iridescent glass specular glare -->
                    <Border Width="8" Height="8" CornerRadius="4" Background="#0C0C14" BorderBrush="#22FFFFFF" BorderThickness="0.75">
                        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#7064D2FF" Offset="0" />
                                    <GradientStop Color="#258A5AF2" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <!-- Privacy Status LED (Green = Camera, Amber = Mic) -->
                    <Ellipse x:Name="NotchPrivacyLed" Width="3.5" Height="3.5" Margin="5,0,0,0" Fill="#30D158" Visibility="Collapsed">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#30D158" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentHost" ClipToBounds="False">

                <!-- ── Idle (120x28) ────────────────────────────────── -->
                <Grid x:Name="IdlePanel" Height="30" ClipToBounds="False"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Privacy & Hardware Lens Cluster -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <!-- Camera Active Dot (iOS Green) -->
                            <Grid x:Name="CamPrivacyDot" Margin="0,0,4,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Camera In Use">
                                <Ellipse Width="10" Height="10">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#8030D158" Offset="0" />
                                            <GradientStop Color="#0030D158" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="5.5" Height="5.5" Fill="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Microphone Active Dot (iOS Orange) -->
                            <Grid x:Name="MicPrivacyDot" Margin="0,0,4,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Microphone In Use">
                                <Ellipse Width="10" Height="10">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#80FF9F0A" Offset="0" />
                                            <GradientStop Color="#00FF9F0A" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="5.5" Height="5.5" Fill="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Recessed TrueDepth Camera Lens Ring when idle -->
                            <Grid x:Name="IdleSensorDot" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#0E0E13" Stroke="#24242E" StrokeThickness="1" />
                                <Ellipse Width="3" Height="3" Fill="#1D1D28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Dynamic Clock Host (Switched via ClockStyle setting) -->
                        <!-- 1. Minimal Style (Clean Apple OLED) -->
                        <TextBlock x:Name="IdleClock" Style="{StaticResource Digits}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" VerticalAlignment="Center" />

                        <!-- 2. Seconds Style (Precision Chronograph with Accent Seconds Badge) -->
                        <StackPanel x:Name="IdleClockSecondsHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="IdleClockSecHMin" Style="{StaticResource Digits}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" VerticalAlignment="Center" />
                            <Border Background="#25FF9F0A" BorderBrush="#50FF9F0A" BorderThickness="1" CornerRadius="4" Padding="3,0.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="IdleClockSecDigits" Style="{StaticResource Digits}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Text="00" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- 3. Date Badge Style (Apple Calendar Glass Chip + Time) -->
                        <StackPanel x:Name="IdleClockDateHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4.5,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                <TextBlock x:Name="IdleClockDateBadgeText" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Text="Sat 7" />
                            </Border>
                            <TextBlock x:Name="IdleClockDateHMin" Style="{StaticResource Digits}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 4. Swiss Railway Analog Watch Face (Precision Micro Dial) -->
                        <StackPanel x:Name="IdleClockAnalogHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource ClockDialFaceBrush}" Stroke="{DynamicResource ClockDialBorderBrush}" StrokeThickness="0.8" />
                                <!-- Hour Ticks at 12, 3, 6, 9 -->
                                <Rectangle Width="1.2" Height="2" Fill="{DynamicResource ClockHandBrush}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0" RadiusX="0.5" RadiusY="0.5" />
                                <Rectangle Width="1.2" Height="1.8" Fill="{DynamicResource ClockHandBrush}" Opacity="0.6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1" RadiusX="0.5" RadiusY="0.5" />
                                <Rectangle Width="1.8" Height="1.2" Fill="{DynamicResource ClockHandBrush}" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" RadiusX="0.5" RadiusY="0.5" />
                                <Rectangle Width="1.8" Height="1.2" Fill="{DynamicResource ClockHandBrush}" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" RadiusX="0.5" RadiusY="0.5" />
                                <!-- Hour Hand -->
                                <Line X1="9" Y1="9" X2="9" Y2="5" Stroke="{DynamicResource ClockHandBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="AnalogHourTransform" Angle="0" CenterX="9" CenterY="9" />
                                    </Line.RenderTransform>
                                </Line>
                                <!-- Minute Hand -->
                                <Line X1="9" Y1="9" X2="9" Y2="3" Stroke="{DynamicResource ClockHandBrush}" Opacity="0.85" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="AnalogMinTransform" Angle="0" CenterX="9" CenterY="9" />
                                    </Line.RenderTransform>
                                </Line>
                                <!-- Sweeping Second Hand (Swiss Red/Orange) -->
                                <Line X1="9" Y1="9" X2="9" Y2="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="AnalogSecTransform" Angle="0" CenterX="9" CenterY="9" />
                                    </Line.RenderTransform>
                                </Line>
                                <!-- Center Pinion Jewel -->
                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="IdleClockAnalogHMin" Style="{StaticResource Digits}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 5. Cyber Neon Aura Style (Dual-Stage Illuminated Cathode Glow) -->
                        <Grid x:Name="IdleClockNeonHost" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="IdleClockNeonGlow" Style="{StaticResource Digits}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Text="12:00"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="NeonClockGlowEffect" BlurRadius="16" ShadowDepth="0" Color="#FF9F0A" Opacity="0.95" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="IdleClockNeon" Style="{StaticResource Digits}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" Opacity="0.95"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 6. Retro Split-Flap Card Style (Solari di Udine Mechanical Flaps) -->
                        <StackPanel x:Name="IdleClockFlipHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Background="{DynamicResource ClockTileBgBrush}" BorderBrush="{DynamicResource ClockTileBorderBrush}" BorderThickness="0.8" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="IdleFlipHourText" Style="{StaticResource Digits}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ClockTileFgBrush}" HorizontalAlignment="Center" Text="12" />
                                    <Border Height="0.8" Background="{DynamicResource ClockTileDividerBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="-4,0" />
                                    <Border Height="0.5" Background="{DynamicResource ClockTileBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="-4,1,-4,0" Opacity="0.5" />
                                </Grid>
                            </Border>
                            <TextBlock Text=":" Style="{StaticResource Digits}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2.5,-1,2.5,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource ClockTileBgBrush}" BorderBrush="{DynamicResource ClockTileBorderBrush}" BorderThickness="0.8" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="IdleFlipMinText" Style="{StaticResource Digits}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ClockTileFgBrush}" HorizontalAlignment="Center" Text="00" />
                                    <Border Height="0.8" Background="{DynamicResource ClockTileDividerBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="-4,0" />
                                    <Border Height="0.5" Background="{DynamicResource ClockTileBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="-4,1,-4,0" Opacity="0.5" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Micro Network Speed in Idle (Optional, enabled via Settings) -->
                        <StackPanel x:Name="IdleNetSpeedHost" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"
                                    Cursor="Hand" MouseLeftButtonDown="IdleNetSpeed_Click" ToolTip="Live Internet Throughput · Click to open Wi-Fi &amp; Network Hub">
                            <TextBlock x:Name="IdleNetSpeedGlyph" Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="8" Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="IdleNetSpeedText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="0K" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Virtual Pet Companion (Idle • Snoozes, Blinks, reacts to cursor & clicks) -->
                        <core:VirtualPetControl x:Name="IdlePetCompanion" Width="28" Height="24" Margin="6,0,0,0"
                                                VerticalAlignment="Center" Cursor="Hand" Panel.ZIndex="10"
                                                ClipToBounds="False"
                                                RenderTransformOrigin="0.5,0.5"
                                                MouseLeftButtonDown="PetCompanion_Click"
                                                MouseRightButtonUp="PetCompanion_RightClick"
                                                ToolTip="Virtual Pet Companion · Click to pet · Right-click for 360° flip trick!">
                            <core:VirtualPetControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="IdlePetScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="IdlePetTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </core:VirtualPetControl.RenderTransform>
                        </core:VirtualPetControl>
                        <!-- Idle Ambient High-Load Alert Badge (Appears when CPU > 80% or RAM > 85%) -->
                        <Border x:Name="SystemHudAlertPill" Visibility="Collapsed" Background="#28FF9F0A" BorderBrush="#60FF9F0A"
                                BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" Cursor="Hand"
                                MouseLeftButtonDown="SystemHudAlertPill_Click" VerticalAlignment="Center" ToolTip="High Resource Usage Detected &#x2022; Click to open System HUD">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SystemHudAlertText" Text="&#x1F525; 91% CPU" FontSize="9" FontWeight="SemiBold" Foreground="#FF9F0A" TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Compact Live Activity (220x34) ───────────────── -->
                <Grid x:Name="CompactPanel" Width="228" Height="36" ClipToBounds="False"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- Leading Region (Left) -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0">
                        <Grid x:Name="CompactMediaHost" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="6" Background="#1AFFFFFF" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="CompactArtFallback" Style="{StaticResource Glyph}"
                                                   Text="&#xE8D6;" FontSize="10.5" HorizontalAlignment="Center" Foreground="#86868B" />
                                        <Image x:Name="CompactArtImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="CompactTrackText" FontSize="11.5" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0" MaxWidth="112"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Title" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CompactCallHost" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CompactCallBadge" Width="20" Height="20" CornerRadius="10" Background="#2630D158" ClipToBounds="True">
                                    <TextBlock x:Name="CompactCallGlyph" Style="{StaticResource Glyph}" Text="&#xE717;" FontSize="10.5" HorizontalAlignment="Center" Foreground="#30D158" />
                                </Border>
                                <TextBlock x:Name="CompactCallText" Style="{StaticResource Digits}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#30D158" Margin="8,0,0,0" MaxWidth="136"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Call" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CompactDownloadHost" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#260A84FF" ClipToBounds="True">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="10.5" HorizontalAlignment="Center" Foreground="#0A84FF" />
                                </Border>
                                <TextBlock x:Name="CompactDownloadText" FontSize="11.5" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0" MaxWidth="136"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Downloading" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CompactRecordHost" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#26FF453A" ClipToBounds="True">
                                    <Ellipse Width="7" Height="7" Fill="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="CompactRecordText" Style="{StaticResource Digits}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#FF453A" Margin="8,0,0,0" MaxWidth="112"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="00:00" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CompactActivityHost" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CompactActivityBadge" Width="20" Height="20" CornerRadius="10" Background="#260A84FF" ClipToBounds="True">
                                    <TextBlock x:Name="CompactActivityGlyph" Style="{StaticResource Glyph}" Text="&#xE7C3;" FontSize="10" HorizontalAlignment="Center" Foreground="#0A84FF" />
                                </Border>
                                <StackPanel Margin="7,0,0,0" VerticalAlignment="Center" MaxWidth="126">
                                    <TextBlock x:Name="CompactActivityTitle" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" Text="Activity" />
                                    <TextBlock x:Name="CompactActivitySubtitle" FontSize="9.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" Text="" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CompactTimerHost">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#22FF9F0A">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="10.5"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock x:Name="CompactTimer" Style="{StaticResource Digits}" Margin="8,0,0,0"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Text="00:00" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Trailing Region (Right): Live 4-band audio waveform -->
                    <!-- Trailing Region (Right): Live Audio Visualizer Host & Dancing Companion Pet -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <core:VirtualPetControl x:Name="CompactPetCompanion" Width="26" Height="24" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Cursor="Hand" Panel.ZIndex="10"
                                                ClipToBounds="False"
                                                RenderTransformOrigin="0.5,0.5"
                                                MouseLeftButtonDown="PetCompanion_Click"
                                                MouseRightButtonUp="PetCompanion_RightClick"
                                                ToolTip="Virtual Pet Companion · Grooving to the beats! Click to pet · Right-click to flip.">
                            <core:VirtualPetControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CompactPetScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="CompactPetTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </core:VirtualPetControl.RenderTransform>
                        </core:VirtualPetControl>

                        <Grid x:Name="CompactVisualizerHost" VerticalAlignment="Center"
                              Cursor="Hand" MouseLeftButtonDown="CompactVisualizer_Click"
                              ToolTip="Live Audio Visualizer · Click to switch theme">
                            <!-- 1. Classic Minimalist Bars -->
                            <StackPanel x:Name="VisualizerBarsHost" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="Bar0" Style="{StaticResource Bar}" />
                                <Rectangle x:Name="Bar1" Style="{StaticResource Bar}" />
                                <Rectangle x:Name="Bar2" Style="{StaticResource Bar}" />
                                <Rectangle x:Name="Bar3" Style="{StaticResource Bar}" />
                            </StackPanel>

                            <!-- 2. Continuous Flowing Waveform Ribbon (Oscilloscope) -->
                            <Grid x:Name="VisualizerWaveHost" Visibility="Collapsed" Width="20" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="CompactWavePath" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center">
                                    <Path.Data>
                                        <PathGeometry x:Name="CompactWaveGeometry" />
                                    </Path.Data>
                                </Path>
                            </Grid>

                            <!-- 2. Organic Liquid Blob -->
                            <Grid x:Name="VisualizerBlobHost" Visibility="Collapsed" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse x:Name="BlobOuterGlow" Width="16" Height="16" Opacity="0.4" Fill="{DynamicResource AccentBrush}">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="5" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Border x:Name="BlobCore" Width="11" Height="11" CornerRadius="5.5" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="BlobScale" ScaleX="1" ScaleY="1" />
                                            <RotateTransform x:Name="BlobRotate" Angle="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- 3. Neon Aurora Multi-Color Columns -->
                            <Grid x:Name="VisualizerAuroraHost" Visibility="Collapsed" Width="20" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Rectangle x:Name="AuroraBar0" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="0.75,0" Fill="#00F0FF" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="AuroraScale0" ScaleY="0.25" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#00F0FF" Opacity="0.8" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Rectangle x:Name="AuroraBar1" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="0.75,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="AuroraScale1" ScaleY="0.25" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF9F0A" Opacity="0.9" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Rectangle x:Name="AuroraBar2" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="0.75,0" Fill="#BF5AF2" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="AuroraScale2" ScaleY="0.25" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#BF5AF2" Opacity="0.8" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Rectangle x:Name="AuroraBar3" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="0.75,0" Fill="#30D158" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="AuroraScale3" ScaleY="0.25" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#30D158" Opacity="0.8" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                            </Grid>

                            <!-- 4. Siri Fluid Orb (Iridescent Concentric Glowing Rings) -->
                            <Grid x:Name="VisualizerSiriHost" Visibility="Collapsed" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse x:Name="SiriAura" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#00F0FF" Offset="0.15" />
                                            <GradientStop Color="#BF5AF2" Offset="0.55" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SiriRotate" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="SiriCore" Width="8.5" Height="8.5" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="SiriCoreScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="White" Opacity="0.7" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>

                        <Border x:Name="CompactActivityTrailingBadge" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="0,0,4,0" Background="#1AFFFFFF"
                                CornerRadius="8" Padding="6,2">
                            <TextBlock x:Name="CompactActivityTrailingText" Style="{StaticResource Digits}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Text="" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Toast / Alert Banner (320x56) ────────────────── -->
                <Grid x:Name="ToastPanel" Width="336" Height="58"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ToastIconBg" Width="34" Height="34" CornerRadius="17"
                                VerticalAlignment="Center" Background="#280A84FF">
                            <TextBlock x:Name="ToastGlyph" Style="{StaticResource Glyph}" HorizontalAlignment="Center"
                                       FontSize="15" Foreground="#0A84FF" Text="&#xE767;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="Volume" />
                            <TextBlock x:Name="ToastSubtitle" FontSize="11.5" Margin="0,1,0,0"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Text="65%" />
                        </StackPanel>

                        <Button x:Name="ToastReplyButton" Grid.Column="2"
                                Visibility="Collapsed"
                                Style="{StaticResource IslandButton}"
                                Height="26" Padding="8,0" Margin="0"
                                VerticalAlignment="Center"
                                Click="ToastReplyButton_Click"
                                ToolTipService.ToolTip="Quick Reply directly in Dynamic Island">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ToastReplyGlyph" Style="{StaticResource Glyph}" Text="&#xE725;" FontSize="9.5" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ToastReplyText" Text="Reply" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ── Expanded Interactive Surface (Clean Content Card) ───────── -->
                <Grid x:Name="ExpandedPanel" Width="484" Height="176"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="14,10,14,10" ClipToBounds="True">
                        <widgets:MediaView x:Name="MediaContainer" />
                        <widgets:CalendarTaskView x:Name="CalendarContainer" Visibility="Collapsed" />
                        <widgets:ShelfView x:Name="ShelfContainer" Visibility="Collapsed" />
                        <widgets:ClipboardView x:Name="ClipboardContainer" Visibility="Collapsed" />
                        <widgets:CalcView x:Name="CalcContainer" Visibility="Collapsed" />
                        <widgets:NotesView x:Name="NotesContainer" Visibility="Collapsed" />
                        <widgets:SettingsView x:Name="SettingsContainer" Visibility="Collapsed" />
                        <widgets:AudioView x:Name="AudioContainer" Visibility="Collapsed" />
                        <widgets:BatteryView x:Name="BatteryContainer" Visibility="Collapsed" />
                        <widgets:VoiceMemoView x:Name="VoiceMemoContainer" Visibility="Collapsed" />
                        <widgets:PeripheralsView x:Name="PeripheralsContainer" Visibility="Collapsed" />
                        <widgets:NetworkView x:Name="NetworkContainer" Visibility="Collapsed" />
                        <widgets:NotificationsView x:Name="NotificationsContainer" Visibility="Collapsed" />
                        <widgets:SystemHudView x:Name="SystemHudContainer" Visibility="Collapsed" />
                        <widgets:ConverterView x:Name="ConverterContainer" Visibility="Collapsed" />
                        <widgets:LauncherView x:Name="LauncherContainer" Visibility="Collapsed" />
                        <widgets:TermiNotchView x:Name="TermiContainer" Visibility="Collapsed" />
                        <widgets:PhoneBridgeView x:Name="PhoneBridgeContainer" Visibility="Collapsed" />
                        <widgets:MechSoundsView x:Name="MechSoundsContainer" Visibility="Collapsed" />
                        <widgets:CaptureStudioView x:Name="CaptureStudioContainer" Visibility="Collapsed" />
                        <widgets:QuickReplyView x:Name="QuickReplyContainer" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Concentric Drop Zone Overlay when dragging files over the island -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6050507" CornerRadius="0,0,16,16">
                <Border Margin="3" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="0,0,13,13" Background="#180A84FF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2EFFFFFF" HorizontalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Drop to Shelf" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Hold files &amp; paste anywhere" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Living Island Nature Theme Overlay (In Front of Pill: Butterflies, Drifting Pollen, Tumbling Petals) -->
        <core:IslandNatureThemeControl x:Name="IslandThemeOverlay"
                                      Layer="Overlay"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- ── Floating Bottom Navigation Dock (Apple Fluid Capsule) ────────────────── -->
        <Border x:Name="FloatingDockHost"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Height="40" MaxWidth="484"
                Margin="0,0,0,0"
                CornerRadius="20"
                Background="{DynamicResource FloatingDockBackgroundBrush}"
                BorderBrush="{DynamicResource FloatingDockBorderBrush}"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270"
                                  Opacity="0.55" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FloatingDockScale" ScaleX="0.92" ScaleY="0.92" />
                    <TranslateTransform x:Name="FloatingDockTranslate" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Margin="7,0,7,0">
                <!-- 1. Home / Now Playing Overview (Image 2) -->
                <Button x:Name="MediaHomeButton" AutomationProperties.Name="Home Overview" Style="{StaticResource DockIconButton}" ToolTip="Home · Now Playing &amp; Vitals (Ctrl+1)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE80F;" />
                </Button>

                <!-- 2. Apple Notch Calendar & Tasks (Image 2) -->
                <Button x:Name="CalendarButton" AutomationProperties.Name="Calendar and Tasks" Style="{StaticResource DockIconButton}" ToolTip="Calendar &amp; Tasks (Ctrl+2)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE787;" />
                </Button>

                <!-- 3. Drop Shelf & Files (Image 2) -->
                <Button x:Name="ShelfButton" AutomationProperties.Name="Drop Shelf and Files" Style="{StaticResource DockIconButton}" ToolTip="Drop Shelf &amp; Files (Ctrl+3)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE8B7;" />
                </Button>

                <!-- 4. Notification Center (Bell with Live Unread Badge) -->
                <Button x:Name="NotificationsButton" AutomationProperties.Name="Notification Center" Style="{StaticResource DockIconButton}" ToolTip="Notification Center (Ctrl+4 / Ctrl+Alt+N)">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationsButtonGlyph" Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xEA8F;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="NotificationsBadgeHost" Visibility="Collapsed" Background="{DynamicResource AccentBrush}"
                                CornerRadius="5" MinWidth="11" Height="11" Padding="2,0" Margin="6,-6,-6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="NotificationsBadgeText" Text="0" FontSize="7.5" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 5. Media & Sound (Image 2) -->
                <Button x:Name="AudioButton" AutomationProperties.Name="Audio and Music" Style="{StaticResource DockIconButton}" ToolTip="Music &amp; Audio (Ctrl+5)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE8D6;" />
                </Button>

                <!-- 6. All Apps & Widgets Grid Launcher (Image 2) -->
                <Button x:Name="LauncherButton" AutomationProperties.Name="Apps and Widgets" Style="{StaticResource DockIconButton}" ToolTip="Apps &amp; Widgets Panel (Ctrl+6)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xF0E2;" />
                </Button>

                <!-- Subtle Vertical Apple Divider -->
                <Border Width="1" Height="16" Background="{DynamicResource MenuSeparator}" Margin="5,0,5,0" VerticalAlignment="Center" />

                <!-- Action Cluster: Pin, Settings, Collapse -->
                <Button x:Name="PinExpandedButton" AutomationProperties.Name="Pin Expanded Island" Click="PinExpandedButton_Click"
                        Style="{StaticResource FloatingDockUtilityButton}" Margin="0,0,2,0" ToolTip="Pin Expanded (Stay Open on Mouse Leave)">
                    <TextBlock x:Name="PinExpandedGlyph" Style="{StaticResource Glyph}" FontSize="11" Text="&#xE718;" />
                </Button>
                <Button x:Name="SettingsButton" AutomationProperties.Name="Appearance and Settings"
                        Style="{StaticResource FloatingDockUtilityButton}" Margin="0,0,2,0" ToolTip="Appearance &amp; Settings (Ctrl+Alt+S)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11.5" Text="&#xE713;" />
                </Button>
                <Button x:Name="CollapseButton" AutomationProperties.Name="Collapse Dynamic Island" Click="CollapseButton_Click"
                        Style="{StaticResource FloatingDockUtilityButton}" Margin="0" ToolTip="Collapse (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE70E;" />
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <!-- Collapsed Helper Elements to preserve named references for background services -->
        <Grid Visibility="Collapsed" IsHitTestVisible="False">
            <ScrollViewer x:Name="DockScrollViewer" />
            <Button x:Name="ClipboardButton">
                <TextBlock x:Name="ClipboardBadgeText" />
            </Button>
            <Button x:Name="ShelfBadgeHost">
                <TextBlock x:Name="ShelfBadgeText" />
            </Button>
            <Button x:Name="CalcButton" />
            <Button x:Name="NotesButton" />
            <Button x:Name="ConverterButton">
                <TextBlock x:Name="ConverterButtonGlyph" />
            </Button>
            <Button x:Name="TermiButton">
                <TextBlock x:Name="TermiButtonGlyph" />
            </Button>
            <Button x:Name="PhoneBridgeButton">
                <TextBlock x:Name="PhoneBridgeButtonGlyph" />
            </Button>
            <Button x:Name="MechSoundsButton">
                <TextBlock x:Name="MechSoundsButtonGlyph" />
            </Button>
            <Button x:Name="CaptureStudioButton">
                <TextBlock x:Name="CaptureStudioButtonGlyph" />
            </Button>
            <Button x:Name="BatteryButton">
                <StackPanel>
                    <TextBlock x:Name="BatteryButtonGlyph" />
                    <TextBlock x:Name="BatteryBadgeText" />
                </StackPanel>
            </Button>
            <Button x:Name="SystemHudButton">
                <StackPanel>
                    <TextBlock x:Name="SystemHudButtonGlyph" />
                    <TextBlock x:Name="SystemHudBadgeText" />
                </StackPanel>
            </Button>
            <Button x:Name="RecordButton">
                <StackPanel>
                    <TextBlock x:Name="RecordButtonGlyph" />
                    <TextBlock x:Name="RecordBadgeText" />
                </StackPanel>
            </Button>
            <Button x:Name="PeripheralsButton">
                <TextBlock x:Name="PeripheralsButtonGlyph" />
            </Button>
            <Button x:Name="NetworkButton">
                <TextBlock x:Name="NetworkButtonGlyph" />
            </Button>
            <Button x:Name="MicMuteButton">
                <TextBlock x:Name="MicMuteGlyph" />
            </Button>
            <TextBlock x:Name="AudioButtonGlyph" />
            <TextBlock x:Name="LauncherButtonGlyph" />
        </Grid>

        <!-- iOS-Style Split-Droplet Secondary Activity Bubble (Detaches when 2 live activities run simultaneously in Compact mode) -->
        <Border x:Name="SecondaryDroplet" Width="30" Height="30" CornerRadius="15"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed" Opacity="0" Cursor="Hand"
                RenderTransformOrigin="0.5,0.5"
                PreviewMouseDown="SecondaryDroplet_PreviewMouseDown"
                MouseLeftButtonDown="SecondaryDroplet_Click"
                ToolTip="Secondary Live Activity · Click to expand">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SecondaryDropletScale" ScaleX="0.6" ScaleY="0.6" />
                    <TranslateTransform x:Name="SecondaryDropletTranslate" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="Transparent" />
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="Transparent" />
            </Border.BorderBrush>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PillStrokeBrush}" />
                </Style>
            </Border.Style>
            <Border.BorderThickness>1,0,1,1</Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.65" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Apple-Style Concentric Progress / Activity Ring -->
                <Ellipse x:Name="SecondaryDropletRing" Width="23" Height="23" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Opacity="0.9" />
                <TextBlock x:Name="SecondaryDropletGlyph" Style="{StaticResource Glyph}" FontSize="10.5"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE916;" />
            </Grid>
        </Border>
    </Grid>
</Window>
