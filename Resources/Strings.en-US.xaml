    <sys:String x:Key="Settings_Appearance">Appearance</sys:String>
    <sys:String x:Key="Settings_Themes">Living Themes</sys:String>
    <sys:String x:Key="Settings_Clock">Clock &amp; Audio</sys:String>
    <sys:String x:Key="Settings_Droplets">Droplets</sys:String>
    <sys:String x:Key="Settings_Dock">Dock Pins</sys:String>
    <sys:String x:Key="Settings_Display">Display &amp; Power</sys:String>
    <sys:String x:Key="Settings_Notifications">Notifications</sys:String>
    <sys:String x:Key="Settings_Pet">Virtual Pet</sys:String>
    <sys:String x:Key="Settings_Shortcuts">Shortcuts</sys:String>
    <sys:String x:Key="Settings_Updates">System &amp; Updates</sys:String>
