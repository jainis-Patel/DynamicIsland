<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:DynamicIsland.Core">

    <core:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <core:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
    <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <core:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <core:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <core:VolumePercentConverter x:Key="VolumePercentConverter" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Base / Fallback Brushes (dynamically updated by ThemeManager on theme transitions) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#86868B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#86868B" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#515156" />
    <SolidColorBrush x:Key="MutedBrush" Color="#98989D" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#121216" />
    <SolidColorBrush x:Key="CardBackground" Color="#121216" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PillNotchEarBrush" Color="#FF040406" />

    <SolidColorBrush x:Key="CyanBrush" Color="#32ADE6" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />
    <SolidColorBrush x:Key="PinkBrush" Color="#FF3366" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#5E5CE6" />

    <SolidColorBrush x:Key="IslandButtonBgBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ButtonSubtleBgBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="IslandButtonBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="IslandButtonHoverVeilBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="IslandSliderTrackBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="IslandSliderFillBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="IslandSliderThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#38FFFFFF" />

    <SolidColorBrush x:Key="DockToolButtonBgBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DockToolButtonFgBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="DockInactiveBgBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DockInactiveTextBrush" Color="#86868B" />
    <SolidColorBrush x:Key="DockActiveBgBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="DockActiveBorderBrush" Color="#48FFFFFF" />

    <SolidColorBrush x:Key="SettingsTabHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SettingsTabActiveBgBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ChipBgBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#1A1A22" />

    <SolidColorBrush x:Key="MediaPlayButtonBgBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="MediaPlayButtonFgBrush" Color="#0A0A0C" />

    <SolidColorBrush x:Key="MenuBackground" Color="#141417" />
    <SolidColorBrush x:Key="MenuBorder" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="MenuSeparator" Color="#18FFFFFF" />

    <SolidColorBrush x:Key="ClockTileBgBrush" Color="#E0181822" />
    <SolidColorBrush x:Key="ClockTileBorderBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="ClockTileDividerBrush" Color="#90000000" />
    <SolidColorBrush x:Key="ClockTileFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClockDialFaceBrush" Color="#0E1016" />
    <SolidColorBrush x:Key="ClockDialBorderBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="ClockHandBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PillBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF030304" Offset="0" />
        <GradientStop Color="#FF08080B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12FFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FrostedGrainBrush" Color="#00000000" />
    <SolidColorBrush x:Key="PointerGlareBrush" Color="#00000000" />

    <LinearGradientBrush x:Key="FloatingDockBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F00E0E14" Offset="0" />
        <GradientStop Color="#EE06060A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FloatingDockBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Minimal 3.5px Apple-style pill ScrollBar (dark/light adaptive) -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{DynamicResource ScrollBarThumbBrush}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="3.5" />
                <Setter Property="MinHeight" Value="3.5" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Background="{DynamicResource ScrollBarThumbBrush}" CornerRadius="1.75" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="3.5" />
                <Setter Property="MinWidth" Value="3.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Digits" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Concentric Card Title Style (Apple HIG sentence-case subheadline) -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pill button: subtle hover veil + fluid spring press scale. Never steals focus. -->
    <Style x:Key="IslandButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource IslandButtonBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IslandButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" />
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13" />
                        <Border x:Name="Veil" Background="{DynamicResource IslandButtonHoverVeilBrush}" Opacity="0" CornerRadius="13" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="0.10" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.93" Duration="0:0:0.07" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.93" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.45" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.45" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0A0A0C" />
    </Style>

    <!-- Floating Apple Segmented Dock Tool Pill -->
    <Style x:Key="DockToolButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,2.5,0" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" />
                        <Border x:Name="Veil" Background="#22FFFFFF" Opacity="0" CornerRadius="16" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.92" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.92" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact Floating Dock Icon Pill -->
    <Style x:Key="DockIconButton" TargetType="Button" BasedOn="{StaticResource DockToolButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DockInactiveTextBrush}" />
    </Style>

    <!-- Utility Icon Button in Floating Dock (Pin, Settings, Collapse) -->
    <Style x:Key="FloatingDockUtilityButton" TargetType="Button" BasedOn="{StaticResource DockToolButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Foreground" Value="{DynamicResource DockInactiveTextBrush}" />
    </Style>

    <!-- Compact Live Activity Equalizer Bar (Apple Dynamic Island rounded pill geometry) -->
    <Style x:Key="Bar" TargetType="Rectangle">
        <Setter Property="Width" Value="2.8" />
        <Setter Property="Height" Value="14" />
        <Setter Property="RadiusX" Value="1.4" />
        <Setter Property="RadiusY" Value="1.4" />
        <Setter Property="Margin" Value="1.4,0" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Minimalist iOS Live Activity Scrubber Track -->
    <Style x:Key="IslandSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="3.5" Background="{DynamicResource IslandSliderTrackBrush}" CornerRadius="1.75" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="3.5" Background="{DynamicResource IslandSliderFillBrush}" CornerRadius="1.75" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse x:Name="ThumbCircle" Width="8" Height="8" Fill="{DynamicResource IslandSliderThumbBrush}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbCircle" Property="Width" Value="10.5" />
                                                    <Setter TargetName="ThumbCircle" Property="Height" Value="10.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="3.5" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apple Control Center Warm Amber Brightness Slider -->
    <Style x:Key="AppleBrightnessSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="14" Background="Transparent">
                        <Border Height="6" Background="{DynamicResource IslandSliderTrackBrush}" CornerRadius="3" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="6" CornerRadius="3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFB84D" Offset="0" />
                                                        <GradientStop Color="#FF9F0A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Grid Width="14" Height="14">
                                                <Ellipse x:Name="ThumbOuter" Width="14" Height="14" Fill="{DynamicResource IslandSliderThumbBrush}" />
                                                <Ellipse Width="6" Height="6" Fill="#FF9F0A" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbOuter" Property="Width" Value="15.5" />
                                                    <Setter TargetName="ThumbOuter" Property="Height" Value="15.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="6" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Settings Tab Button -->
    <Style x:Key="SettingsTabButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TabBg" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource SettingsTabHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>