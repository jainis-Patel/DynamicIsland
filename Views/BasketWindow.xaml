<Window x:Class="DynamicIsland.Views.BasketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Drop Basket"
        Width="298" Height="194"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Micro Icon Action Button -->
        <Style x:Key="CardMicroActionBtn" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#1EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#2DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Divider -->
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#35FFFFFF" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="OuterCard" Margin="10" CornerRadius="20"
            Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="BasketScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 0: TOP HEADER & CONTROLS                                      -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,7">
                <!-- Left: Amber Staging Basket Status Badge & Counter -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E1E2C" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Width="20" Height="20" Margin="0,0,6,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Staging Basket" FontSize="10" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    <Border Background="#22FF9F0A" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountBadgeText" Style="{StaticResource Digits}" Text="0" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Right: Header Actions -->
                <Button Click="CloseBtn_Click" DockPanel.Dock="Right" Style="{StaticResource CardMicroActionBtn}" Width="20" Height="20" ToolTip="Dismiss Basket (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#8E8E93" />
                </Button>

                <Button Click="SendToShelfBtn_Click" x:Name="SendToShelfBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="7,0" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Send all items to Notch Shelf">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                        <TextBlock Text="To Shelf" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 1: CONTENT SURFACE (EMPTY DROP TARGET & POPULATED LIST)       -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <!-- Empty State Droppy Drop Target -->
                <Border x:Name="EmptyHintBorder" CornerRadius="13" BorderBrush="#25FFFFFF" BorderThickness="1" Background="#0AFFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#181826" BorderBrush="#30FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Drop files or images to stage" FontSize="9.5" FontWeight="SemiBold" Foreground="#E5E5EA" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag out anywhere · Jiggle cursor to summon" FontSize="7.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,1.5,0,0" />
                    </StackPanel>
                </Border>

                <!-- Populated Staging Items List -->
                <ScrollViewer x:Name="ItemsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="BasketItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14141E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,4.5" Margin="0,0,0,3"
                                        Cursor="SizeAll" MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove"
                                        ToolTip="{Binding FullPath, StringFormat='{}{0}&#x0a;• Drag out to drop into any app&#x0a;• Double-click to open'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14141E" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20202E" />
                                                    <Setter Property="BorderBrush" Value="#45FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <!-- Left: Thumbnail or Extension Badge -->
                                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <!-- High-Quality Image Thumbnail Preview -->
                                            <Border Width="28" Height="20" CornerRadius="3.5" ClipToBounds="True"
                                                    Visibility="{Binding ThumbnailVisibility}"
                                                    BorderBrush="#30FFFFFF" BorderThickness="1">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Non-Image Extension Badge -->
                                            <Border Background="{Binding BadgeColorBrush}" CornerRadius="3" Padding="4,1"
                                                    Visibility="{Binding GlyphVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExtensionTag}" FontSize="7" FontWeight="Bold" Foreground="#0B0B0E" />
                                            </Border>
                                        </Grid>

                                        <!-- Right: Micro Action Buttons -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="{Binding FullPath}" Click="CopyItemBtn_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Copy File (Ctrl+V)">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="7.5" Foreground="#8E8E93" />
                                            </Button>
                                            <Button Tag="{Binding FullPath}" Click="RemoveItem_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Remove from Basket">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7.5" Foreground="#8E8E93" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Center: 2-Line Filename and Formatted Size -->
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="9" FontWeight="Medium" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource Digits}" FontSize="7.5" Foreground="#8E8E93" Margin="0,0.5,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 2: BOTTOM FLOATING ACTION BAR                                 -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <DockPanel x:Name="ActionBar" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed" LastChildFill="False">
                <Button MouseLeftButtonDown="DragAll_MouseLeftButtonDown" MouseMove="DragAll_MouseMove" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTip="Drag all staged files together in one motion">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Drag Stack" FontSize="8.5" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="CopyAllBtn_Click" x:Name="CopyAllBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTip="Copy all files to clipboard (Ctrl+V pasteable)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy All" FontSize="8.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="ConvertMenuBtn_Click" x:Name="ConvertMenuBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTip="Convert images, PDF, or EXIF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Actions" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="ZipAllBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="3,0,0,0" ToolTip="Bundle basket items into a .zip archive">
                    <TextBlock Text="ZIP" FontSize="8" FontWeight="Bold" Foreground="#30D158" />
                </Button>

                <Button Click="ClearAllBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" ToolTip="Clear all staged items">
                    <TextBlock Text="Clear" FontSize="8.5" FontWeight="Medium" Foreground="#8E8E93" />
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
