<Window x:Class="DynamicIsland.Views.BasketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Drop Basket"
        Width="268" Height="156"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <Border x:Name="OuterCard" Margin="10" CornerRadius="22"
            Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Controls -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1C28" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="6" Width="20" Height="20" Margin="0,0,6,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Staging Basket" FontSize="10" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    <Border Background="#25FF9F0A" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountBadgeText" Text="0" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <Button Click="CloseBtn_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3" ToolTip="Dismiss Basket">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#8E8E93" />
                </Button>
                <Button Click="SendToShelfBtn_Click" x:Name="SendToShelfBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="18" Padding="6,0" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Send all items to Notch Shelf">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Notch" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Content Surface -->
            <Grid Grid.Row="1">
                <!-- Empty State Droppy Drop Target -->
                <Border x:Name="EmptyHintBorder" CornerRadius="12" BorderBrush="#25FFFFFF" BorderThickness="1" Background="#0CFFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#181826" BorderBrush="#30FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Drop files here to stage" FontSize="9.5" FontWeight="SemiBold" Foreground="#E5E5EA" HorizontalAlignment="Center" />
                        <TextBlock Text="Jiggle cursor while dragging to summon anytime" FontSize="7.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <!-- Populated Staging Items List -->
                <ScrollViewer x:Name="ItemsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="BasketItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161622" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,0,0,3"
                                        Cursor="SizeAll" MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove"
                                        ToolTip="Drag out to drop into any app">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#161622" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#222232" />
                                                    <Setter Property="BorderBrush" Value="#45FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Button Tag="{Binding FullPath}" Click="RemoveItem_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7.5" Foreground="#8E8E93" />
                                        </Button>
                                        <Border Background="{Binding BadgeColorBrush}" CornerRadius="3" Padding="3.5,0.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExtensionTag}" FontSize="7" FontWeight="Bold" Foreground="#0B0B0E" />
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" FontSize="9" FontWeight="Medium" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Floating Action Bar -->
            <DockPanel x:Name="ActionBar" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed" LastChildFill="False">
                <Button MouseLeftButtonDown="DragAll_MouseLeftButtonDown" MouseMove="DragAll_MouseMove" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,4,0" ToolTip="Drag all staged files together in one motion">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Drag Stack" FontSize="8.5" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ConvertMenuBtn_Click" x:Name="ConvertMenuBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0" ToolTip="Convert images, PDF, or EXIF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Actions" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ZipAllBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" ToolTip="Bundle basket items into a .zip archive">
                    <TextBlock Text="ZIP" FontSize="8" FontWeight="Bold" Foreground="#30D158" />
                </Button>
            </DockPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
