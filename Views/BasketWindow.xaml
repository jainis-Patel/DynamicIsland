<Window x:Class="DynamicIsland.Views.BasketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Floating Drop Basket"
        Width="384" Height="288"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Action Button inside Basket Cards -->
        <Style x:Key="CardMicroActionBtn" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Divider -->
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="OuterCard" Margin="10" CornerRadius="22"
            Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="BasketScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 0: TOP HEADER & CONTROLS                                      -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,9">
                <!-- Left: Amber Staging Basket Status Badge & Counter -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="24" Height="24" Margin="0,0,7,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Staging Basket" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Border Background="#24FF9F0A" CornerRadius="7" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountBadgeText" Style="{StaticResource Digits}" Text="0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Right: Header Actions -->
                <Button Click="CloseBtn_Click" DockPanel.Dock="Right" Style="{StaticResource CardMicroActionBtn}" Width="24" Height="24" ToolTip="Dismiss Basket (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}" />
                </Button>

                <Button Click="SendToShelfBtn_Click" x:Name="SendToShelfBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="9,0" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Send all items to Notch Shelf">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="To Shelf" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 1: CONTENT SURFACE (EMPTY DROP TARGET & POPULATED CARDS)      -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <!-- Empty State Drop Target -->
                <Border x:Name="EmptyHintBorder" CornerRadius="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource ChipBgBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Drop files or images to stage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag out anywhere · Jiggle cursor while dragging to summon" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Populated Staging Items List -->
                <ScrollViewer x:Name="ItemsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="BasketItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,0,5"
                                        Cursor="SizeAll" MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseMove="Item_MouseMove"
                                        ToolTip="{Binding FullPath, StringFormat='{}{0}&#x0a;• Drag out to drop into any app&#x0a;• Double-click to open'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <!-- Left: Larger Thumbnail or Type Icon Badge -->
                                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,9,0">
                                            <Border Width="44" Height="32" CornerRadius="8" ClipToBounds="True" core:RoundedClip.ClipChild="True"
                                                    Visibility="{Binding ThumbnailVisibility}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <Border Background="{Binding BadgeColorBrush}" CornerRadius="5" Padding="6,3"
                                                    Visibility="{Binding GlyphVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExtensionTag}" FontSize="8" FontWeight="Bold" Foreground="#0B0B0E" />
                                            </Border>
                                        </Grid>

                                        <!-- Right: Micro Action Buttons -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="{Binding FullPath}" Click="CopyItemBtn_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Copy File (Ctrl+V)">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                            </Button>
                                            <Button Tag="{Binding FullPath}" Click="RemoveItem_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Remove from Basket">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Center: Filename, Size & Parent Folder -->
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1.5,0,0">
                                                <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource Digits}" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                                <TextBlock Text=" · " FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.7" />
                                                <TextBlock Text="{Binding DirectoryName}" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- ROW 2: BOTTOM FLOATING ACTION BAR                                 -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <DockPanel x:Name="ActionBar" Grid.Row="2" Margin="0,9,0,0" Visibility="Collapsed" LastChildFill="False">
                <Button MouseLeftButtonDown="DragAll_MouseLeftButtonDown" MouseMove="DragAll_MouseMove" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="0,0,4,0" ToolTip="Drag all staged files together in one motion">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Drag Stack" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="CopyAllBtn_Click" x:Name="CopyAllBtn" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="0,0,4,0" ToolTip="Copy all files to clipboard (Ctrl+V pasteable)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy All" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="ConvertMenuBtn_Click" x:Name="ConvertMenuBtn" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="0,0,4,0" ToolTip="Convert images, PDF, or EXIF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Actions" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="ZipAllBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="4,0,0,0" ToolTip="Bundle basket items into a .zip archive">
                    <TextBlock Text="ZIP" FontSize="8.5" FontWeight="Bold" Foreground="#30D158" />
                </Button>

                <Button Click="ClearAllBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" ToolTip="Clear all staged items">
                    <TextBlock Text="Clear" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
