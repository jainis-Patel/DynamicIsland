<Window x:Class="DynamicIsland.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element Capture &amp; Annotation"
        WindowStyle="None" AllowsTransparency="True" Background="#55000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
        MouseMove="Canvas_MouseMove"
        MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
    <Grid>
        <!-- Frozen desktop background snapshot -->
        <Image x:Name="BackgroundScreenshot" Stretch="Fill" Opacity="0.92" />

        <!-- Drawing & Selection Canvas -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Border x:Name="SelectionBorder" BorderBrush="#FF9F0A" BorderThickness="2" Background="#12FFFFFF" Visibility="Collapsed" />
            <Canvas x:Name="AnnotationCanvas" />
        </Canvas>

        <!-- Floating Toolbar (appears once region is selected) -->
        <Border x:Name="ToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                CornerRadius="18" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2" Padding="8,5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.75" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ToolBox_Click" x:Name="ToolRectBtn" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,3,0" ToolTip="Draw Highlight Box">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE743;" FontSize="9" Foreground="#FF9F0A" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Box" FontSize="9" FontWeight="SemiBold" Foreground="#FF9F0A" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ToolArrow_Click" x:Name="ToolArrowBtn" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,3,0" ToolTip="Draw Arrow">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="9" Foreground="#FF453A" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Arrow" FontSize="9" FontWeight="SemiBold" Foreground="#FF453A" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ToolBlur_Click" x:Name="ToolBlurBtn" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,6,0" ToolTip="Redact / Blur Sensitive Region">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="9" Foreground="#8E8E93" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Redact" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="14" Background="#24FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />

                <Button Click="ActionOcr_Click" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,3,0" ToolTip="Extract Text via Windows OCR">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="9" Foreground="#BF5AF2" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="OCR" FontSize="9" FontWeight="Bold" Foreground="#BF5AF2" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ActionPin_Click" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,3,0" ToolTip="Pin Floating on Screen">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="9" Foreground="#0A84FF" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Pin" FontSize="9" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ActionShelf_Click" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,3,0" ToolTip="Save to Drop Shelf">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="9" Foreground="#30D158" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Shelf" FontSize="9" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ActionCopy_Click" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="0,0,3,0" ToolTip="Copy to Clipboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="Cancel_Click" Style="{StaticResource IslandButton}" Height="24" Width="24" Padding="0" ToolTip="Cancel (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
