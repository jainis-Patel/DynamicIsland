<UserControl x:Class="DynamicIsland.Views.Widgets.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="464">
    <UserControl.Resources>
        <!-- Interactive Clock Face Preview Card Style -->
        <Style x:Key="ClockPreviewCardStyle" TargetType="Button">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="5,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillCardBorder" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="PillCardBorder" Property="BorderBrush" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="#141418" BorderBrush="#282830" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Dynamic Island" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#1C1E2B" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v0.4.0" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
                <TextBlock Text="• by Jainis Patel" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="SettingsTrimRamBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,4,0" ToolTipService.ToolTip="Purge working set memory &amp; compact garbage collector">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="8" Foreground="{DynamicResource GreenBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Purge RAM" FontSize="8" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsOpenDataBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,5,0" ToolTipService.ToolTip="Open App Data directory in File Explorer">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xED25;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Data" FontSize="8" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource ChipBgBrush}" CornerRadius="9" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedThemeName" Text="Solar Amber" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="12" Padding="2" Margin="0,0,0,6">
            <UniformGrid Columns="8" Rows="1">
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabAppearanceBtn" Tag="Appearance" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🎨" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabAppearanceText" Text="Style" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDropletsBtn" Tag="Droplets" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabDropletsText" Text="Droplets" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDockBtn" Tag="Dock" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚓" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabDockText" Text="Dock" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabClockBtn" Tag="Clock" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏰" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabClockText" Text="Clock" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabScreenBtn" Tag="Screen" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabScreenText" Text="Screen" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabPetBtn" Tag="Pet" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🐾" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabPetText" Text="Pet" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabShortcutsBtn" Tag="Shortcuts" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⌨️" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabShortcutsText" Text="Keys" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabNotifBtn" Tag="Notifications" Style="{StaticResource SettingsTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsTabNotifText" Text="Alerts" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
        <Grid Grid.Row="2">
            <!--  Notifications & Alerts Settings Tab                     -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsNotifTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,4">
                    <!-- Hero Summary Card -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource ChipBgBrush}" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Click="OpenNotifCenterBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="26" Padding="10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open Center" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Notifications &amp; Alerts" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Manage incoming Windows toast banners, DND, and alerts" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- DND & Banners Settings Group -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,2,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Do Not Disturb (DND)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Silence all non-critical notification toasts and alerts" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="DndToggleBtn_Click" x:Name="SettingsDndToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SettingsDndToggleText" Text="Off" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                                </Button>
                            </DockPanel>

                            <Border Height="0.8" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,6" />

                            <DockPanel LastChildFill="False" Margin="0,2,0,2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Replace Windows Banners" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Dismiss native Windows toast banners and show them purely in Dynamic Island" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="ReplaceBannersToggleBtn_Click" x:Name="ReplaceBannersToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReplaceBannersToggleText" Text="Active" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsAppearanceTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Visible">
                <StackPanel Margin="0,0,0,4">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Gooey Physics" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LiquidIntensityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="65%" />
                                </DockPanel>
                                <Slider ValueChanged="LiquidIntensitySlider_ValueChanged" x:Name="LiquidIntensitySlider" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100" Value="65" ToolTipService.ToolTip="Controls droplet bounce, overshoot, and gooey squash-and-stretch deformation" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Animation Speed" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AnimationSpeedText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                </DockPanel>
                                <Slider ValueChanged="AnimationSpeedSlider_ValueChanged" x:Name="AnimationSpeedSlider" Style="{StaticResource IslandSlider}" Minimum="50" Maximum="160" Value="100" ToolTipService.ToolTip="Controls how fast or syrupy the island morphs (50% slow liquid to 160% snappy)" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Island Scale" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="IslandScaleText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                </DockPanel>
                                <Slider ValueChanged="IslandScaleSlider_ValueChanged" x:Name="IslandScaleSlider" Style="{StaticResource IslandSlider}" Minimum="85" Maximum="125" Value="100" ToolTipService.ToolTip="Scales the overall size of Dynamic Island (85% to 125%)" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Glass Opacity" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BackdropOpacityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                </DockPanel>
                                <Slider ValueChanged="BackdropOpacitySlider_ValueChanged" x:Name="BackdropOpacitySlider" Style="{StaticResource IslandSlider}" Minimum="65" Maximum="100" Value="100" ToolTipService.ToolTip="Adjusts capsule surface from translucent dark glass (65%) to pitch-black OLED (100%)" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,0,5">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="UI Theme Style" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Border Background="#250A84FF" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="macOS" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ThemeStyleSubtext" Text="Classic OLED Capsule" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="12" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="ThemeStyleBtn_Click" x:Name="ThemeStyleDefaultBtn" Tag="Default" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,2,0" ToolTipService.ToolTip="Classic Dynamic Island OLED dark &amp; light theme">
                                        <TextBlock x:Name="ThemeStyleDefaultText" Text="Default" FontSize="9" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="ThemeStyleBtn_Click" x:Name="ThemeStyleLiquidGlassBtn" Tag="Liquid Glass" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Apple Liquid Glass UI with frosted translucency, prismatic specular rims &amp; spatial depth">
                                        <TextBlock x:Name="ThemeStyleLiquidGlassText" Text="Liquid Glass" FontSize="9" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                    <!-- ── Liquid Glass Optical & Frosting Controls ──────────────── -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,0,5">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Liquid Glass &amp; Frosting Controls" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="GlassFrostingStatusText" DockPanel.Dock="Right" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Text="Active" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Slider 1: Blur & Frosting Diffusion -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,2">
                                <TextBlock Text="Frosting Blur" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="GlassBlurText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="100%" />
                            </DockPanel>
                            <Slider x:Name="GlassBlurSlider" ValueChanged="GlassBlurSlider_ValueChanged" Style="{StaticResource IslandSlider}"
                                    Minimum="20" Maximum="250" Value="100" Margin="0,0,0,5"
                                    ToolTipService.ToolTip="Adjusts frosted glass diffusion blur from crystal-clear (20%) to deep frosted mist (250%)" />

                            <!-- Slider 2: Lens Refraction & Bevel -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,2">
                                <TextBlock Text="Lens Refraction &amp; Bevel" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="GlassRefractionText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                            </DockPanel>
                            <Slider x:Name="GlassRefractionSlider" ValueChanged="GlassRefractionSlider_ValueChanged" Style="{StaticResource IslandSlider}"
                                    Minimum="0" Maximum="200" Value="100" Margin="0,0,0,2"
                                    ToolTipService.ToolTip="Controls Snell's law refraction strength and edge lens bevel curvature (0% flat to 200% deep prism)" />
                        </StackPanel>
                    </Border>
                    <!-- ── Living Island Nature Themes (Ivy & Blooms, Sakura, Tree, Meadow) ── -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,0,5">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Living Island Nature Theme" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="IslandThemeSubtext" DockPanel.Dock="Right" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Text="Ivy &amp; Blooms" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="12" Padding="2" HorizontalAlignment="Stretch">
                                <UniformGrid Columns="5">
                                    <Button Click="IslandThemeBtn_Click" x:Name="IslandThemeNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0,0,1,0" ToolTipService.ToolTip="Clean island without nature decorations">
                                        <TextBlock x:Name="IslandThemeNoneText" Text="None" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="IslandThemeIvyBtn" Tag="Ivy &amp; Blooms" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0,0,1,0" ToolTipService.ToolTip="Climbing English ivy, morning glories, jasmine, lilac &amp; fluttering butterflies">
                                        <TextBlock x:Name="IslandThemeIvyText" Text="Ivy &amp; Blooms" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="IslandThemeSakuraBtn" Tag="Sakura Branch" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0,0,1,0" ToolTipService.ToolTip="Flowering cherry blossom branch with swirling wind petals">
                                        <TextBlock x:Name="IslandThemeSakuraText" Text="Sakura" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="IslandThemeTreeBtn" Tag="Blossom Tree" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0,0,1,0" ToolTipService.ToolTip="Branching blossom tree with organic sway">
                                        <TextBlock x:Name="IslandThemeTreeText" Text="Tree" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="IslandThemeMeadowBtn" Tag="Meadow" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0" ToolTipService.ToolTip="Lush wild meadow grass, daisies, red poppies &amp; lavender">
                                        <TextBlock x:Name="IslandThemeMeadowText" Text="Meadow" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,0,5">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance Mode" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="ThemeModeSubtext" Text="Match Windows" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="12" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeSystemBtn" Tag="System" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,2,0" ToolTipService.ToolTip="Follow Windows system theme automatically">
                                        <TextBlock x:Name="ThemeModeSystemText" Text="System" FontSize="9" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeDarkBtn" Tag="Dark" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,2,0" ToolTipService.ToolTip="Always use Dark Mode">
                                        <TextBlock x:Name="ThemeModeDarkText" Text="Dark" FontSize="9" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeLightBtn" Tag="Light" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Always use Light Mode">
                                        <TextBlock x:Name="ThemeModeLightText" Text="Light" FontSize="9" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
