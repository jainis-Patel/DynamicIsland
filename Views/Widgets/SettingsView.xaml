<UserControl x:Class="DynamicIsland.Views.Widgets.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="464"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Hairline Divider for Inset Groups -->
        <Style x:Key="GroupHairline" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Clean Section Overline Header -->
        <Style x:Key="OverlineHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="4,4,0,4" />
        </Style>

        <!-- Interactive Clock Face Preview Card Style -->
        <Style x:Key="ClockPreviewCardStyle" TargetType="Button">
            <Setter Property="Width" Value="118" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#0CFFFFFF" />
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillCardBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="PillCardBorder" Property="BorderBrush" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Dot Button Style -->
        <Style x:Key="SwatchDotStyle" TargetType="Button">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="SwatchRing" Fill="{TemplateBinding Background}" Stroke="#45FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchRing" Property="Stroke" Value="#CCFFFFFF" />
                                <Setter TargetName="SwatchRing" Property="StrokeThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- TOP UTILITY HEADER                                                -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="2,0,2,6" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4.5" Background="#121318" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Dynamic Island" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersionText" Text="0.7.0" Style="{StaticResource Digits}" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
                <TextBlock Text="Jainis Patel" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.65" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="SettingsTrimRamBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Purge working set memory &amp; compact garbage collector">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="8.5" Foreground="{DynamicResource GreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Purge" FontSize="8" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsOpenDataBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,5,0" ToolTipService.ToolTip="Open App Data directory in File Explorer">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xED25;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Data" FontSize="8" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedThemeName" Text="Solar Amber" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- SEGMENTED NAVIGATION BAR (Monochrome Fluent Icons, No Emoji Slop) -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,7">
            <UniformGrid Columns="9" Rows="1">
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabAppearanceBtn" Tag="Appearance" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Appearance &amp; Physics">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabAppearanceText" Text="Style" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabThemesBtn" Tag="Themes" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Botanical &amp; Living Themes">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEC0A;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabThemesText" Text="Flora" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDropletsBtn" Tag="Droplets" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Modular Droplets">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xF158;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabDropletsText" Text="Mods" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDockBtn" Tag="Dock" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Dock Strip Manager">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE90D;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabDockText" Text="Dock" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabClockBtn" Tag="Clock" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Clock &amp; Idle Capsule">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabClockText" Text="Clock" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabScreenBtn" Tag="Screen" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Display, Notch &amp; Power">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabScreenText" Text="Screen" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabPetBtn" Tag="Pet" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Desktop Companion">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabPetText" Text="Pet" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabShortcutsBtn" Tag="Shortcuts" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Global Shortcuts &amp; Backup">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabShortcutsText" Text="Keys" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabNotifBtn" Tag="Notifications" Style="{StaticResource SettingsTabButtonStyle}" ToolTipService.ToolTip="Notifications &amp; Toast Interception">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock x:Name="SettingsTabNotifText" Text="Alerts" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- TAB CONTENT HOST                                                  -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 1. APPEARANCE & PHYSICS TAB                                   -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsAppearanceTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Visible">
                <StackPanel Margin="0,0,0,6">

                    <!-- Group 1: Theme & Color Surface -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Row: Material Surface Style -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Material Surface" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="ThemeStyleSubtext" Text="Classic OLED Capsule" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="ThemeStyleBtn_Click" x:Name="ThemeStyleDefaultBtn" Tag="Default" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,2,0" ToolTipService.ToolTip="Pitch-black OLED capsule">
                                            <TextBlock x:Name="ThemeStyleDefaultText" Text="OLED" FontSize="8.5" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="ThemeStyleBtn_Click" x:Name="ThemeStyleLiquidGlassBtn" Tag="Liquid Glass" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Refractive frosted glass with specular rims">
                                            <TextBlock x:Name="ThemeStyleLiquidGlassText" Text="Liquid Glass" FontSize="8.5" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Row: Color Scheme Mode -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Color Mode" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="ThemeModeSubtext" Text="Match Windows" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeSystemBtn" Tag="System" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                            <TextBlock x:Name="ThemeModeSystemText" Text="System" FontSize="8.5" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeDarkBtn" Tag="Dark" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                            <TextBlock x:Name="ThemeModeDarkText" Text="Dark" FontSize="8.5" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="ThemeModeBtn_Click" x:Name="ThemeModeLightBtn" Tag="Light" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                            <TextBlock x:Name="ThemeModeLightText" Text="Light" FontSize="8.5" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Row: Accent Swatches -->
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Accent Tint" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ThemeSwatch_Click" Tag="Solar Amber" Background="#FF9F0A" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Solar Amber" />
                                    <Button Click="ThemeSwatch_Click" Tag="Apple Neon" Background="#0A84FF" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Apple Neon" />
                                    <Button Click="ThemeSwatch_Click" Tag="Cyberpunk Cyan" Background="#00F0FF" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Cyberpunk Cyan" />
                                    <Button Click="ThemeSwatch_Click" Tag="Emerald Green" Background="#30D158" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Emerald Green" />
                                    <Button Click="ThemeSwatch_Click" Tag="Monochrome Frost" Background="#E5E5EA" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Monochrome Frost" />
                                    <Button Click="ThemeSwatch_Click" Tag="Purple Haze" Background="#BF5AF2" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Purple Haze" />
                                    <Button Click="ThemeSwatch_Click" Tag="Coral Sunset" Background="#FF6442" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Coral Sunset" />
                                    <Button Click="ThemeSwatch_Click" Tag="Rose Velvet" Background="#FF375F" Style="{StaticResource SwatchDotStyle}" ToolTipService.ToolTip="Rose Velvet" />
                                    <Button Click="ThemeSwatch_Click" Tag="Windows Accent" Background="#0078D4" Style="{StaticResource SwatchDotStyle}" Margin="0" ToolTipService.ToolTip="Windows System Accent" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Physics, Scale & Geometry (2x2 Clean Grid) -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Gooey Physics -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Elasticity" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="LiquidIntensityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="65%" />
                                    </DockPanel>
                                    <Slider ValueChanged="LiquidIntensitySlider_ValueChanged" x:Name="LiquidIntensitySlider" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100" Value="65" />
                                </StackPanel>

                                <!-- Animation Speed -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Morph Speed" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="AnimationSpeedText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                    </DockPanel>
                                    <Slider ValueChanged="AnimationSpeedSlider_ValueChanged" x:Name="AnimationSpeedSlider" Style="{StaticResource IslandSlider}" Minimum="50" Maximum="160" Value="100" />
                                </StackPanel>

                                <!-- Island Scale -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Capsule Scale" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="IslandScaleText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                    </DockPanel>
                                    <Slider ValueChanged="IslandScaleSlider_ValueChanged" x:Name="IslandScaleSlider" Style="{StaticResource IslandSlider}" Minimum="85" Maximum="125" Value="100" />
                                </StackPanel>

                                <!-- Backdrop Opacity -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Surface Opacity" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="BackdropOpacityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                    </DockPanel>
                                    <Slider ValueChanged="BackdropOpacitySlider_ValueChanged" x:Name="BackdropOpacitySlider" Style="{StaticResource IslandSlider}" Minimum="65" Maximum="100" Value="100" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Optics: Blur & Refraction side by side -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Liquid Glass Optics" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                                <TextBlock x:Name="GlassFrostingStatusText" DockPanel.Dock="Right" FontSize="8" Foreground="{DynamicResource AccentBrush}" Text="Active" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Frosting Blur" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="GlassBlurText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="100%" />
                                    </DockPanel>
                                    <Slider x:Name="GlassBlurSlider" ValueChanged="GlassBlurSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="250" Value="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Lens Refraction" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="GlassRefractionText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="100%" />
                                    </DockPanel>
                                    <Slider x:Name="GlassRefractionSlider" ValueChanged="GlassRefractionSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="200" Value="100" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Quick Surface Toggles Row -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rim &amp; Motion Effects" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="EdgeBorderSubtext" Text="Specular border, ambient halo &amp; impulse test" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="EdgeBorderToggleBtn_Click" x:Name="EdgeBorderToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="EdgeBorderToggleText" Text="Border On" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="HaloToggleBtn_Click" x:Name="HaloToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="HaloToggleText" Text="Glow On" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="MotionModeBtn_Click" x:Name="MotionModeBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="MotionModeText" Text="Liquid" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="LiquidPulseBtn_Click" x:Name="LiquidPulseBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                        <TextBlock Text="Pulse" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hidden Compatibility Hooks for Duplicate Appearance Nature Card -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="IslandThemeSubtext" />
                        <Button x:Name="IslandThemeNoneBtn" Click="IslandThemeBtn_Click" Tag="None"><TextBlock x:Name="IslandThemeNoneText" /></Button>
                        <Button x:Name="IslandThemeIvyBtn" Click="IslandThemeBtn_Click" Tag="Ivy &amp; Blooms"><TextBlock x:Name="IslandThemeIvyText" /></Button>
                        <Button x:Name="IslandThemeMeadowBtn" Click="IslandThemeBtn_Click" Tag="Meadow"><TextBlock x:Name="IslandThemeMeadowText" /></Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 2. BOTANICAL NATURE THEMES TAB                                -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsThemesTab" CanContentScroll="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10">

                    <!-- Consolidated Botanical Configuration Card -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Botanical Overlay" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureThemeSubtext" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Text="Procedural foliage &amp; blooms" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="NatureActiveThemeBadge" Text="Ivy &amp; Blooms" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DockPanel>

                            <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="7" Padding="2" Margin="0,0,0,4">
                                <UniformGrid Columns="3">
                                    <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="ThemesTabNoneText" Text="Disabled" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabIvyBtn" Tag="Ivy &amp; Blooms" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="ThemesTabIvyText" Text="Ivy &amp; Blooms" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabMeadowBtn" Tag="Meadow" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0">
                                        <TextBlock x:Name="ThemesTabMeadowText" Text="Wild Meadow" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Button>
                                </UniformGrid>
                            </Border>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Density Profiles -->
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Density Profile" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="NaturePresetBtn_Click" Tag="Minimalist" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock Text="Minimal" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="NaturePresetBtn_Click" Tag="Subtle" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock Text="Subtle" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="NaturePresetBtn_Click" Tag="Balanced" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock Text="Balanced" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="NaturePresetBtn_Click" Tag="Lush" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                        <TextBlock Text="Lush" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- 2x2 Botanical Sliders -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Vine Density" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="NatureDensityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="70%" />
                                    </DockPanel>
                                    <Slider x:Name="NatureDensitySlider" ValueChanged="NatureDensitySlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="150" Value="70" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Bloom Frequency" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="NatureBloomText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="75%" />
                                    </DockPanel>
                                    <Slider x:Name="NatureBloomSlider" ValueChanged="NatureBloomSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="150" Value="75" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Foliage Scale" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="NatureScaleText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="85%" />
                                    </DockPanel>
                                    <Slider x:Name="NatureScaleSlider" ValueChanged="NatureScaleSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="40" Maximum="140" Value="85" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="Cascade Drop" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="NatureDropText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="60 px" />
                                    </DockPanel>
                                    <Slider x:Name="NatureDropSlider" ValueChanged="NatureDropSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="120" Value="60" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Butterflies & Pollen -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Fluttering Companions" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureButterflySubtext" Text="2 · Monarch &amp; Morpho" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly0Btn" Tag="0" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="NatureButterfly0Text" Text="0" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly1Btn" Tag="1" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="NatureButterfly1Text" Text="1" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly2Btn" Tag="2" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="NatureButterfly2Text" Text="2" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly3Btn" Tag="3" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock x:Name="NatureButterfly3Text" Text="3" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly4Btn" Tag="4" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                        <TextBlock x:Name="NatureButterfly4Text" Text="4" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                <TextBlock Text="Ambient Pollen Motes" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="NaturePollenText" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="14 motes" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button Click="NaturePollenToggleBtn_Click" x:Name="NaturePollenToggleBtn" Style="{StaticResource IslandButton}" Height="19" Padding="7,0">
                                        <TextBlock x:Name="NaturePollenToggleText" Text="Active" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <Slider x:Name="NaturePollenSlider" ValueChanged="NaturePollenSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="30" Value="14" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 3. MODULAR DROPLETS TAB                                       -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsDropletsTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">

                    <!-- Compact Toolbar Header -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="0,0,0,5">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,5">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DropletEnableAllBtn" Click="DropletEnableAllBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock Text="Enable All" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button x:Name="DropletDisableAllBtn" Click="DropletDisableAllBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock Text="Disable All" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button x:Name="DropletResetBtn" Click="DropletResetBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,6,0">
                                        <TextBlock Text="Reset" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                </StackPanel>

                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropletsHeaderSummaryText" Style="{StaticResource Digits}" Text="16 / 17 · ~500 KB" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>

                                <Border Background="#0CFFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Height="20" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="DropletSearchBox" TextChanged="DropletSearchBox_TextChanged" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="8.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>

                            <!-- Category Filter Bar (No Emojis) -->
                            <UniformGrid Columns="5">
                                <Button x:Name="DropletFilterAllBtn" Tag="All" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="2,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="DropletFilterAllText" Text="All (17)" FontSize="8" HorizontalAlignment="Center" />
                                </Button>
                                <Button x:Name="DropletFilterProdBtn" Tag="Productivity" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="2,0" Margin="1,0">
                                    <TextBlock x:Name="DropletFilterProdText" Text="Productivity" FontSize="8" HorizontalAlignment="Center" />
                                </Button>
                                <Button x:Name="DropletFilterMediaBtn" Tag="Media" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="2,0" Margin="1,0">
                                    <TextBlock x:Name="DropletFilterMediaText" Text="Media" FontSize="8" HorizontalAlignment="Center" />
                                </Button>
                                <Button x:Name="DropletFilterSysBtn" Tag="System" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="2,0" Margin="1,0">
                                    <TextBlock x:Name="DropletFilterSysText" Text="System" FontSize="8" HorizontalAlignment="Center" />
                                </Button>
                                <Button x:Name="DropletFilterCapBtn" Tag="Capture" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="2,0" Margin="2,0,0,0">
                                    <TextBlock x:Name="DropletFilterCapText" Text="Capture" FontSize="8" HorizontalAlignment="Center" />
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="DropletsEmptyPlaceholder" Visibility="Collapsed" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,16" Margin="0,2,0,4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="No matching modules" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Droplets ItemsControl -->
                    <ItemsControl x:Name="DropletsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="8,5"
                                        Margin="0,0,0,3"
                                        Opacity="{Binding CardOpacity}">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Tag="{Binding Id}" Click="DropletActionBtn_Click"
                                                    Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{Binding Description}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding ActionGlyph}" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Tag="{Binding Id}" Click="DropletToggleBtn_Click"
                                                    Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0"
                                                    Background="{Binding ToggleBackground}"
                                                    BorderBrush="{Binding ToggleBorderBrush}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="4.5" Height="4.5" Fill="{Binding StatusForeground}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="6"
                                                Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="10.5"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="3.5" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FeatureBadge}" FontSize="7" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="3.5" Padding="4,0.5" Margin="3,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RamCostText}" Style="{StaticResource Digits}" FontSize="7" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 4. DOCK STRIP MANAGER TAB                                     -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsDockTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">

                    <!-- Compact Dock Header Bar -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,0,5">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="DockPinAllBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                    <TextBlock Text="Show All" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="DockPinMinimalBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                    <TextBlock Text="Core 5" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="DockPinResetBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                    <TextBlock Text="Reset" FontSize="8" FontWeight="Medium" />
                                </Button>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="DockHeaderSummaryText" Style="{StaticResource Digits}" Text="18 / 18 Pinned" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="PRODUCTIVITY &amp; WORKFLOW" Style="{StaticResource OverlineHeader}" />
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,2,3">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinShelfBtn" Tag="shelf" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0">
                                    <TextBlock x:Name="DockPinShelfText" Text="Visible" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Width="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Drop Shelf" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="2,0,0,3">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinClipBtn" Tag="clipboard" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0">
                                    <TextBlock x:Name="DockPinClipText" Text="Visible" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Width="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Clipboard" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,2,3">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinCalcBtn" Tag="calc" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0">
                                    <TextBlock x:Name="DockPinCalcText" Text="Visible" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EF;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Width="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Calculator" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="2,0,0,3">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinNotesBtn" Tag="notes" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0">
                                    <TextBlock x:Name="DockPinNotesText" Text="Visible" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Width="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Notes" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,2,3">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinLauncherBtn" Tag="launcher" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0">
                                    <TextBlock x:Name="DockPinLauncherText" Text="Visible" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Width="18" VerticalAlignment="Center" />
                                    <TextBlock Text="App Launcher" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="2,0,0,3">
                            <DockPanel LastChildFill="True">
