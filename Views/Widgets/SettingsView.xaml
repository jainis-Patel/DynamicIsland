                                <Button Click="ImportSettingsBtn_Click" x:Name="ImportSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Import configurations from JSON file">
                                    <TextBlock Text="Import JSON" FontSize="9" FontWeight="Medium" />
                                </Button>
                                <Button Click="ResetSettingsBtn_Click" x:Name="ResetSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0" ToolTipService.ToolTip="Reset all island settings back to defaults">
                                    <TextBlock x:Name="ResetSettingsText" Text="Reset Defaults" FontSize="9" FontWeight="Medium" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- App Creator & About Badge -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,4,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#121215" BorderBrush="#25252D" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/app.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Island for Windows" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Created with ❤️ by Jainis Patel" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#151722" BorderBrush="#222536" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Jainis Patel" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsDropletsTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,4">
                    <!-- Droplets Hero Card with Summary & Quick Controls -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,5">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🧩 Modular Droplets" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Interactive island pills &amp; zero-RAM modules" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropletsHeaderSummaryText" Text="16 / 17 Active · ~500 KB" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DockPanel>

                            <!-- Quick Batch Actions & Search Toolbar -->
                            <DockPanel Margin="0,7,0,0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DropletEnableAllBtn" Click="DropletEnableAllBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Enable all modular droplets">
                                        <TextBlock Text="All On" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button x:Name="DropletDisableAllBtn" Click="DropletDisableAllBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Disable all droplets (unload background hooks)">
                                        <TextBlock Text="All Off" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button x:Name="DropletResetBtn" Click="DropletResetBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0,0,6,0" ToolTipService.ToolTip="Reset droplets to default configuration">
                                        <TextBlock Text="Defaults" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                </StackPanel>

                                <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7,2" Height="21" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="DropletSearchBox" TextChanged="DropletSearchBox_TextChanged" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="8.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" ToolTipService.ToolTip="Filter droplets by name, description, or category" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Category Filter Segmented Bar (Clean 5-Column Grid, No Overflow) -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,5">
                        <UniformGrid Columns="5">
                            <Button x:Name="DropletFilterAllBtn" Tag="All" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                                <TextBlock x:Name="DropletFilterAllText" Text="All (17)" FontSize="8.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button x:Name="DropletFilterProdBtn" Tag="Productivity" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                                <TextBlock x:Name="DropletFilterProdText" Text="⚡ Productivity" FontSize="8.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button x:Name="DropletFilterMediaBtn" Tag="Media" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                                <TextBlock x:Name="DropletFilterMediaText" Text="🎵 Media" FontSize="8.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button x:Name="DropletFilterSysBtn" Tag="System" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                                <TextBlock x:Name="DropletFilterSysText" Text="⚙️ System" FontSize="8.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button x:Name="DropletFilterCapBtn" Tag="Capture" Click="DropletFilterBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                                <TextBlock x:Name="DropletFilterCapText" Text="📸 Capture" FontSize="8.5" HorizontalAlignment="Center" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Empty Filter Results Indicator -->
                    <Border x:Name="DropletsEmptyPlaceholder" Visibility="Collapsed" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,16" Margin="0,2,0,4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="16" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="No droplets matching your filter" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Droplets List ItemsControl -->
                    <ItemsControl x:Name="DropletsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,5"
                                        Margin="0,0,0,3"
                                        Opacity="{Binding CardOpacity}">
                                    <DockPanel LastChildFill="True">
                                        <!-- Right Controls: Action Button & Capsule Toggle Switch -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <!-- Contextual Action Button (Only visible when droplet is enabled) -->
                                            <Button Tag="{Binding Id}" Click="DropletActionBtn_Click"
                                                    Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{Binding Description}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding ActionGlyph}" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Island Capsule Toggle Pill -->
                                            <Button Tag="{Binding Id}" Click="DropletToggleBtn_Click"
                                                    Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0"
                                                    Background="{Binding ToggleBackground}"
                                                    BorderBrush="{Binding ToggleBorderBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Toggle Droplet active state">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding StatusForeground}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8" FontWeight="Bold" Foreground="{Binding StatusForeground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Left Icon Squircle Badge -->
                                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7"
                                                Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Center Info: Title, Chips & Subtitle -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FeatureBadge}" FontSize="7.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,0.5" Margin="3,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RamCostText}" FontSize="7.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="8"
                                                       Foreground="{DynamicResource SecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ═════════════════════════════════════════════════════════ -->
            <!--  Dock Strip Manager Tab                                   -->
            <!-- ═════════════════════════════════════════════════════════ -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsDockTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">
                    <!-- Hero Summary & Presets Card -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚓ Desktop Dock Strip" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Pin or hide interactive tools on the Dynamic Island bottom dock" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockHeaderSummaryText" Text="18 / 18 Visible in Dock" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DockPanel>

                            <!-- Presets Toolbar -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                                <Button Click="DockPinAllBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="8,0" Margin="0,0,4,0" ToolTipService.ToolTip="Show all 18 tools in the dock strip">
                                    <TextBlock Text="Show All" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="DockPinMinimalBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="8,0" Margin="0,0,4,0" ToolTipService.ToolTip="Show only core essentials (Shelf, Clipboard, Calc, Audio, Settings)">
                                    <TextBlock Text="Minimal (Core 5)" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="DockPinResetBtn_Click" Style="{StaticResource IslandButton}" Height="21" Padding="8,0" Margin="0" ToolTipService.ToolTip="Reset dock pins to factory configuration">
                                    <TextBlock Text="Defaults" FontSize="8" FontWeight="Medium" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Category 1: Productivity & Essentials -->
                    <Border Margin="2,4,2,2">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE762;" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Productivity &amp; Essentials" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="6 tools" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <!-- Tool 1: Drop Shelf -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinShelfBtn" Tag="shelf" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinShelfText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#182438" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Drop Shelf" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Staged files &amp; drop tray" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 2: Clipboard History -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinClipBtn" Tag="clipboard" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinClipText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1C223A" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="9.5" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Clipboard History" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Ctrl+Alt+V · Queue &amp; OCR" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 3: Calculator -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinCalcBtn" Tag="calc" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinCalcText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#182A24" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EF;" FontSize="9.5" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Calculator &amp; Units" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Ctrl+Alt+C · Natural math" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 4: Notes -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinNotesBtn" Tag="notes" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinNotesText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#2A2416" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;" FontSize="9.5" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Quick Notes" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Ctrl+Alt+J · Markdown scratch" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 6: Launcher -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinLauncherBtn" Tag="launcher" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinLauncherText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1D2436" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="9.5" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="App Launcher" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Drop-to-open apps &amp; widgets" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 17: Notifications -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinNotifBtn" Tag="notifications" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinNotifText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#281D34" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E7;" FontSize="9.5" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Notification Center" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Ctrl+Alt+N · Ring buffer" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Category 2: Hardware & System Vitals -->
                    <Border Margin="2,4,2,2">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE770;" FontSize="9.5" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Hardware &amp; System Vitals" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="6 tools" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <!-- Tool 11: Audio Output -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinAudioBtn" Tag="audio" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinAudioText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#162736" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F6;" FontSize="9.5" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Audio Devices" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Ctrl+Alt+O · Output switcher" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tool 12: Battery & Power -->
                        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="2,2">
                            <DockPanel LastChildFill="True">
                                <Button Click="DockPinToggleBtn_Click" x:Name="DockPinBatteryBtn" Tag="battery" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockPinBatteryText" Text="Visible" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
