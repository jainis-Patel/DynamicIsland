                                <TextBlock Text="Capsule Elements" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="CameraLensToggleBtn_Click" x:Name="CameraLensToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="TrueDepth sensor indicator">
                                        <TextBlock x:Name="CameraLensToggleText" Text="Cam On" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="LyricsToggleBtnSettings_Click" x:Name="LyricsToggleBtnSettings" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Synced LRCLIB lyrics">
                                        <TextBlock x:Name="LyricsToggleSettingsText" Text="Lyrics On" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="CompactLyricsToggleBtn_Click" x:Name="CompactLyricsToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Inline lyric line in compact pill">
                                        <TextBlock x:Name="CompactLyricsToggleText" Text="Pill Lyrics Off" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                    <Button Click="NetSpeedIdleToggleBtn_Click" x:Name="NetSpeedIdleToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0" ToolTipService.ToolTip="Live network throughput">
                                        <TextBlock x:Name="NetSpeedIdleToggleText" Text="Speed Off" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Split Secondary Droplet -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Split Secondary Droplet" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="SecondaryDropletSubtext" Text="Detached side bubble when two activities run concurrently" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="SecondaryDropletToggleBtn_Click" x:Name="SecondaryDropletToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SecondaryDropletToggleText" Text="Droplet On" FontSize="8.5" FontWeight="Medium" />
                                </Button>
                            </DockPanel>

                            <!-- Hidden Compatibility Hook for Duplicate NetSpeed Button -->
                            <StackPanel Visibility="Collapsed">
                                <Button x:Name="NetSpeedSettingToggleBtn" Click="NetSpeedIdleToggleBtn_Click">
                                    <StackPanel>
                                        <Ellipse x:Name="NetSpeedSettingStatusDot" />
                                        <TextBlock x:Name="NetSpeedSettingToggleText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 6. DISPLAY, POWER & SYSTEM TAB                                -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsScreenTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">

                    <!-- Display & Geometry Group -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Target Display" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="MonitorStatusBadge" Text="Active" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="MonitorDetailsText" Style="{StaticResource Digits}" Text="Display 1: 1920 × 1080 @ 60 Hz" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="MonitorSwitchBtn_Click" x:Name="MonitorSwitchBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="MonitorSwitchText" Text="Screen 1" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="FollowMonitorToggleBtn_Click" x:Name="FollowMonitorToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                        <TextBlock x:Name="FollowMonitorToggleText" Text="Follow Cursor Off" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Alignment & Top Offset -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="DockButton_Click" x:Name="DockLeftBtn" Tag="Left" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                        <TextBlock Text="Left" FontSize="8.5" />
                                    </Button>
                                    <Button Click="DockButton_Click" x:Name="DockCenterBtn" Tag="Center" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                        <TextBlock Text="Center" FontSize="8.5" />
                                    </Button>
                                    <Button Click="DockButton_Click" x:Name="DockRightBtn" Tag="Right" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0">
                                        <TextBlock Text="Right" FontSize="8.5" />
                                    </Button>
                                    <Button Click="NotchBezelToggleBtn_Click" x:Name="NotchBezelToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0">
                                        <TextBlock x:Name="NotchBezelToggleText" Text="Notch Off" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                    <Button Click="FloatingPiPToggleBtn_Click" x:Name="FloatingPiPToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="3,0,0,0" ToolTipService.ToolTip="Detach into Floating Picture-in-Picture window (Ctrl+Alt+F)">
                                        <TextBlock x:Name="FloatingPiPToggleText" Text="PiP Off" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock Text="Top Margin" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                        <TextBlock x:Name="NotchOffsetText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="0 px" />
                                    </DockPanel>
                                    <Slider ValueChanged="NotchOffsetSlider_ValueChanged" x:Name="NotchOffsetSlider" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="45" Value="0" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Hardware Color Temperature -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Click="NightLightSettingsBtn_Click" x:Name="NightLightSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NightLightSettingsText" Text="Night Light Off" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                </Button>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock Text="Color Temperature" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                        <TextBlock x:Name="NightLightWarmthText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="3400 K" />
                                    </DockPanel>
                                    <Slider ValueChanged="NightLightWarmthSlider_ValueChanged" x:Name="NightLightWarmthSlider" Style="{StaticResource IslandSlider}" Minimum="2200" Maximum="5000" Value="3400" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Power & System Hooks Group -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Power Automation" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="BatteryHealthSummaryText" DockPanel.Dock="Right" Style="{StaticResource Digits}" Text="Health: 98% · AC" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Click="ChargingPulseToggleBtn_Click" x:Name="ChargingPulseToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                    <TextBlock x:Name="ChargingPulseToggleText" Text="MagSafe Pulse On" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="LowBattThresholdBtn_Click" x:Name="LowBattThresholdBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                    <TextBlock x:Name="LowBattThresholdText" Text="Alert: 20%" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="AutoPowerSaverToggleBtn_Click" x:Name="AutoPowerSaverToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                    <TextBlock x:Name="AutoPowerSaverToggleText" Text="Auto Saver Off" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                </Button>
                                <Button Click="AutoPowerAcToggleBtn_Click" x:Name="AutoPowerAcToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                    <TextBlock x:Name="AutoPowerAcToggleText" Text="Auto AC Perf Off" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                </Button>
                            </StackPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="System Hooks" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="DndToggleBtn_Click" x:Name="DndToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="DndToggleText" Text="DND Off" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                    <Button Click="BannerModeBtn_Click" x:Name="BannerModeBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="BannerModeText" Text="Island Only" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="VolumeOsdBtn_Click" x:Name="VolumeOsdBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="VolumeOsdText" Text="Vol Hook Off" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                    <Button Click="StartupToggleBtn_Click" x:Name="StartupToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                        <TextBlock x:Name="StartupToggleText" Text="Startup Off" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tab Passthrough & Window Interop Group -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Browser &amp; Tab Passthrough" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Prevents blocking browser tabs, search bars, and top controls" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Expand Trigger Mode -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Expand Trigger" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Click Only prevents popups while switching tabs" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerClickBtn" Tag="ClickOnly" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock Text="Click Only" FontSize="8" />
                                    </Button>
                                    <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerSnappyBtn" Tag="HoverSnappy" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,2,0">
                                        <TextBlock Text="Hover 150ms" FontSize="8" />
                                    </Button>
                                    <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerRelaxedBtn" Tag="HoverRelaxed" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0">
                                        <TextBlock Text="Hover 260ms" FontSize="8" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Ghost Passthrough Modifier -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ghost Click-Through Key" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Hold key to make island transparent and click tabs directly behind it" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="GhostModifierBtn_Click" x:Name="GhostModCtrlBtn" Tag="Ctrl" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                        <TextBlock Text="Ctrl" FontSize="8" />
                                    </Button>
                                    <Button Click="GhostModifierBtn_Click" x:Name="GhostModAltBtn" Tag="Alt" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                        <TextBlock Text="Alt" FontSize="8" />
                                    </Button>
                                    <Button Click="GhostModifierBtn_Click" x:Name="GhostModNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                        <TextBlock Text="Off" FontSize="8" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Quick Tuck & Hotkey -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Quick Tuck Gesture" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Double-click pill or Ctrl+Alt+Down to snooze for 5s" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="QuickTuckToggleBtn_Click" x:Name="QuickTuckToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0">
                                    <TextBlock x:Name="QuickTuckToggleText" Text="Tuck Enabled" FontSize="8" />
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 7. VIRTUAL COMPANION TAB                                      -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsPetTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="62" Height="54" CornerRadius="8" Background="#0CFFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <core:VirtualPetControl x:Name="SettingsHeroPet" MouseLeftButtonDown="PetCompanion_Click" Width="54" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock x:Name="SettingsHeroPetName" Text="Mochi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Cursor="Hand" MouseLeftButtonDown="PetNameBtn_Click" />
                                        <TextBlock x:Name="SettingsHeroPetRank" DockPanel.Dock="Right" Text="Level 1 · Companion" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock x:Name="SettingsHeroPetSub" Text="Interactive Capsule Companion" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,5" />
                                    <Grid Height="4" Background="#14FFFFFF" Margin="0,0,0,4">
                                        <Border x:Name="SettingsHeroPetProgressBar" HorizontalAlignment="Left" Width="45" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                    </Grid>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="SettingsHeroPetScore" Style="{StaticResource Digits}" Text="25 / 50 XP" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                        <TextBlock x:Name="SettingsHeroPetWellnessMini" DockPanel.Dock="Right" Style="{StaticResource Digits}" Text="Treat 0 · Water 0 · Stretch 0" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Customization Row -->
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Profile" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="PetStatusSummaryText" Text="Active" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="PetToggleBtn_Click" x:Name="PetToggleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetToggleText" Text="Pet On" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetSpeciesBtn_Click" x:Name="PetSpeciesBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetSpeciesText" Text="Species: Cat" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetAccessoryBtn_Click" x:Name="PetAccessoryBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetAccessoryText" Text="Gear: None" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetNameBtn_Click" x:Name="PetNameBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                        <TextBlock x:Name="PetNameBtnText" Text="Rename" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Care & Wellness Row -->
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Actions" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="OpenPetPlaygroundBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0" ToolTipService.ToolTip="Open full-sized interactive Pet Playground surface">
                                        <TextBlock Text="🏝️ Playground" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                    <Button Click="RoamDesktopBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0" ToolTipService.ToolTip="Detach companion to roam floating on desktop">
                                        <TextBlock Text="🪟 Roam" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetInteractBtn_Click" x:Name="PetInteractBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock Text="Pet" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetTreatBtn_Click" x:Name="PetTreatBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetTreatText" Text="Treat: 0" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetTrickBtn_Click" x:Name="PetTrickBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock Text="Flip" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetHydrateBtn_Click" x:Name="PetHydrateBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetHydrateText" Text="Water: 0" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetStretchBtn_Click" x:Name="PetStretchBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                                        <TextBlock x:Name="PetStretchText" Text="Stretch: 0" FontSize="8" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="PetReminderCycleBtn_Click" x:Name="PetReminderCycleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0">
                                        <TextBlock x:Name="PetReminderCycleText" Text="30m" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 8. KEYBOARD SHORTCUTS & BACKUP TAB                            -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsShortcutsTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock x:Name="HotkeySectionLabel" Text="Global Hotkeys (Ctrl + Alt)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="Click any keybind to record" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Structured 4-Column Keycap Matrix instead of cramped horizontal scroll -->
                            <UniformGrid Columns="4" Margin="0,0,0,2">
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindClipboardBtn" Tag="Clipboard" Style="{StaticResource IslandButton}" Height="22" Margin="0,0,3,3">
                                    <TextBlock x:Name="HotkeyBindClipboardText" Style="{StaticResource Digits}" Text="Clip · V" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindCalcBtn" Tag="Calculator" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,3">
                                    <TextBlock x:Name="HotkeyBindCalcText" Style="{StaticResource Digits}" Text="Calc · C" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindAudioBtn" Tag="AudioDevices" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,3">
                                    <TextBlock x:Name="HotkeyBindAudioText" Style="{StaticResource Digits}" Text="Audio · O" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindWifiBtn" Tag="Network" Style="{StaticResource IslandButton}" Height="22" Margin="3,0,0,3">
                                    <TextBlock x:Name="HotkeyBindWifiText" Style="{StaticResource Digits}" Text="Wi-Fi · W" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindTimerBtn" Tag="Stopwatch" Style="{StaticResource IslandButton}" Height="22" Margin="0,0,3,3">
                                    <TextBlock x:Name="HotkeyBindTimerText" Style="{StaticResource Digits}" Text="Timer · A" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindNotifBtn" Tag="Notifications" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,3">
                                    <TextBlock x:Name="HotkeyBindNotifText" Style="{StaticResource Digits}" Text="Alerts · N" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindHudBtn" Tag="SystemHud" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,3">
                                    <TextBlock x:Name="HotkeyBindHudText" Style="{StaticResource Digits}" Text="HUD · H" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindMemoBtn" Tag="VoiceMemo" Style="{StaticResource IslandButton}" Height="22" Margin="3,0,0,3">
                                    <TextBlock x:Name="HotkeyBindMemoText" Style="{StaticResource Digits}" Text="Memo · R" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindDevicesBtn" Tag="Peripherals" Style="{StaticResource IslandButton}" Height="22" Margin="0,0,3,0">
                                    <TextBlock x:Name="HotkeyBindDevicesText" Style="{StaticResource Digits}" Text="BT · D" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindPowerBtn" Tag="BatteryPower" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,0">
                                    <TextBlock x:Name="HotkeyBindPowerText" Style="{StaticResource Digits}" Text="Power · P" FontSize="8" />
                                </Button>
                                <Button Click="HotkeyRecordBtn_Click" x:Name="HotkeyBindSettingsBtn" Tag="Settings" Style="{StaticResource IslandButton}" Height="22" Margin="1.5,0,1.5,0">
                                    <TextBlock x:Name="HotkeyBindSettingsText" Style="{StaticResource Digits}" Text="Config · S" FontSize="8" />
                                </Button>
                            </UniformGrid>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Configuration Snapshot -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Configuration Snapshot" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Export, restore or factory reset JSON profile" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ExportSettingsBtn_Click" x:Name="ExportSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,3,0">
                                        <TextBlock Text="Export" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="ImportSettingsBtn_Click" x:Name="ImportSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,3,0">
                                        <TextBlock Text="Import" FontSize="8.5" FontWeight="Medium" />
                                    </Button>
                                    <Button Click="ResetSettingsBtn_Click" x:Name="ResetSettingsBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0">
                                        <TextBlock x:Name="ResetSettingsText" Text="Reset" FontSize="8.5" FontWeight="Medium" Foreground="#FF453A" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───────────────────────────────────────────────────────────── -->
                    <!-- GITHUB UPDATES & VERSION CONTROL MANAGER                     -->
                    <!-- ───────────────────────────────────────────────────────────── -->
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GitHub Updates &amp; Version Control" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="UpdateStatusSubtitleText" Text="Check releases, switch channels, or rollback" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="CheckUpdatesBtn_Click" x:Name="CheckUpdatesBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,4,0" ToolTipService.ToolTip="Query GitHub for new releases">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CheckUpdatesBtnText" Text="Check" FontSize="8.5" FontWeight="Medium" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="UpdateChannelBtn_Click" x:Name="UpdateChannelBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Toggle release channel: Stable vs Beta">
                                        <TextBlock x:Name="UpdateChannelText" Text="Stable" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Update Available Banner (visible when an update is found) -->
                            <Border x:Name="UpdateAvailableBanner" Visibility="Collapsed" Background="#140A84FF" BorderBrush="#330A84FF" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,7,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="8.5" Foreground="#0A84FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="UpdateVersionTitleText" Text="v0.5.0 Available" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                            <TextBlock x:Name="UpdateSummaryText" Text="New liquid physics and performance improvements." FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" MaxWidth="320" Margin="0,2,0,0" />
                                            <Button Click="ViewChangelogBtn_Click" x:Name="ViewChangelogBtn" Style="{StaticResource IslandButton}" Height="18" Padding="6,0" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="7" Margin="0,0,3,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="View Changelog on GitHub" FontSize="7" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Click="InstallUpdateBtn_Click" x:Name="InstallUpdateBtn" Style="{StaticResource IslandButton}" Height="22" Padding="9,0" Background="#1F0A84FF" BorderBrush="#4D0A84FF">
                                                <TextBlock x:Name="InstallUpdateBtnText" Text="Install &amp; Restart" FontSize="8.5" FontWeight="SemiBold" Foreground="#0A84FF" />
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Download Progress Indicator -->
                                    <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Height="4" Margin="0,6,0,2" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}" Background="#1FFFFFFF" BorderThickness="0" />
                                    <TextBlock x:Name="UpdateProgressText" Visibility="Collapsed" Text="Downloading: 0%" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Auto-check Toggle & History -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatic Daily Update Checks" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="LastCheckTimestampText" Text="Last checked: Never" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="AutoCheckToggleBtn_Click" x:Name="AutoCheckToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoCheckToggleText" Text="On" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- Pre-Download Verified Updates Toggle -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pre-Download Verified Updates" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Silently download &amp; verify in background for instant restart" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="AutoDownloadToggleBtn_Click" x:Name="AutoDownloadToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoDownloadToggleText" Text="On" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <!-- GitHub API Token (Optional) -->
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GitHub API Token (Optional)" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Bypasses GitHub's 60 req/hr rate limit (increases to 5,000 req/hr)" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="GitHubTokenBox" DockPanel.Dock="Right" Width="110" Height="20" FontSize="8"
                                         VerticalAlignment="Center" Padding="4,1" Margin="6,0,0,0"
                                         Background="#14FFFFFF" Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                         LostFocus="GitHubTokenBox_LostFocus"
                                         ToolTipService.ToolTip="GitHub Personal Access Token for high-rate API queries" />
                            </DockPanel>

                            <!-- Version History / Rollback Drawer Toggle -->
                            <Border Style="{StaticResource GroupHairline}" />
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Version History &amp; Rollback" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Switch to previous GitHub releases if experiencing hardware conflicts" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="ToggleVersionHistoryBtn_Click" x:Name="ToggleVersionHistoryBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ToggleVersionHistoryText" Text="View Releases" FontSize="8.5" FontWeight="Medium" />
                                </Button>
                            </DockPanel>

                            <!-- Version History Items Container -->
                            <StackPanel x:Name="VersionHistoryContainer" Visibility="Collapsed" Margin="0,6,0,0">
                                <Border Background="#08FFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                    <StackPanel x:Name="VersionHistoryList" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- 9. NOTIFICATIONS & ALERTS TAB                                 -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="SettingsNotifTab" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,6">
                    <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notification Center" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Inspect ring buffer history and intercepted system toasts" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="OpenNotifCenterBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="9,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open Center" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Do Not Disturb" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Suppress incoming banner animations and alert chimes" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="DndToggleBtn_Click" x:Name="SettingsDndToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SettingsDndToggleText" Text="Off" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                                </Button>
                            </DockPanel>

                            <Border Style="{StaticResource GroupHairline}" />

                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Intercept Windows Toast Banners" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Dismiss native bottom-right popups and route exclusively to the capsule" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                </StackPanel>
                                <Button Click="ReplaceBannersToggleBtn_Click" x:Name="ReplaceBannersToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReplaceBannersToggleText" Text="Active" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>