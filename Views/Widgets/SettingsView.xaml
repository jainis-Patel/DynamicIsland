<UserControl x:Class="DynamicIsland.Views.Widgets.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sp="clr-namespace:DynamicIsland.Views.Widgets.Settings"
             mc:Ignorable="d"
             d:DesignHeight="348" d:DesignWidth="508"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- TOP UTILITY HEADER + GLOBAL SEARCH                                -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="2,0,2,8" LastChildFill="True">
            <!-- Left Branding -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Border Width="18" Height="18" CornerRadius="4.5" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Settings" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersionText" Text="0.8.0" Style="{StaticResource Digits}" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Right Utilities -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Click="SettingsTrimRamBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Purge working set memory &amp; compact garbage collector">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="8" Foreground="{DynamicResource GreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsRamBadgeText" Text="Purge" Style="{StaticResource Digits}" FontSize="7.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsOpenDataBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Open App Data directory in File Explorer">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xED25;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Data" FontSize="7.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedThemeName" Text="Solar Amber" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Global Search Input -->
            <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,0" Height="21" VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <Button x:Name="SettingsSearchClearBtn" DockPanel.Dock="Right" Click="SettingsSearchClearBtn_Click" Style="{StaticResource IslandButton}" Width="15" Height="15" Padding="0" Margin="3,0,0,0" Background="Transparent" Visibility="Collapsed" ToolTipService.ToolTip="Clear search (Esc)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="6.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsSearchPlaceholder" Text="Search settings (Ctrl+F)" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.7" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="SettingsSearchBox" TextChanged="SettingsSearchBox_TextChanged" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="8.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- 2-COLUMN SPLIT: LEFT SIDEBAR RAIL + PANEL HOST                    -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="106" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Rail -->
            <Border Grid.Column="0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,5" VerticalAlignment="Stretch">
                <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabAppearanceBtn" Tag="Appearance" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Material, Color Mode, Accent &amp; Physics">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarAppearance" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Visible" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabAppearanceText" Text="Appearance" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabThemesBtn" Tag="Themes" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Botanical &amp; Living Flora Overlays">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarThemes" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEC0A;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabThemesText" Text="Flora" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabClockBtn" Tag="Clock" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Clock Faces, Audio Visualizer &amp; Capsule Elements">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarClock" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabClockText" Text="Clock &amp; Audio" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDropletsBtn" Tag="Droplets" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Modular Zero-RAM Droplets">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="SettingsRailDropletsBadge" DockPanel.Dock="Right" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="3.5,0.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="SettingsRailDropletsCount" Style="{StaticResource Digits}" Text="17" FontSize="7" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SettingsRailBarDroplets" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xF158;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                    <TextBlock x:Name="SettingsTabDropletsText" Text="Modules" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabDockBtn" Tag="Dock" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Dock Strip Manager">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarDock" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE90D;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabDockText" Text="Dock Strip" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabScreenBtn" Tag="Screen" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Display, Notch, Power &amp; Browser Passthrough">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarScreen" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabScreenText" Text="Display" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabNotifBtn" Tag="Notifications" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Notifications, DND &amp; Muted Apps">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarNotif" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabNotifText" Text="Alerts" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabPetBtn" Tag="Pet" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Desktop Pet Companion">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarPet" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabPetText" Text="Companion" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabShortcutsBtn" Tag="Shortcuts" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Global Shortcuts &amp; Keyboard Hooks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SettingsRailBarShortcuts" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                <TextBlock x:Name="SettingsTabShortcutsText" Text="Shortcuts" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="SettingsTabBtn_Click" x:Name="SettingsTabUpdatesBtn" Tag="Updates" Style="{StaticResource SettingsRailButtonStyle}" ToolTipService.ToolTip="Startup, Backup, Performance &amp; GitHub Updates">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="SettingsRailUpdateBadgeDot" DockPanel.Dock="Right" Width="6" Height="6" CornerRadius="3" Background="#0A84FF" Visibility="Collapsed" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SettingsRailBarUpdates" Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="9" Margin="0,0,6,0" Opacity="0.88" />
                                    <TextBlock x:Name="SettingsTabUpdatesText" Text="System" FontSize="8.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content Host -->
            <Grid Grid.Column="2">
                <sp:AppearanceSettingsPanel x:Name="AppearancePanel" Visibility="Visible" />
                <sp:FloraSettingsPanel x:Name="FloraPanel" Visibility="Collapsed" />
                <sp:ClockAudioSettingsPanel x:Name="ClockAudioPanel" Visibility="Collapsed" />
                <sp:DropletsSettingsPanel x:Name="DropletsPanel" Visibility="Collapsed" />
                <sp:DockSettingsPanel x:Name="DockPanel" Visibility="Collapsed" />
                <sp:DisplayPowerSettingsPanel x:Name="DisplayPowerPanel" Visibility="Collapsed" />
                <sp:NotificationsSettingsPanel x:Name="NotificationsPanel" Visibility="Collapsed" />
                <sp:PetSettingsPanel x:Name="PetPanel" Visibility="Collapsed" />
                <sp:ShortcutsSettingsPanel x:Name="ShortcutsPanel" Visibility="Collapsed" />
                <sp:SystemUpdatesSettingsPanel x:Name="SystemUpdatesPanel" Visibility="Collapsed" />

                <!-- Global Search Results Overlay -->
                <Grid x:Name="SettingsSearchResultsHost" Visibility="Collapsed">
                    <ScrollViewer x:Name="SettingsSearchResultsScroll"
                                  PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,0,4,6">
                            <Border x:Name="SettingsSearchEmptyPlaceholder" Visibility="Collapsed" Style="{StaticResource SettingsGroupCard}" Padding="14,18" Margin="0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="No matching settings found" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="SettingsSearchResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SearchResultItem_Click" Tag="{Binding CategoryKey}" Style="{StaticResource IslandButton}"
                                                Height="Auto" Padding="9,6" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                                                Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="4.5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource ChipBgBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
