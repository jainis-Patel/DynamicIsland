<UserControl x:Class="DynamicIsland.Views.Widgets.PhoneBridgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="470">
    <Grid Margin="0,2,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Session Controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackToLauncher_Click" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0,0,6,0" ToolTipService.ToolTip="Back to Apps &amp; Widgets">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EA;" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Phone Bridge &amp; QuickShare" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PhoneBridgeStatusBadge" Text="Local Wi-Fi PWA · No App Required" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ToggleSessionBtn_Click" x:Name="ToggleSessionBtn" Style="{StaticResource IslandButton}" Height="21" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Start or stop local HTTP bridge">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ToggleSessionGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="8.5" Foreground="{DynamicResource GreenBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToggleSessionText" Text="Start Bridge" FontSize="8" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="CopyUrlBtn_Click" x:Name="CopyUrlBtn" Style="{StaticResource IslandButton}" Height="21" Width="22" Padding="0" Margin="0,0,4,0" ToolTipService.ToolTip="Copy Phone Pairing URL to clipboard">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                </Button>
                <Button Click="OpenInBrowserBtn_Click" Style="{StaticResource IslandButton}" Height="21" Width="22" Padding="0" ToolTipService.ToolTip="Open Web Portal in default browser">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Body: Two Columns (Pairing Radar Left + Beam & Sync Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pairing Radar & URL Station -->
            <Border Grid.Column="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Radar State Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Margin="0,0,4,0" />
                            <TextBlock x:Name="SessionStateText" Text="Server Idle" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="TimerText" Text="--:--" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Visual Pairing Matrix Card with Camera-Scannable QR Code -->
                    <Border Grid.Row="1" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,2,0,3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- High-Contrast Scannable QR Container -->
                            <Button x:Name="QrCodeClickBtn" Click="QrCodeCard_Click" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTipService.ToolTip="Click to start bridge or copy pairing URL">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <!-- White high-contrast background card for instant phone camera lock -->
                                    <Border x:Name="QrCardBorder" Background="#FFFFFFFF" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="QrCodeImage" Width="80" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Dormant Overlay Badge when bridge is idle -->
                                    <Border x:Name="DormantOverlay" Background="#E6161618" CornerRadius="8" Padding="7,4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="9.5" Foreground="{DynamicResource GreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Click to Start" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock Text="Scan with Phone Camera" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            <TextBlock x:Name="LanIpText" Text="http://192.168.x.x:8989" FontSize="7.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Token & Quick Copy -->
                    <Border Grid.Row="2" Background="{DynamicResource BorderSubtleBrush}" CornerRadius="6" Padding="6,3">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="Token:" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="TokenDisplay" Text="Click 'Start Bridge'" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Drop to Beam + Clipboard Bridge -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Beam Drop Zone -->
                <Border Grid.Row="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,6"
                        AllowDrop="True" Drop="BeamDropZone_Drop" DragOver="BeamDropZone_DragOver">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Drop files to beam to Phone" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Available instantly to any connected iPhone/Android browser" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Bridge Actions -->
                <Border Grid.Row="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,4">
                    <DockPanel LastChildFill="False">
                        <Button Click="SyncClipboardBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Send current Windows clipboard text to phone">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="Push Clipboard" FontSize="8" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Click="ViewShelfBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" ToolTipService.ToolTip="Open Drop Shelf to manage beamed files">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="Drop Shelf" FontSize="8" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <TextBlock DockPanel.Dock="Right" x:Name="LastActivityText" Text="Waiting for connection" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
