<UserControl x:Class="DynamicIsland.Views.Widgets.WidgetsGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="356" d:DesignWidth="520"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             PreviewMouseWheel="WidgetsGallery_PreviewMouseWheel">
    <UserControl.Resources>
        <!-- Quiet Frosted Bento Card -->
        <Style x:Key="BentoCardBorder" TargetType="Border" BasedOn="{StaticResource BentoSpringMotionBorder}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DockActiveBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Micro Pin-to-Desktop Button -->
        <Style x:Key="PinMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ToolTip" Value="Pin floating widget to Desktop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PinBg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="9" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PinBg" Property="Background" Value="{DynamicResource ChipBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PinBg" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Inline Action Button -->
        <Style x:Key="MicroActionBtn" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Segmented Filter Pill Button -->
        <Style x:Key="FilterPillBtn" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBg" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,1,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="2,0,2,7" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74C;" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Widgets" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UnpinAllDesktopBtn" Click="UnpinAllDesktopBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,5,0" Visibility="Collapsed" ToolTipService.ToolTip="Close all pinned desktop widgets">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77A;" FontSize="8.5" Foreground="{DynamicResource AmberBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UnpinAllDesktopText" Text="Unpin (1)" FontSize="8.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="OpenLaunchpad_Click" Style="{StaticResource IslandButton}" Height="22" Padding="9,0" ToolTipService.ToolTip="Open Apps Launchpad (Ctrl+6)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Launchpad" FontSize="8.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Category Filter Strip -->
        <Border Grid.Row="1"
                Margin="2,0,2,8"
                Background="{DynamicResource ChipBgBrush}"
                BorderBrush="{DynamicResource ChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="2"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterAllBtn" Tag="All" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="All" />
                <Button x:Name="FilterLiveBtn" Tag="Live" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="Live" Margin="2,0,0,0" />
                <Button x:Name="FilterToolsBtn" Tag="Tools" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="Tools" Margin="2,0,0,0" />
                <Button x:Name="FilterPinnedBtn" Tag="Pinned" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Margin="2,0,0,0">
                    <TextBlock x:Name="FilterPinnedText" Text="Pinned" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Scrollable Bento Surface -->
        <ScrollViewer Grid.Row="2"
                      x:Name="WidgetsScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Focusable="False"
                      PanningMode="VerticalOnly"
                      SizeChanged="WidgetsScrollViewer_SizeChanged"
                      PreviewMouseWheel="WidgetsGallery_PreviewMouseWheel">
            <StackPanel Margin="2,1,4,12">

                <!-- Section: Live Telemetry -->
                <TextBlock x:Name="LiveSectionHeader"
                           Text="Live Telemetry"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryBrush}"
                           Margin="2,0,0,6" />

                <!-- Hero Wide Card: Now Playing -->
                <Border x:Name="MediaHeroCard"
                        Style="{StaticResource BentoCardBorder}"
                        Padding="12,9"
                        Margin="0,0,0,7"
                        MouseLeftButtonDown="MediaCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <core:PlayerDiscControl x:Name="MediaArtDisc" Grid.Column="0" DiscSize="36" ShowTonearm="False" SquircleRadius="9" Margin="0,0,10,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid Margin="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TrackTitleText" Grid.Column="0" Text="No media playing" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                <Border x:Name="PlayerBrandBadgeHost" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Padding="5,1" CornerRadius="5" Background="{DynamicResource ChipBgBrush}" Visibility="Collapsed">
                                    <TextBlock x:Name="PlayerBrandBadgeText" Text="Spotify" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TrackArtistText" Text="Open a media player to control playback" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PrevMiniBtn" Click="PrevMiniBtn_Click" Style="{StaticResource MicroActionBtn}" Margin="0,0,3,0" ToolTipService.ToolTip="Previous track">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="PlayPauseMiniBtn" Click="PlayPauseMiniBtn_Click" Style="{StaticResource IslandButton}" Width="24" Height="24" Padding="0" Margin="0,0,3,0" ToolTipService.ToolTip="Play / Pause">
                                <TextBlock x:Name="PlayPauseMiniGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="10.5" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="NextMiniBtn" Click="NextMiniBtn_Click" Style="{StaticResource MicroActionBtn}" ToolTipService.ToolTip="Next track">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="PinMediaBtn" Tag="Media" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Responsive 2-Column Live Grid -->
                <WrapPanel x:Name="LiveCardsWrapPanel" Margin="0,0,-7,4">
                    <!-- 1. System Vitals -->
                    <Border x:Name="CardVitals" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="SystemVitalsCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="11.5" Foreground="#FF9F0A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="System Vitals" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CpuPercentBadge" Style="{StaticResource Digits}" Text="0%" FontSize="9" FontWeight="SemiBold" Foreground="#FF9F0A" VerticalAlignment="Center" />
                                    <Button x:Name="PinVitalsBtn" Tag="Vitals" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,0,0,7">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="4.5" CornerRadius="2.25" Background="{DynamicResource ChipBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="CpuBarFillCol" Width="10*" />
                                                <ColumnDefinition x:Name="CpuBarTrackCol" Width="90*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2.25" Background="#FF9F0A" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="CpuDetailText" Grid.Column="2" Style="{StaticResource Digits}" Text="0%" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="4.5" CornerRadius="2.25" Background="{DynamicResource ChipBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="RamBarFillCol" Width="25*" />
                                                <ColumnDefinition x:Name="RamBarTrackCol" Width="75*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2.25" Background="#0A84FF" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="RamDetailText" Grid.Column="2" Style="{StaticResource Digits}" Text="0 GB" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="HardwareSummaryText" Grid.Row="2" Text="Hardware Monitor" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 2. Battery & Power -->
                    <Border x:Name="CardBattery" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="BatteryCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="11.5" Foreground="#30D158" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Battery" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PowerPlanBadge" Text="Balanced" FontSize="8.5" FontWeight="Medium" Foreground="#30D158" MaxWidth="82" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button x:Name="PinBatteryBtn" Tag="Battery" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,7">
                                    <TextBlock x:Name="BatteryBigPercent" Style="{StaticResource Digits}" Text="100%" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="BatteryStatusText" Text="Charging" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource ChipBgBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="BatteryBarFillCol" Width="100*" />
                                            <ColumnDefinition x:Name="BatteryBarTrackCol" Width="0*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BatteryBarFill" Grid.Column="0" CornerRadius="2.5" Background="#30D158" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Network & Speed -->
                    <Border x:Name="CardNetwork" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="NetworkCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="11.5" Foreground="#0A84FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Network" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="NetworkPingBadge" Style="{StaticResource Digits}" Text="—" FontSize="8.5" FontWeight="Medium" Foreground="#0A84FF" VerticalAlignment="Center" />
                                    <Button x:Name="PinNetworkBtn" Tag="Network" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Download" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                    <TextBlock x:Name="NetDownloadSpeed" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Upload" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                    <TextBlock x:Name="NetUploadSpeed" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="NetworkNameText" Grid.Row="2" Text="Checking connection..." FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 4. Calendar & Agenda -->
                    <Border x:Name="CardCalendar" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="CalendarCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE787;" FontSize="11.5" Foreground="#FFD60A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Calendar" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TodayDateBadge" Text="Today" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="PinCalendarBtn" Tag="Calendar" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NextEventTitleText" Text="All caught up" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NextEventTimeText" Text="No upcoming meetings today" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Weather -->
                    <Border x:Name="CardWeather" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="WeatherCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WeatherGlyphIcon" Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE706;" FontSize="11.5" Foreground="#FFD60A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Weather" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="WeatherLocationBadge" Text="Local" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" MaxWidth="68" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button x:Name="PinWeatherBtn" Tag="Weather" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock x:Name="WeatherTempBigText" Style="{StaticResource Digits}" Text="—°C" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="WeatherConditionText" Text="Syncing" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="WeatherForecastText" Grid.Row="2" Text="Updating local forecast" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 6. Focus Timer -->
                    <Border x:Name="CardTimer" Style="{StaticResource BentoCardBorder}" Margin="0,0,7,7" MouseLeftButtonDown="TimerCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="11.5" Foreground="#FF9F0A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Focus Timer" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TimerModeBadgeText" Text="Ready" FontSize="8.5" FontWeight="Medium" Foreground="#FF9F0A" VerticalAlignment="Center" />
                                    <Button x:Name="PinTimerBtn" Tag="Timer" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </Grid>
                            <DockPanel Grid.Row="1" Margin="0,0,0,5" LastChildFill="True">
                                <Button x:Name="TimerQuickToggleBtn" DockPanel.Dock="Right" Click="TimerQuickToggleBtn_Click" Style="{StaticResource MicroActionBtn}" ToolTipService.ToolTip="Start / Pause Pomodoro Timer">
                                    <TextBlock x:Name="TimerQuickToggleGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="9" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
