<UserControl x:Class="DynamicIsland.Views.Widgets.WidgetsGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="470"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             PreviewMouseWheel="WidgetsGallery_PreviewMouseWheel">
    <UserControl.Resources>
        <!-- Apple Bento Card Style with Glass Refraction & Spring Hover Feedback -->
        <Style x:Key="BentoCardBorder" TargetType="Border" BasedOn="{StaticResource BentoSpringMotionBorder}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tinted Icon Squircle Backdrop -->
        <Style x:Key="CardIconSquircle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Micro Pin-to-Desktop Action Button inside Bento Cards -->
        <Style x:Key="PinMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ToolTip" Value="Pin floating widget to Desktop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PinBg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="9.5" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PinBg" Property="Background" Value="{DynamicResource ChipBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PinBg" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Micro Transport / Action Button -->
        <Style x:Key="MicroActionBtn" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Category Tag Badge Style -->
        <Style x:Key="CategoryTagBadge" TargetType="Border">
            <Setter Property="Height" Value="17" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="8.5" />
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Segmented Filter Pill Button -->
        <Style x:Key="FilterPillBtn" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBg" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,1,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Launchpad Link -->
        <DockPanel Grid.Row="0" Margin="2,0,2,7" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74C;" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Widgets Gallery" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Live telemetry, media &amp; quick tools" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UnpinAllDesktopBtn" Click="UnpinAllDesktopBtn_Click" Style="{StaticResource IslandButton}" Height="24" Padding="8,0" Margin="0,0,5,0" Visibility="Collapsed" ToolTipService.ToolTip="Close all pinned desktop widgets">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77A;" FontSize="8.5" Foreground="{DynamicResource AmberBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UnpinAllDesktopText" Text="Unpin (1)" FontSize="8.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button Click="OpenLaunchpad_Click" Style="{StaticResource IslandButton}" Height="24" Padding="9,0" Margin="0,0,2,0" ToolTipService.ToolTip="Switch to Apps &amp; Launchpad (Ctrl+6)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Apps Launchpad" FontSize="8.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Segmented Category Filter Pill Strip -->
        <Border Grid.Row="1"
                Margin="2,0,2,8"
                Background="{DynamicResource ChipBgBrush}"
                BorderBrush="{DynamicResource ChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="2"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterAllBtn" Tag="All" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="All" />
                <Button x:Name="FilterLiveBtn" Tag="Live" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="Live" Margin="2,0,0,0" />
                <Button x:Name="FilterToolsBtn" Tag="Tools" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Content="Tools" Margin="2,0,0,0" />
                <Button x:Name="FilterPinnedBtn" Tag="Pinned" Click="FilterBtn_Click" Style="{StaticResource FilterPillBtn}" Margin="2,0,0,0">
                    <TextBlock x:Name="FilterPinnedText" Text="Pinned" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Center Content: Bento Box Grid of Live Widgets -->
        <ScrollViewer Grid.Row="2"
                      x:Name="WidgetsScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Focusable="False"
                      PanningMode="VerticalOnly"
                      SizeChanged="WidgetsScrollViewer_SizeChanged"
                      PreviewMouseWheel="WidgetsGallery_PreviewMouseWheel">
            <StackPanel Margin="2,2,4,14">

                <!-- Section Header: Live Telemetry & Glance -->
                <TextBlock x:Name="LiveSectionHeader"
                           Text="LIVE TELEMETRY &amp; GLANCE"
                           FontSize="7.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryBrush}"
                           Margin="2,0,0,6" />

                <!-- Hero Featured Wide Card: Now Playing & Audio Glance -->
                <Border x:Name="MediaHeroCard"
                        Style="{StaticResource BentoCardBorder}"
                        Margin="0,0,0,6"
                        MouseLeftButtonDown="MediaCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Art or Music Squircle -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="MediaThumbnailImage" Width="38" Height="38" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,38,38" RadiusX="8" RadiusY="8" />
                                    </Image.Clip>
                                </Image>
                                <TextBlock x:Name="MediaFallbackGlyph" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Track Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NOW PLAYING" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Border x:Name="PlayerBrandBadgeHost" Style="{StaticResource CategoryTagBadge}" Visibility="Collapsed">
                                    <TextBlock x:Name="PlayerBrandBadgeText" Text="Spotify" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TrackTitleText" Text="No media playing" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0" />
                            <TextBlock x:Name="TrackArtistText" Text="Open Spotify, Apple Music, or YouTube Music" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Transport Controls & Desktop Pin Icon -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinMediaBtn" Tag="Media" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" Margin="0,0,5,0" />
                            <Button x:Name="PrevMiniBtn" Click="PrevMiniBtn_Click" Style="{StaticResource MicroActionBtn}" Margin="0,0,3,0" ToolTipService.ToolTip="Previous track">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="PlayPauseMiniBtn" Click="PlayPauseMiniBtn_Click" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="0" Margin="0,0,3,0" ToolTipService.ToolTip="Play / Pause">
                                <TextBlock x:Name="PlayPauseMiniGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="NextMiniBtn" Click="NextMiniBtn_Click" Style="{StaticResource MicroActionBtn}" ToolTipService.ToolTip="Next track">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Responsive 2-Column Live Telemetry WrapPanel -->
                <WrapPanel x:Name="LiveCardsWrapPanel" Margin="0,0,-6,4">
                    <!-- 1. System Vitals Widget Card -->
                    <Border x:Name="CardVitals" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="SystemVitalsCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1FFF9F0A">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="10.5" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SYSTEM VITALS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CategoryTagBadge}">
                                        <TextBlock x:Name="CpuPercentBadge" Style="{StaticResource Digits}" Text="CPU 0%" FontSize="7.5" FontWeight="SemiBold" Foreground="#FF9F0A" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="PinVitalsBtn" Tag="Vitals" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Proportional Mini Bars: CPU & RAM -->
                            <StackPanel Grid.Row="1" Margin="0,1,0,5">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="{DynamicResource ChipBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="CpuBarFillCol" Width="10*" />
                                                <ColumnDefinition x:Name="CpuBarTrackCol" Width="90*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2.5" Background="#FF9F0A" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="CpuDetailText" Grid.Column="2" Style="{StaticResource Digits}" Text="0%" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="{DynamicResource ChipBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="RamBarFillCol" Width="25*" />
                                                <ColumnDefinition x:Name="RamBarTrackCol" Width="75*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2.5" Background="#0A84FF" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="RamDetailText" Grid.Column="2" Style="{StaticResource Digits}" Text="0 GB" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="HardwareSummaryText" Grid.Row="2" Text="Hardware Monitor · Click for HUD" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 2. Battery & Power Widget Card -->
                    <Border x:Name="CardBattery" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="BatteryCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1F30D158">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="10.5" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="BATTERY" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CategoryTagBadge}">
                                        <TextBlock x:Name="PowerPlanBadge" Text="Balanced" FontSize="7.5" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="PinBatteryBtn" Tag="Battery" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock x:Name="BatteryBigPercent" Style="{StaticResource Digits}" Text="100%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BatteryStatusText" Text=" · AC Online" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="4,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource ChipBgBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="BatteryBarFillCol" Width="100*" />
                                            <ColumnDefinition x:Name="BatteryBarTrackCol" Width="0*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BatteryBarFill" Grid.Column="0" CornerRadius="2.5" Background="#30D158" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="BatteryActionHint" Grid.Row="2" Text="Click for battery health &amp; power plans" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 3. Wi-Fi & Network Speedometer Card -->
                    <Border x:Name="CardNetwork" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="NetworkCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1F0A84FF">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="10.5" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="NETWORK" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CategoryTagBadge}">
                                        <TextBlock x:Name="NetworkPingBadge" Style="{StaticResource Digits}" Text="—" FontSize="7.5" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="PinNetworkBtn" Tag="Network" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,1,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="↓ DOWNLOAD" FontSize="7" FontWeight="SemiBold" Foreground="#0A84FF" />
                                    <TextBlock x:Name="NetDownloadSpeed" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="↑ UPLOAD" FontSize="7" FontWeight="SemiBold" Foreground="#BF5AF2" />
                                    <TextBlock x:Name="NetUploadSpeed" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="NetworkNameText" Grid.Row="2" Text="Checking network..." FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 4. Calendar & Agenda Card -->
                    <Border x:Name="CardCalendar" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="CalendarCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1FFFD60A">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" FontSize="10.5" Foreground="#FFD60A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="CALENDAR" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CategoryTagBadge}">
                                        <TextBlock x:Name="TodayDateBadge" Text="TODAY" FontSize="7.5" FontWeight="SemiBold" Foreground="#FFD60A" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="PinCalendarBtn" Tag="Calendar" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,1,0,5">
                                <TextBlock x:Name="NextEventTitleText" Text="All caught up" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NextEventTimeText" Text="No upcoming meetings" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Click for calendar &amp; tasks" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 5. Live Weather & Forecast Card -->
                    <Border x:Name="CardWeather" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="WeatherCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1FFFD60A">
                                        <TextBlock x:Name="WeatherGlyphIcon" Style="{StaticResource Glyph}" Text="&#xE706;" FontSize="10.5" Foreground="#FFD60A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="WEATHER" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CategoryTagBadge}">
                                        <TextBlock x:Name="WeatherLocationBadge" Text="Local" FontSize="7.5" FontWeight="SemiBold" Foreground="#FFD60A" VerticalAlignment="Center" MaxWidth="62" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button x:Name="PinWeatherBtn" Tag="Weather" Click="PinDesktopWidget_Click" Style="{StaticResource PinMiniBtn}" />
