                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1FFF375F">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" FontSize="10.5" Foreground="#FF375F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="MECH SOUNDS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Style="{StaticResource CategoryTagBadge}" DockPanel.Dock="Right">
                                    <TextBlock x:Name="MechSoundsStateBadge" Text="Off" FontSize="7.5" FontWeight="SemiBold" Foreground="#FF375F" VerticalAlignment="Center" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Tactile Keyboard Studio" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="Cherry Blue, Brown, Holy Panda &amp; Thock" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 20. Clipboard History Queue Card -->
                    <Border x:Name="CardClipboard" Style="{StaticResource BentoCardBorder}" Margin="0,0,6,6" MouseLeftButtonDown="ClipboardCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconSquircle}" Background="#1FFF9F0A">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="10.5" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="CLIPBOARD QUEUE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Clipboard History" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="DPAPI encrypted history &amp; pinned clips" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
