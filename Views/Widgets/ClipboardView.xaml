<UserControl x:Class="DynamicIsland.Views.Widgets.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="464">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="SwitchToShelf_Click" Style="{StaticResource IslandButton}" Height="18" Padding="7,0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Switch to Drop Shelf">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="Files" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource CardSurfaceBrush}" CornerRadius="6" Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Clipboard" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ClipboardCountText" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Text="0 items" />
                <Button Click="ClipboardScrollLeft_Click" x:Name="ClipboardScrollLeftBtn" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0,0,3,0" ToolTipService.ToolTip="Scroll Left (Previous Items)" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="8.5" />
                </Button>
                <Button Click="ClipboardScrollRight_Click" x:Name="ClipboardScrollRightBtn" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0" ToolTipService.ToolTip="Scroll Right (Next Items)" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="8.5" />
                </Button>
            </StackPanel>
            <Button Click="ClearClipboardButton_Click" x:Name="ClearClipboardButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="4,0,0,0" ToolTipService.ToolTip="Clear Unpinned Clipboard History">
                <TextBlock Text="Clear" FontSize="9.5" FontWeight="Medium" />
            </Button>
            <Button Click="ClipboardQuickPickerButton_Click" x:Name="ClipboardQuickPickerButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="4,0,0,0" ToolTipService.ToolTip="Open Quick Paste Picker &amp; Sequential Paste Queue (or press Ctrl+Alt+B)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE762;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClipboardQueueBtnText" Text="Queue" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OcrClipboardButton_Click" x:Name="OcrClipboardButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="4,0,0,0" ToolTipService.ToolTip="Extract Text (OCR) from Clipboard Screenshot / Image">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock Text="OCR" FontSize="9.5" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="CaptureRegionButton_Click" x:Name="CaptureRegionButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="4,0,0,0" ToolTipService.ToolTip="Element Capture: Snip screen region, annotate, OCR text, or Pin floating screenshot on top (Ctrl+Alt+X)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock Text="Snip &amp; Pin" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="EyedropperButton_Click" x:Name="EyedropperButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="0" ToolTipService.ToolTip="Sample Screen Pixel Color Under Cursor (1.2s delay)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEF3C;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock Text="Color" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Height="22" Width="116" Padding="5,0" Margin="4,0,0,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBox KeyDown="ClipboardSearchBox_KeyDown" TextChanged="ClipboardSearchBox_TextChanged" x:Name="ClipboardSearchBox" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="9.5" Width="78" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" ToolTipService.ToolTip="Search clipboard history" />
                    </StackPanel>
                    <Button Click="ClearClipboardSearch_Click" x:Name="ClearClipboardSearchBtn" Visibility="Collapsed" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" ToolTipService.ToolTip="Clear Search">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterAllBtn" Tag="All" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                        <TextBlock Text="All" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Button>
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterPinnedBtn" Tag="Pinned" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE840;" FontSize="7.5" Margin="0,0,2,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pinned" FontSize="8.5" />
                        </StackPanel>
                    </Button>
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterLinksBtn" Tag="Links" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                        <TextBlock Text="Links" FontSize="8.5" />
                    </Button>
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterImagesBtn" Tag="Images" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                        <TextBlock Text="Images" FontSize="8.5" />
                    </Button>
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterColorsBtn" Tag="Colors" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0">
                        <TextBlock Text="Colors" FontSize="8.5" />
                    </Button>
                    <Button Click="ClipFilter_Click" x:Name="ClipFilterCodeBtn" Tag="Code" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0">
                        <TextBlock Text="Code" FontSize="8.5" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <Grid Grid.Row="2">
            <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel" MouseUp="ScrollViewer_MouseUp" x:Name="ClipboardScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="ClipboardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="128" Height="82" CornerRadius="10"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Cursor="Hand" ToolTip="Click to copy · Shift+Click to copy as Plain Text"
                                    MouseLeftButtonDown="ClipboardItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A1A22" />
                                                <Setter Property="BorderBrush" Value="#38FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="9,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0"
                                                Visibility="{Binding SwatchColor, Converter={StaticResource NullToVisibilityConverter}}"
                                                Background="{Binding SwatchColor, Converter={StaticResource ColorToBrushConverter}}" />
                                        <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource Digits}" FontSize="9.5" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Tag="{Binding Id}" Click="RemoveClipboardItem_Click" DockPanel.Dock="Right"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Remove">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#86868B" />
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="PinClipboardItem_Click" DockPanel.Dock="Right"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Pin / Unpin Snippet">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding PinGlyph}" FontSize="9" Foreground="{Binding PinForeground}" />
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="SendClipboardItemToShelf_Click" DockPanel.Dock="Right"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Save to Drop Shelf">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="9" Foreground="#86868B" />
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="EnqueueClipboardItem_Click" DockPanel.Dock="Right"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Add to Sequential Paste Queue">
                                            <TextBlock Text="+Q" FontSize="8" FontWeight="Bold" Foreground="#0A84FF" />
                                        </Button>
                                    </DockPanel>
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Border CornerRadius="5" ClipToBounds="True" MaxHeight="34"
                                                Visibility="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium"
                                                   Foreground="#F5F5F7" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <DockPanel Grid.Row="2" VerticalAlignment="Bottom" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Tag="{Binding RawText}" Click="OpenUrlClipboardItem_Click"
                                                Visibility="{Binding IsUrl, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource IslandButton}" Height="16" Padding="5,0" Margin="4,0,0,0" ToolTip="Open Link in Browser">
                                            <TextBlock Text="Open" FontSize="8" FontWeight="SemiBold" Foreground="#0A84FF" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Tag="{Binding RgbText}" Click="CopyColorAsRgb_Click"
                                                Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource IslandButton}" Height="16" Padding="5,0" Margin="4,0,0,0" ToolTip="Copy as rgb(r, g, b)">
                                            <TextBlock Text="RGB" FontSize="8" FontWeight="SemiBold" Foreground="#FF9F0A" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Tag="{Binding Id}" Click="OcrCardItem_Click"
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource IslandButton}" Height="16" Padding="5,0" Margin="4,0,0,0" ToolTip="Extract Text (OCR)">
                                            <TextBlock Text="OCR" FontSize="8" FontWeight="SemiBold" Foreground="#AF52DE" />
                                        </Button>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{StaticResource SecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="ClipboardEmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" CornerRadius="16" Padding="20,12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Clipboard is Empty" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Copied text, links, code, colors, and screenshots appear here" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,8" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Click="EyedropperButton_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,6,0" ToolTipService.ToolTip="Pick Screen Color (Eyedropper)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEF3C;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pick Color" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OcrClipboardButton_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" ToolTipService.ToolTip="Extract Text from Clipboard Image">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="OCR Image" FontSize="9.5" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
