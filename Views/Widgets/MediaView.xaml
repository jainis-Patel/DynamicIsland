<UserControl x:Class="DynamicIsland.Views.Widgets.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="156" d:DesignWidth="456">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Row 0: Adaptive Headers (Media Track / Big Clock / Voice Call) ───── -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid x:Name="ExpandedMediaHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border MouseLeftButtonDown="FocusMediaPlayer_Click" Cursor="Hand" Width="52" Height="52" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True" VerticalAlignment="Center" ToolTipService.ToolTip="Click to open active media player">
                    <Grid>
                        <TextBlock x:Name="ExpandedArtFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" />
                        <Image x:Name="ExpandedArtImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock MouseLeftButtonDown="FocusMediaPlayer_Click" Cursor="Hand" x:Name="ExpandedTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="Not Playing" ToolTipService.ToolTip="Click to open active media player" />
                    <TextBlock x:Name="ExpandedArtist" FontSize="12" Margin="0,1.5,0,0" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Text="System Audio" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border MouseLeftButtonDown="MediaSourceBadge_Click" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Cursor="Hand" ToolTipService.ToolTip="Click to switch active media player">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox x:Name="ExpandedSourceLogoBox" Width="9" Height="9" Margin="0,0,3.5,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Path x:Name="ExpandedSourceLogoPath" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
                                </Viewbox>
                                <TextBlock x:Name="ExpandedSourceApp" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" Text="Media" />
                            </StackPanel>
                        </Border>
                        <Border MouseLeftButtonDown="MediaLyricsBadge_Click" x:Name="MediaLyricsBadge" Margin="5,0,0,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Cursor="Hand" ToolTipService.ToolTip="Click to toggle or reload Synced Karaoke Lyrics (LRCLIB)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaLyricsIcon" Style="{StaticResource Glyph}" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" Text="&#xEC4F;" />
                                <TextBlock x:Name="MediaLyricsBadgeText" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" Text="Lyrics" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MediaVisualizerBadge" Visibility="Collapsed">
                            <TextBlock x:Name="MediaVisualizerBadgeText" />
                        </Border>
                        <TextBlock x:Name="CpuText" Visibility="Collapsed" />
                        <TextBlock x:Name="RamText" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" MouseLeftButtonDown="ToggleClockMediaHeader_Click" Background="Transparent" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="4,2" ToolTipService.ToolTip="Click to open Stopwatch &amp; Pomodoro Timer">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="ExpandedMiniClock" Style="{StaticResource Digits}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" Text="12:00" />
                        <TextBlock x:Name="ExpandedDate" FontSize="10.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" Margin="0,1,0,0" Text="Mon, Jan 1" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ExpandedClockHeader" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock MouseLeftButtonDown="ToggleClockMediaHeader_Click" Cursor="Hand" ToolTipService.ToolTip="Click to switch between Clock &amp; Now Playing" x:Name="ExpandedBigClock" Style="{StaticResource Digits}" FontSize="26" FontWeight="Light" Foreground="{DynamicResource PrimaryTextBrush}" Text="12:00" />
                    <TextBlock x:Name="ExpandedBigDate" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,4" Text="Monday, January 1" />
                    <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border MouseLeftButtonDown="ClockSystemHudBadge_Click" Cursor="Hand" Margin="0,0,3.5,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="Click to open System Vitals &amp; Performance HUD">
                                <TextBlock x:Name="ClockCpuText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Text="CPU 0%" />
                            </Border>
                            <Border MouseLeftButtonDown="ClockSystemHudBadge_Click" Cursor="Hand" Margin="0,0,3.5,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="Click to open System Vitals &amp; Performance HUD">
                                <TextBlock x:Name="ClockRamText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Text="RAM 0%" />
                            </Border>
                            <Border MouseLeftButtonDown="ClockWifiBadge_Click" x:Name="ClockWifiBadge" Margin="0,0,3.5,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Cursor="Hand" ToolTipService.ToolTip="Click to open Wi-Fi &amp; Network Hub">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockWifiGlyph" Style="{StaticResource Glyph}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0" Text="&#xE701;" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="ClockWifiText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Text="Wi-Fi" />
                                </StackPanel>
                            </Border>
                            <Border MouseLeftButtonDown="ClockWifiBadge_Click" x:Name="ClockNetSpeedBadge" Margin="0,0,3.5,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Cursor="Hand" ToolTipService.ToolTip="Live Upload/Download Bandwidth · Click for Network Hub">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,2.5,0" Text="&#xE896;" Foreground="#30D158" />
                                    <TextBlock x:Name="ClockNetSpeedText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Text="0 KB/s" />
                                </StackPanel>
                            </Border>
                            <Border MouseLeftButtonDown="ClockWeatherBadge_Click" x:Name="ClockWeatherBadge" Margin="0,0,3.5,0" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Cursor="Hand" ToolTipService.ToolTip="Live Weather · Click for details">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockWeatherGlyph" Style="{StaticResource Glyph}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,3,0" Text="&#xE706;" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="ClockWeatherText" Style="{StaticResource Digits}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Text="24°C" />
                                </StackPanel>
                            </Border>
                            <Border MouseLeftButtonDown="ClockCalendarBadge_Click" x:Name="ClockCalendarBadge" Visibility="Collapsed" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Cursor="Hand" ToolTipService.ToolTip="Click to join upcoming meeting or open Calendar">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0" Text="&#xE787;" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="ClockCalendarText" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" MaxWidth="85" TextTrimming="CharacterEllipsis" Text="Meeting" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="ExpandedTimerModeLabel" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" Text="Stopwatch" />
                        <TextBlock x:Name="ExpandedTimer" Style="{StaticResource Digits}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,3" Text="00:00" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="StartPauseButton" AutomationProperties.Name="Start or Pause Timer" Style="{StaticResource IslandButton}" Height="22" Padding="7,0" Margin="0,0,3,0" ToolTipService.ToolTip="Start / Pause Stopwatch (Ctrl+Alt+A)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StartPauseGlyph" Style="{StaticResource Glyph}" FontSize="9" Text="&#xE768;" />
                                    <TextBlock x:Name="StartPauseLabel" Margin="3.5,0,0,0" FontSize="9.5" FontWeight="SemiBold" Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PomodoroButton" MouseRightButtonUp="PomodoroButton_RightClick" AutomationProperties.Name="Start Pomodoro Countdown" Style="{StaticResource IslandButton}" Height="22" Padding="6,0" Margin="0,0,3,0" ToolTipService.ToolTip="Click to start/pause countdown · Right-click to cycle duration (15m / 25m / 45m / 60m)">
                                <TextBlock x:Name="PomodoroButtonText" FontSize="9.5" FontWeight="SemiBold" Text="25m" />
                            </Button>
                            <Button x:Name="ResetButton" AutomationProperties.Name="Reset Timer" Style="{StaticResource CircleButton}" Width="22" Height="22" ToolTipService.ToolTip="Reset Stopwatch / Timer">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="9.5" Text="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ExpandedCallHeader" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border MouseLeftButtonDown="ExpandedCallTitle_Click" Cursor="Hand" Width="48" Height="48" CornerRadius="12" Background="#2030D158" BorderBrush="#4030D158" BorderThickness="1" VerticalAlignment="Center" ToolTipService.ToolTip="Click to focus active call window">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" FontSize="20" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock MouseLeftButtonDown="ExpandedCallTitle_Click" Cursor="Hand" x:Name="ExpandedCallTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="Active Call" ToolTipService.ToolTip="Click to focus active call window" />
                    <TextBlock x:Name="ExpandedCallStatus" FontSize="11.5" Margin="0,1,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="Voice / Video Call Session" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border MouseLeftButtonDown="ExpandedCallMicBadge_Click" Cursor="Hand" x:Name="ExpandedCallMicBadge" Background="#2230D158" BorderBrush="#5030D158" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="0,0,5,0" ToolTipService.ToolTip="Click to Mute / Unmute Microphone">
                            <TextBlock x:Name="ExpandedCallMicText" Text="Mic Active · Mute" FontSize="9" FontWeight="SemiBold" Foreground="#30D158" />
                        </Border>
                        <Border x:Name="ExpandedCallCamBadge" Background="#220A84FF" BorderBrush="#500A84FF" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Visibility="Collapsed">
                            <TextBlock Text="Camera Active" FontSize="9" FontWeight="SemiBold" Foreground="#0A84FF" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Duration" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ExpandedCallTimer" Style="{StaticResource Digits}" FontSize="17" FontWeight="SemiBold" Foreground="#30D158" HorizontalAlignment="Right" Text="00:00" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── Row 1: Synchronized Karaoke Lyrics (Apple Music Style Front & Center) ── -->
        <Grid Grid.Row="1" x:Name="KaraokeLyricsHost" Margin="4,2,4,2" VerticalAlignment="Center" HorizontalAlignment="Center"
              MouseLeftButtonDown="MediaLyricsBadge_Click" Cursor="Hand" ToolTipService.ToolTip="Click to toggle or reload lyrics">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LyricPrevLine" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}"
                           Opacity="0.45" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,1.5" />
                <TextBlock x:Name="LyricCurrentLine" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,1" Text="♪ Loading lyrics..." />
                <TextBlock x:Name="LyricNextLine" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}"
                           Opacity="0.45" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,1.5,0,0" />
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Media Scrubber & Transport Controls ──────────────────────── -->
        <Grid Grid.Row="2" x:Name="MediaTransportControlsGrid" Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Grid.Column="0" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="0:00" />
            <Slider x:Name="TimelineSlider" Grid.Column="1" Style="{StaticResource IslandSlider}" Margin="6,0" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0:00" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="PrevButton" AutomationProperties.Name="Previous Track" Style="{StaticResource CircleButton}" Width="26" Height="26" ToolTipService.ToolTip="Previous Track">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE892;" />
                </Button>
                <Button x:Name="PlayPauseButton" AutomationProperties.Name="Play or Pause Media" Style="{StaticResource CircleButton}" Margin="4,0" Width="28" Height="28" Background="{DynamicResource MediaPlayButtonBgBrush}" Foreground="{DynamicResource MediaPlayButtonFgBrush}" ToolTipService.ToolTip="Play / Pause (Ctrl+Alt+Space)">
                    <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" FontSize="11.5" Text="&#xE768;" />
                </Button>
                <Button x:Name="NextButton" AutomationProperties.Name="Next Track" Style="{StaticResource CircleButton}" Width="26" Height="26" ToolTipService.ToolTip="Next Track">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE893;" />
                </Button>
                <Button x:Name="DetachPlayerButton" AutomationProperties.Name="Detach Mini Player" Style="{StaticResource CircleButton}" Width="26" Height="26" Margin="4,0,0,0" ToolTipService.ToolTip="Detach Floating Mini Player" Click="DetachPlayer_Click">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="9.5" Text="&#xE8A7;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>