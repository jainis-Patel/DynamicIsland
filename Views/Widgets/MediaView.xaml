<UserControl x:Class="DynamicIsland.Views.Widgets.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="168" d:DesignWidth="456">
    <UserControl.Resources>
        <!-- Apple Dynamic Island Borderless Ghost Icon Button -->
        <Style x:Key="AppleTransportIconBtn" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Secondary Utility Pill (Lyrics / Output / Status) -->
        <Style x:Key="AppleSubtlePill" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF" />
                    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quiet Inline Status Token for Idle Clock Ribbon -->
        <Style x:Key="AppleInlineStatusToken" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 0: Adaptive Top Stage (Now Playing / StandBy Clock / Call)     -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" VerticalAlignment="Top">

            <!-- 1. APPLE DYNAMIC ISLAND NOW PLAYING HEADER -->
            <Grid x:Name="ExpandedMediaHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 52x52 Platter / Squircle Artwork (58x54 non-clipping stage for micro-tonearm) -->
                <core:PlayerDiscControl x:Name="ExpandedArtDisc"
                                        DiscSize="52"
                                        ShowTonearm="True"
                                        SquircleRadius="18"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="FocusMediaPlayer_Click"
                                        MouseRightButtonUp="CycleAlbumArtStyle_Click"
                                        ToolTipService.ToolTip="Click to open active media player · Right-click to switch disc style" />

                <!-- Editorial Track Title, Artist & Subtle Player Attribution -->
                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ExpandedTitle"
                               MouseLeftButtonDown="FocusMediaPlayer_Click"
                               Cursor="Hand"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="Not Playing"
                               ToolTipService.ToolTip="Click to open active media player" />

                    <TextBlock x:Name="ExpandedArtist"
                               FontSize="12.5"
                               Margin="0,1.5,0,0"
                               Foreground="{DynamicResource SecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="System Audio" />

                    <!-- Quiet Source Attribution Line -->
                    <StackPanel Orientation="Horizontal" Margin="0,3.5,0,0" VerticalAlignment="Center">
                        <Border MouseLeftButtonDown="MediaSourceBadge_Click"
                                Background="Transparent"
                                Padding="0,1,6,1"
                                Cursor="Hand"
                                ToolTipService.ToolTip="Click to switch active media player">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox x:Name="ExpandedSourceLogoBox" Width="9.5" Height="9.5" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Path x:Name="ExpandedSourceLogoPath" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
                                </Viewbox>
                                <TextBlock x:Name="ExpandedSourceApp"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           Opacity="0.85"
                                           Text="Media" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MediaVisualizerBadge" Visibility="Collapsed">
                            <TextBlock x:Name="MediaVisualizerBadgeText" />
                        </Border>
                        <TextBlock x:Name="CpuText" Visibility="Collapsed" />
                        <TextBlock x:Name="RamText" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- Minimalist Right Timepiece (Click to flip to StandBy Clock / Timer) -->
                <Border x:Name="MediaMiniClockCard"
                        Grid.Column="2"
                        MouseLeftButtonDown="ToggleClockMediaHeader_Click"
                        Style="{StaticResource AppleInlineStatusToken}"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Click to switch to StandBy Clock &amp; Timer">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="MiniClockTimerActiveDot" Width="5" Height="5" Fill="#FF9F0A" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="ExpandedMiniClock"
                                       Style="{StaticResource Digits}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       Text="12:00" />
                        </StackPanel>
                        <TextBlock x:Name="ExpandedDate"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,1,0,0"
                                   Text="Mon, Jan 1" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. APPLE STANDBY / ALCOVE IDLE CLOCK & TIMER VIEW -->
            <Grid x:Name="ExpandedClockHeader" Visibility="Collapsed" Margin="2,2,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Clean Horological Timepiece + Quiet Monochrome Status Line -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedBigClock"
                                   MouseLeftButtonDown="ToggleClockMediaHeader_Click"
                                   Cursor="Hand"
                                   Style="{StaticResource Digits}"
                                   Typography.NumeralAlignment="Tabular"
                                   FontSize="30"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,-3,10,0"
                                   Text="12:00"
                                   ToolTipService.ToolTip="Click to switch between StandBy Clock &amp; Now Playing" />

                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,1">
                            <TextBlock x:Name="ExpandedBigDate"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Opacity="0.9"
                                       Text="Monday, January 1" />

                            <!-- Subtle Weather & Next Event Inline Sub-line -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1.5,0,0">
                                <Border x:Name="ClockWeatherBadge"
                                        MouseLeftButtonDown="ClockWeatherBadge_Click"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"
                                        ToolTipService.ToolTip="Live Weather · Click to refresh">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ClockWeatherGlyph" Style="{StaticResource Glyph}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,3.5,0" Text="&#xE706;" Foreground="{DynamicResource SecondaryBrush}" />
                                        <TextBlock x:Name="ClockWeatherText" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Text="24°C" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ClockCalendarBadge"
                                        MouseLeftButtonDown="ClockCalendarBadge_Click"
                                        Visibility="Collapsed"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        ToolTipService.ToolTip="Click to join upcoming meeting or open Calendar">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3.5,0" Text="&#xE787;" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock x:Name="ClockCalendarText" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" Text="Meeting" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quiet Monochrome Telemetry Ribbon (Zero borders, zero rainbow boxes) -->
                    <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  HorizontalAlignment="Left"
                                  Margin="-4,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border MouseLeftButtonDown="ClockSystemHudBadge_Click" Style="{StaticResource AppleInlineStatusToken}" ToolTipService.ToolTip="Open System Vitals HUD">
                                <TextBlock x:Name="ClockCpuText" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Text="CPU 0%" />
                            </Border>

                            <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.45" VerticalAlignment="Center" Margin="1,0" />

                            <Border MouseLeftButtonDown="ClockSystemHudBadge_Click" Style="{StaticResource AppleInlineStatusToken}" ToolTipService.ToolTip="Open System Vitals HUD">
                                <TextBlock x:Name="ClockRamText" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Text="RAM 0%" />
                            </Border>

                            <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.45" VerticalAlignment="Center" Margin="1,0" />

                            <Border x:Name="ClockWifiBadge" MouseLeftButtonDown="ClockWifiBadge_Click" Style="{StaticResource AppleInlineStatusToken}" ToolTipService.ToolTip="Open Wi-Fi &amp; Network">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockWifiGlyph" Style="{StaticResource Glyph}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3.5,0" Text="&#xE701;" Foreground="{DynamicResource SecondaryBrush}" />
                                    <TextBlock x:Name="ClockWifiText" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Text="Wi-Fi" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.45" VerticalAlignment="Center" Margin="1,0" />

                            <Border x:Name="ClockNetSpeedBadge" MouseLeftButtonDown="ClockWifiBadge_Click" Style="{StaticResource AppleInlineStatusToken}" ToolTipService.ToolTip="Live Network Throughput">
                                <TextBlock x:Name="ClockNetSpeedText" Style="{StaticResource Digits}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Text="0 KB/s" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- Right: Sleek Minimalist Focus / Timer Pod -->
                <Border x:Name="FocusStopwatchCard"
                        Grid.Column="1"
                        Background="#0FFFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="11,7"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandedTimerModeLabel"
                                       FontSize="9.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Margin="0,0,6,0"
                                       Text="Stopwatch" />
                            <TextBlock x:Name="ExpandedTimer"
                                       Style="{StaticResource Digits}"
                                       Typography.NumeralAlignment="Tabular"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="00:00" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="StartPauseButton"
                                    AutomationProperties.Name="Start or Pause Timer"
                                    Style="{StaticResource IslandButton}"
                                    Height="22" Padding="8,0" Margin="0,0,3.5,0"
                                    ToolTipService.ToolTip="Start / Pause Stopwatch (Ctrl+Alt+A)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartPauseGlyph" Style="{StaticResource Glyph}" FontSize="8.5" Text="&#xE768;" />
                                    <TextBlock x:Name="StartPauseLabel" Margin="4,0,0,0" FontSize="9.5" FontWeight="medium" Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PomodoroButton"
                                    MouseRightButtonUp="PomodoroButton_RightClick"
                                    AutomationProperties.Name="Start Pomodoro Countdown"
                                    Style="{StaticResource IslandButton}"
                                    Height="22" Padding="7,0" Margin="0,0,3.5,0"
                                    ToolTipService.ToolTip="Click to start/pause countdown · Right-click to cycle duration (15m / 25m / 45m / 60m)">
                                <TextBlock x:Name="PomodoroButtonText" FontSize="9.5" FontWeight="Medium" Text="25m" />
                            </Button>
                            <Button x:Name="ResetButton"
                                    AutomationProperties.Name="Reset Timer"
                                    Style="{StaticResource CircleButton}"
                                    Width="22" Height="22"
                                    ToolTipService.ToolTip="Reset Stopwatch / Timer">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. APPLE VOICE / VIDEO CALL BANNER -->
            <Grid x:Name="ExpandedCallHeader" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border MouseLeftButtonDown="ExpandedCallTitle_Click" Cursor="Hand" Width="48" Height="48" CornerRadius="13" Background="#2030D158" BorderBrush="#4030D158" BorderThickness="1" VerticalAlignment="Center" ToolTipService.ToolTip="Click to focus active call window">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" FontSize="20" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock MouseLeftButtonDown="ExpandedCallTitle_Click" Cursor="Hand" x:Name="ExpandedCallTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="Active Call" ToolTipService.ToolTip="Click to focus active call window" />
                    <TextBlock x:Name="ExpandedCallStatus" FontSize="11.5" Margin="0,1,0,0" Foreground="{DynamicResource SecondaryBrush}" Text="Voice / Video Call Session" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border MouseLeftButtonDown="ExpandedCallMicBadge_Click" Cursor="Hand" x:Name="ExpandedCallMicBadge" Background="#2230D158" BorderBrush="#5030D158" BorderThickness="1" CornerRadius="6" Padding="7,1.5" Margin="0,0,5,0" ToolTipService.ToolTip="Click to Mute / Unmute Microphone">
                            <TextBlock x:Name="ExpandedCallMicText" Text="Mic Active · Mute" FontSize="9.5" FontWeight="SemiBold" Foreground="#30D158" />
                        </Border>
                        <Border x:Name="ExpandedCallCamBadge" Background="#220A84FF" BorderBrush="#500A84FF" BorderThickness="1" CornerRadius="6" Padding="7,1.5" Visibility="Collapsed">
                            <TextBlock Text="Camera Active" FontSize="9.5" FontWeight="SemiBold" Foreground="#0A84FF" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Duration" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ExpandedCallTimer" Style="{StaticResource Digits}" Typography.NumeralAlignment="Tabular" FontSize="17" FontWeight="SemiBold" Foreground="#30D158" HorizontalAlignment="Right" Text="00:00" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 1: Synchronized Karaoke Lyrics Stage (Collapses cleanly when off) -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              x:Name="KaraokeLyricsHost"
              Margin="6,4,6,2"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Visibility="Collapsed"
              MouseLeftButtonDown="MediaLyricsBadge_Click"
              Cursor="Hand"
              ToolTipService.ToolTip="Click to toggle or reload lyrics">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LyricPrevLine" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}"
                           Opacity="0.42" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,1.5" />
                <TextBlock x:Name="LyricCurrentLine" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,1" Text="♪ Loading lyrics..." />
                <TextBlock x:Name="LyricNextLine" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}"
                           Opacity="0.42" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,1.5,0,0" />
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: Authentic Apple Dynamic Island Scrubber & Centered Transport -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" x:Name="MediaTransportControlsGrid" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Line 1: Full-Width Timeline Scrubber (0:42 ━━━━━━━●──────── 3:18) -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText"
                           Grid.Column="0"
                           Style="{StaticResource Digits}"
                           Typography.NumeralAlignment="Tabular"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="0:00" />
                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Style="{StaticResource IslandSlider}"
                        Margin="6,0"
                        Minimum="0"
                        Maximum="100"
                        Value="0" />
                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Style="{StaticResource Digits}"
                           Typography.NumeralAlignment="Tabular"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="0:00" />
            </Grid>

            <!-- Line 2: Symmetric Apple Transport Bar (Lyrics Left | Prev · Play · Next Center | Output & PiP Right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Utility: Subtle Synced Lyrics Toggle Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="MediaLyricsBadge"
                            MouseLeftButtonDown="MediaLyricsBadge_Click"
                            Style="{StaticResource AppleSubtlePill}"
                            ToolTipService.ToolTip="Toggle Synced Karaoke Lyrics (LRCLIB)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaLyricsIcon"
                                       Style="{StaticResource Glyph}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Text="&#xEC4F;" />
                            <TextBlock x:Name="MediaLyricsBadgeText"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="Lyrics" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Iconic Apple Transport Triad (Prev / Play-Pause / Next) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="PrevButton"
                            AutomationProperties.Name="Previous Track"
                            Style="{StaticResource AppleTransportIconBtn}"
                            Width="32" Height="32"
                            ToolTipService.ToolTip="Previous Track">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE892;" />
                    </Button>

                    <Button x:Name="PlayPauseButton"
                            AutomationProperties.Name="Play or Pause Media"
                            Style="{StaticResource AppleTransportIconBtn}"
                            Margin="10,0"
                            Width="34" Height="34"
                            ToolTipService.ToolTip="Play / Pause (Ctrl+Alt+Space)">
                        <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" FontSize="16" Text="&#xE768;" />
                    </Button>

                    <Button x:Name="NextButton"
                            AutomationProperties.Name="Next Track"
                            Style="{StaticResource AppleTransportIconBtn}"
                            Width="32" Height="32"
                            ToolTipService.ToolTip="Next Track">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Text="&#xE893;" />
                    </Button>
                </StackPanel>

                <!-- Right Utility: AirPlay / Audio Output & Floating Mini Player -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AudioOutputQuickBtn"
                            Click="AudioOutputQuickBtn_Click"
                            Style="{StaticResource AppleTransportIconBtn}"
                            Width="28" Height="28"
                            Margin="0,0,2,0"
                            ToolTipService.ToolTip="Audio Output &amp; Volume Mixer">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="11.5" Foreground="{DynamicResource SecondaryBrush}" Text="&#xE7F5;" />
                    </Button>

                    <Button x:Name="DetachPlayerButton"
                            AutomationProperties.Name="Detach Mini Player"
                            Style="{StaticResource AppleTransportIconBtn}"
                            Width="28" Height="28"
                            ToolTipService.ToolTip="Detach Floating Mini Player"
                            Click="DetachPlayer_Click">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="10.5" Foreground="{DynamicResource SecondaryBrush}" Text="&#xE8A7;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
