<UserControl x:Class="DynamicIsland.Views.Widgets.CalendarTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="230" d:DesignWidth="464">
    <Grid Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar (Matching Apple Notch Reference: Day + Date + Week | Add + Open + Month) -->
        <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="False">
            <!-- Left: Weekday + Day + Week Number -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderDayOfWeek" Text="TUE" FontSize="11.5" FontWeight="Bold" Foreground="#FF453A" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderDayNumber" Text="13" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderWeekNumber" Text="W42" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Action Pills (Camera) (+) (↗) [OCT/NOV] -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pre-Call Webcam Mirror Button -->
                <Button x:Name="OpenMirrorBtn" Click="OpenMirrorBtn_Click" Style="{StaticResource IslandButton}"
                        Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTipService.ToolTip="Pre-Call Webcam Mirror &amp; Mic Check">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Add Task Button -->
                <Button x:Name="QuickAddToggleBtn" Click="QuickAddToggleBtn_Click" Style="{StaticResource IslandButton}"
                        Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTipService.ToolTip="Add a task or plan...">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Open Windows Calendar App Button -->
                <Button x:Name="OpenCalendarAppBtn" Click="OpenCalendarAppBtn_Click" Style="{StaticResource IslandButton}"
                        Width="24" Height="24" Padding="0" Margin="0,0,6,0" ToolTipService.ToolTip="Open Windows Calendar &amp; Outlook">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Current Month Badge -->
                <Border Background="#25FF453A" BorderBrush="#55FF453A" BorderThickness="1" CornerRadius="7" Padding="7,1.5" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderMonthBadge" Text="NOV" FontSize="10.5" FontWeight="Bold" Foreground="#FF453A" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Main Body: Split 2-Column Dashboard (Left: Schedule & Tasks | Right: Apple Month Grid) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Schedule & Tasks Timeline -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Scrollable Schedule Cards List -->
                <ScrollViewer x:Name="TasksScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                              PreviewMouseWheel="TasksScrollViewer_PreviewMouseWheel">
                    <StackPanel x:Name="ScheduleCardsPanel">
                        <!-- Populated dynamically in code-behind with Apple fluid glass cards -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Floating Glass Task Input Pill (Matching "Add a task..." in Reference) -->
                <Border x:Name="QuickTaskPillHost" Grid.Row="1" Margin="0,6,0,0" Height="28" CornerRadius="14"
                        Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1">
                    <DockPanel LastChildFill="True" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="11" Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right" Click="SubmitTask_Click" Style="{StaticResource IslandButton}"
                                Width="20" Height="20" Padding="0" Margin="4,0,0,0" ToolTipService.ToolTip="Save task">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="9" Foreground="#0B0B0E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="QuickTaskInput" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10.5"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"
                                     KeyDown="QuickTaskInput_KeyDown" TextChanged="QuickTaskInput_TextChanged" />
                            <TextBlock x:Name="QuickTaskPlaceholder" Text="Add task (e.g. 'Gym at 6pm')..." FontSize="10"
                                       Foreground="{DynamicResource SecondaryBrush}" Opacity="0.65"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right Column: Interactive Apple Month Calendar Grid -->
            <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Month Navigation Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
                        <TextBlock x:Name="CalendarMonthTitle" Text="November 2026" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="PrevMonth_Click" Style="{StaticResource IslandButton}" Width="18" Height="18" Padding="0" Margin="0,0,2,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                            </Button>
                            <Button Click="NextMonth_Click" Style="{StaticResource IslandButton}" Width="18" Height="18" Padding="0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Days of Week Row (S M T W T F S) -->
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="S" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="M" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="T" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="W" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="T" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="F" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="S" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
                    </UniformGrid>

                    <!-- Days Number Matrix (7 columns, 6 rows with Apple red circular badge for today) -->
                    <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="2" Columns="7" Rows="6">
                        <!-- Populated dynamically in code-behind with Apple circular day badges -->
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>