<UserControl x:Class="DynamicIsland.Views.Widgets.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="464">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock x:Name="AudioSectionTitle" Style="{StaticResource SectionTitle}" Text="Audio Output" />
            <Button Click="AudioModeToggleBtn_Click" x:Name="AudioModeToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Switch between Output Devices and Per-App Volume Mixer">
                <TextBlock x:Name="AudioModeToggleText" Text="App Mixer" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Button>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel" x:Name="AudioEndpointsScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="AudioEndpointsControl">


                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="154" Height="82" Margin="0,0,8,0" CornerRadius="10"
                                                            BorderThickness="1" Padding="10,7" Cursor="Hand" MouseLeftButtonDown="AudioEndpointCard_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#38FFFFFF" />
                                                                        <Setter Property="Background" Value="#1A1A22" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#4830D158" />
                                                                        <Setter Property="Background" Value="#142219" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                                <Button Tag="{Binding Id}" Click="EndpointMuteBtn_Click" Style="{StaticResource CircleButton}" Width="22" Height="22" VerticalAlignment="Center" ToolTip="Mute / Unmute Output Device">
                                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding DisplayGlyph}" FontSize="11" Foreground="#F5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Button>

                                                                <Border DockPanel.Dock="Right" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#2430D158" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                                    <TextBlock Text="Active" FontSize="9" FontWeight="SemiBold" Foreground="#30D158" />
                                                                </Border>

                                                                <Border DockPanel.Dock="Right" Visibility="{Binding BatteryPercent, Converter={StaticResource NullToVisibilityConverter}}"
                                                                        Background="#18FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Style="{StaticResource Digits}" FontSize="9" Foreground="{StaticResource SecondaryBrush}" />
                                                                </Border>
                                                            </DockPanel>

                                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#F5F5F7"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DeviceType}" FontSize="9.5" Foreground="{StaticResource SecondaryBrush}" />
                                                            </StackPanel>

                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1"
                                                                        Value="{Binding Volume, Mode=OneWay}"
                                                                        Tag="{Binding Id}"
                                                                        ValueChanged="EndpointSlider_ValueChanged"
                                                                        VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Digits}" FontSize="9.5"
                                                                           Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"
                                                                           Text="{Binding Volume, Converter={StaticResource VolumePercentConverter}}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel" x:Name="AudioAppMixerScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="AudioAppSessionsControl">


                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="146" Height="82" Margin="0,0,8,0" CornerRadius="10"
                                                            Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                                            BorderThickness="1" Padding="10,7">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                                <Border Width="22" Height="22" CornerRadius="11" Background="#1AFFFFFF" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Button DockPanel.Dock="Right" Tag="{Binding ProcessId}" Click="AppSessionMuteBtn_Click"
                                                                        Style="{StaticResource CircleButton}" Width="20" Height="20" ToolTip="Mute / Unmute App">
                                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}" FontSize="9.5" Foreground="#F5F5F7" />
                                                                </Button>
                                                            </DockPanel>

                                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AppName}" FontSize="11" FontWeight="Medium" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{StaticResource SecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1"
                                                                        Value="{Binding Volume, Mode=OneWay}"
                                                                        Tag="{Binding ProcessId}"
                                                                        ValueChanged="AppSessionSlider_ValueChanged"
                                                                        VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Digits}" FontSize="9.5"
                                                                           Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"
                                                                           Text="{Binding Volume, Converter={StaticResource VolumePercentConverter}}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="AudioAppMixerEmptyPlaceholder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                    <TextBlock Text="No Active App Audio" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Apps playing sound will appear here for individual volume control" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
