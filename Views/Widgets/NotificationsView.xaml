<UserControl x:Class="DynamicIsland.Views.Widgets.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="464"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="CardMicroActionBtn" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1.5,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardPillActionBtn" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#34FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="False" Margin="0,0,6,0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications" VerticalAlignment="Center" />
                <Border x:Name="NotificationsCountBadge"
                        Background="{DynamicResource ChipBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="6,1.5"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationsCountText"
                               Style="{StaticResource Digits}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="0 new" />
                </Border>
                <Button Click="UnmuteAllAppsButton_Click"
                        x:Name="UnmuteAllAppsButton"
                        Visibility="Collapsed"
                        Style="{StaticResource IslandButton}"
                        Height="20"
                        Padding="6,0"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Click to unmute all muted notification apps">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UnmuteAllAppsText" Text="1 Muted · Unmute" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NotificationsDndButton"
                        Click="NotificationsDndButton_Click"
                        Style="{StaticResource IslandButton}"
                        Height="22"
                        Padding="7,0"
                        Margin="0,0,4,0"
                        ToolTipService.ToolTip="Toggle Do Not Disturb">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationsDndGlyph" Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NotificationsDndText" Text="DND" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ToggleGroupingButton"
                        Click="ToggleGroupingButton_Click"
                        Style="{StaticResource IslandButton}"
                        Height="22"
                        Padding="7,0"
                        Margin="0,0,4,0"
                        ToolTipService.ToolTip="Toggle between Stacked App Groups and Flat Timeline">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" x:Name="ToggleGroupingGlyph" Text="&#xE8B9;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToggleGroupingText" Text="Grouped" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="ClearNotificationsButton_Click"
                        x:Name="ClearNotificationsButton"
                        Style="{StaticResource IslandButton}"
                        Height="22"
                        Padding="8,0"
                        Margin="0"
                        ToolTipService.ToolTip="Clear All Notifications (Shift+Click to bypass confirm)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Clear All" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Compact Filter & Search Bar -->
        <DockPanel x:Name="NotificationsFilterBar" Grid.Row="1" Margin="0,0,0,8" LastChildFill="True" Visibility="Collapsed">
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource ChipBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="22"
                    Width="156"
                    Padding="7,0"
                    Margin="8,0,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Opacity="0.8" />

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="NotificationsSearchBox"
                                 TextChanged="NotificationsSearchBox_TextChanged"
                                 KeyDown="NotificationsSearchBox_KeyDown"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderThickness="0"
                                 FontSize="9.5"
                                 VerticalAlignment="Center"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 ToolTipService.ToolTip="Filter notifications by app, title, or message" />

                        <TextBlock Text="Filter alerts..."
                                   FontSize="9.5"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NotificationsSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="2"
                            x:Name="ClearNotificationsSearchBtn"
                            Click="ClearNotificationsSearch_Click"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="2"
                            Margin="2,0,0,0"
                            ToolTipService.ToolTip="Clear Search">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border Background="{DynamicResource ChipBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NotifFilter_Click" x:Name="NotifFilterAllBtn" Tag="All" Style="{StaticResource IslandButton}" Height="18" Padding="9,0" Margin="0,0,2,0">
                        <TextBlock Text="All" FontSize="9" FontWeight="SemiBold" />
                    </Button>
                    <Button Click="NotifFilter_Click" x:Name="NotifFilterMessagesBtn" Tag="Messages" Style="{StaticResource IslandButton}" Height="18" Padding="9,0" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" FontSize="8" Margin="0,0,3.5,0" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock Text="Messages" FontSize="9" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ROW 2: Notification Feed & Smart Empty State -->
        <Grid Grid.Row="2">
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                          x:Name="NotificationsScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="NotificationsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <!-- Behind-card Swipe Dismiss Backdrop -->
                                <Border x:Name="SwipeBackdrop"
                                        Margin="0,0,0,3"
                                        CornerRadius="10"
                                        Opacity="0"
                                        Background="#33FF453A"
                                        BorderBrush="#66FF453A"
                                        BorderThickness="1"
                                        Padding="14,0"
                                        IsHitTestVisible="False">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="11" Foreground="#FFFF6961" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Dismiss" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFF6961" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Dismiss" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFF6961" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="11" Foreground="#FFFF6961" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Collapsed Stack Deck Lip -->
                                <Border Visibility="{Binding CollapsedStackDeckVisibility}"
                                        Height="5"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="0,0,12,12"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        Opacity="0.55"
                                        IsHitTestVisible="False" />

                                <!-- Main Notification Card (Apple 2-Column Editorial Layout, zero side stripe) -->
                                <Border x:Name="NotificationCardRoot"
                                        Margin="0,0,0,3"
                                        MinHeight="60"
                                        CornerRadius="14"
                                        BorderThickness="1"
                                        Padding="11,9"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        ToolTip="Click to open or copy · Swipe horizontally to dismiss"
                                        MouseLeftButtonDown="NotificationCard_Click"
                                        PreviewMouseLeftButtonDown="NotificationCard_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="NotificationCard_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="NotificationCard_PreviewMouseLeftButtonUp">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="#34FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: 34x34 App Icon Squircle + Optional Stack Count Pip -->
                                        <Grid Grid.Column="0" Width="34" Height="34" Margin="0,1,11,0" VerticalAlignment="Top" ClipToBounds="False">
                                            <Border Width="34" Height="34" CornerRadius="9.5"
                                                    Background="{Binding IconBgBrush}"
                                                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15"
                                                           Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Visibility="{Binding MultipleBadgeVisibility}"
                                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    MinWidth="14" Height="14" Padding="3.5,0"
                                                    Margin="0,-4,-4,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding CountBadgeText}" Style="{StaticResource Digits}"
                                                           FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Right: Title, Timestamp + Hover Actions, Body & Contextual Strip -->
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header: Title Left | Timestamp & Hover-Only Micro Actions Right -->
                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding LatestTimeText}" Style="{StaticResource Digits}" FontSize="8.5"
                                                               Foreground="{DynamicResource SecondaryBrush}" Opacity="0.85" VerticalAlignment="Center" />

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=NotificationCardRoot}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Tag="{Binding LatestItem}" Click="CopyNotificationItem_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Copy Notification Text">
                                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                                        </Button>
                                                        <Button Tag="{Binding AppName}" Click="MuteAppNotification_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Mute Notifications from this App">
                                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74F;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                                        </Button>
                                                        <Button Tag="{Binding}" Click="RemoveNotificationItem_Click" Style="{StaticResource CardMicroActionBtn}" ToolTip="Dismiss Notification">
                                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Text="{Binding LatestTitle}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <!-- Body (collapsed when empty or identical to Title) -->
                                            <TextBlock Grid.Row="1"
                                                       Visibility="{Binding LatestBodyVisibility}"
                                                       Text="{Binding LatestBody}"
                                                       FontSize="10"
                                                       LineHeight="13.5"
                                                       Foreground="{DynamicResource SecondaryBrush}"
                                                       Margin="0,2,0,0"
                                                       MaxHeight="28"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Footer: Quiet App Attribution + Contextual Action Pills -->
                                            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,5,0,0">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding AppName}" FontSize="8.5" FontWeight="Medium"
                                                               Foreground="{DynamicResource SecondaryBrush}" Opacity="0.72"
                                                               VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,8,0" />

                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding BottomActionsVisibility}" VerticalAlignment="Center">
                                                        <Button Tag="{Binding LatestItem}"
                                                                Visibility="{Binding ReplyVisibility}"
                                                                Click="ReplyNotificationItem_Click"
                                                                Style="{StaticResource CardPillActionBtn}"
                                                                ToolTip="Quick Reply to this message">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE725;" FontSize="8.5" Foreground="{Binding AccentBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Reply" FontSize="8.5" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Tag="{Binding LatestOtpCode}"
                                                                Visibility="{Binding OtpVisibility}"
                                                                Click="CopyOtpCode_Click"
                                                                Style="{StaticResource CardPillActionBtn}"
                                                                ToolTip="Copy detected verification code">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8.5" Foreground="{Binding AccentBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding OtpButtonText}" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Tag="{Binding}"
                                                                Visibility="{Binding MultipleBadgeVisibility}"
                                                                Click="ToggleGroupExpand_Click"
                                                                Style="{StaticResource CardPillActionBtn}"
                                                                ToolTip="Expand or collapse stacked notifications">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding ExpandGlyph}" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ExpandLabel}" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <ItemsControl Visibility="{Binding DetailsVisibility}"
                                                              ItemsSource="{Binding SecondaryNotifications}"
                                                              Margin="0,7,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="SubCardRoot"
                                                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="9,6"
                                                                    Margin="0,0,0,4"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="SubNotificationCard_Click"
                                                                    ToolTip="Click to open or copy notification">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Digits}" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.85" VerticalAlignment="Center" />
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SubCardRoot}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <Button Tag="{Binding}" Click="CopyNotificationItem_Click" Style="{StaticResource CardMicroActionBtn}" Width="18" Height="18" ToolTip="Copy Notification">
                                                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                                                                </Button>
                                                                                <Button Tag="{Binding Id}" Click="RemoveNotificationItem_Click" Style="{StaticResource CardMicroActionBtn}" Width="18" Height="18" ToolTip="Dismiss this alert">
                                                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </StackPanel>

                                                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                    <TextBlock Grid.Row="1" Visibility="{Binding BodyVisibility}" Text="{Binding Body}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,0" MaxHeight="24" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <Button Tag="{Binding}" Visibility="{Binding ReplyVisibility}" Click="ReplyNotificationItem_Click" Style="{StaticResource CardPillActionBtn}" Height="18" Padding="5,0" ToolTip="Quick Reply">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE725;" FontSize="8" Foreground="{Binding AccentBrush}" Margin="0,0,2.5,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Reply" FontSize="8" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Tag="{Binding DetectedOtpCode}" Visibility="{Binding OtpVisibility}" Click="CopyOtpCode_Click" Style="{StaticResource CardPillActionBtn}" Height="18" Padding="5,0" ToolTip="Copy verification code">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="8" Foreground="{Binding AccentBrush}" Margin="0,0,2.5,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding OtpButtonText}" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Smart Empty State -->
            <StackPanel x:Name="NotificationsEmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">
                <Border Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="{DynamicResource ChipBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">
                    <TextBlock x:Name="NotificationsEmptyGlyph" Style="{StaticResource Glyph}" Text="&#xE7E7;" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="NotificationsEmptyTitle" Text="All Caught Up" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="NotificationsEmptySubtitle" Text="New alerts and Windows notifications will appear here" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                <Button x:Name="NotificationsEmptyActionBtn"
                        Click="NotificationsEmptyActionBtn_Click"
                        Visibility="Collapsed"
                        Style="{StaticResource IslandButton}"
                        Height="24"
                        Padding="11,0"
                        Margin="0,9,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="NotificationsEmptyActionText" Text="Action" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
