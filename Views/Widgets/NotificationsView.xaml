<UserControl x:Class="DynamicIsland.Views.Widgets.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="464">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,7" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications" VerticalAlignment="Center" />
                <Border x:Name="NotificationsCountBadge" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationsCountText" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="0 items" />
                </Border>
                <Border x:Name="NotificationsDndBadge" Visibility="Collapsed" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74F;" FontSize="8.5" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="DND On" FontSize="9" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Click="UnmuteAllAppsButton_Click" x:Name="UnmuteAllAppsButton" Visibility="Collapsed" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="Click to unmute all muted notification apps">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3.5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UnmuteAllAppsText" Text="1 Muted · Unmute" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Click="ClearNotificationsButton_Click" x:Name="ClearNotificationsButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0" ToolTipService.ToolTip="Clear All Notifications">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Clear All" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel" x:Name="NotificationsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <ItemsControl x:Name="NotificationsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="62" Margin="0,0,0,6" CornerRadius="10"
                                    BorderThickness="1" Padding="10,7" Cursor="Hand"
                                    ToolTip="Click to open or copy notification"
                                    MouseLeftButtonDown="NotificationCard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A1A22" />
                                                <Setter Property="BorderBrush" Value="#38FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding IconBgBrush}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="9.5" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding AppName}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />

                                        <Button Tag="{Binding Id}" Click="RemoveNotificationItem_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Dismiss Notification">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#86868B" />
                                        </Button>
                                        <Button Tag="{Binding AppName}" Click="MuteAppNotification_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0" ToolTip="Mute Notifications from this App">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74F;" FontSize="9" Foreground="#86868B" />
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Digits}" FontSize="8.5" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#F5F5F7"
                                               Margin="0,3,0,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding Body}" FontSize="9.5" Foreground="{StaticResource SecondaryBrush}"
                                               MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="NotificationsEmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                <Border Width="40" Height="40" CornerRadius="20" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E7;" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="All Caught Up" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="New alerts and Windows notifications will appear here" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
