<UserControl x:Class="DynamicIsland.Views.Widgets.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="452"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="154" />
        </Grid.ColumnDefinitions>

        <!-- Left: Live Webcam Viewport + Ring Light -->
        <Border Grid.Column="0" Background="#FF0D0D12" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="14" core:RoundedClip.ClipChild="True">
            <Grid>
                <Image x:Name="CameraPreviewImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="MirrorFlipTransform" ScaleX="-1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>

                <!-- Optional Screen Ring Light Glow -->
                <Border x:Name="RingLightOverlay" BorderBrush="#FFFDF6E3" BorderThickness="7"
                        CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFFDF6E3" Opacity="0.85" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>

                <!-- Status / Empty State Overlay -->
                <StackPanel x:Name="StatusOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="12" IsHitTestVisible="False">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#24FFFFFF"
                            HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Starting camera..." FontSize="9.5" FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Pre-Call Controls & Live Mic Meter -->
        <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="10,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Quick Mirror" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="CameraNameText" Text="Ready" FontSize="8"
                               Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Action Toggles -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button x:Name="RingLightBtn" Click="RingLightBtn_Click" Style="{StaticResource IslandButton}"
                            Height="24" Padding="8,0" Margin="0,0,0,5" HorizontalContentAlignment="Left"
                            ToolTip="Toggle Screen Ring Light">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE706;" FontSize="9.5" Foreground="#FFFFD60A" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RingLightBtnText" Text="Ring Light: Off" FontSize="8.8" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FlipMirrorBtn" Click="FlipMirrorBtn_Click" Style="{StaticResource IslandButton}"
                            Height="24" Padding="8,0" Margin="0,0,0,5" HorizontalContentAlignment="Left"
                            ToolTip="Flip Horizontal Mirror">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FlipMirrorBtnText" Text="Mirror: Flipped" FontSize="8.8" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SwitchCameraBtn" Click="SwitchCameraBtn_Click" Style="{StaticResource IslandButton}"
                            Height="24" Padding="8,0" HorizontalContentAlignment="Left"
                            ToolTip="Switch Active Camera">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Switch Camera" FontSize="8.8" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Live Mic Check Footer -->
                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="MIC CHECK" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="MirrorMicMuteBtn" DockPanel.Dock="Right" Click="MirrorMicMuteBtn_Click"
                                Style="{StaticResource IslandButton}" Height="18" Padding="6,0"
                                ToolTip="Toggle Hardware Microphone Mute">
                            <TextBlock x:Name="MirrorMicMuteText" Text="Mute" FontSize="7.5" FontWeight="SemiBold" />
                        </Button>
                    </DockPanel>
                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource ChipBgBrush}" ClipToBounds="True">
                        <Border x:Name="MicLevelFill" Width="2" Height="5" CornerRadius="2.5"
                                HorizontalAlignment="Left" Background="{DynamicResource GreenBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
