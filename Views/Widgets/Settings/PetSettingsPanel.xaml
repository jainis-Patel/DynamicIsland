<UserControl x:Class="DynamicIsland.Views.Widgets.Settings.PetSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="400"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer x:Name="PanelScrollViewer"
                  PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,4,6">

            <Border Style="{StaticResource SettingsGroupCard}" Padding="10,8" Margin="0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="62" Height="54" CornerRadius="8" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <core:PetHostControl x:Name="SettingsHeroPet" MouseLeftButtonDown="PetCompanion_Click" Width="54" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                <TextBlock x:Name="SettingsHeroPetName" Text="Mochi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Cursor="Hand" MouseLeftButtonDown="PetNameBtn_Click" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="PetSettingsStreakBadge" Visibility="Collapsed" Background="#22FF9F0A" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PetSettingsStreakText" Text="🔥 1d" Style="{StaticResource Digits}" FontSize="7.5" FontWeight="Bold" Foreground="#FF9F0A" />
                                    </Border>
                                    <TextBlock x:Name="SettingsHeroPetRank" Text="Level 1 · Companion" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="SettingsHeroPetSub" Text="Interactive Capsule Companion" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,5" />
                            <Grid Height="4" Background="{DynamicResource IslandSliderTrackBrush}" Margin="0,0,0,4">
                                <Border x:Name="SettingsHeroPetProgressBar" HorizontalAlignment="Left" Width="45" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                            </Grid>
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="SettingsHeroPetScore" Style="{StaticResource Digits}" Text="25 / 50 XP" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                                <TextBlock x:Name="SettingsHeroPetWellnessMini" DockPanel.Dock="Right" Style="{StaticResource Digits}" Text="Treat 0 · Water 0 · Stretch 0" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Profile & Custom Name Row -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="PetToggleSwitch" Click="PetToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" Margin="0,0,6,0" />
                            <TextBlock Text="Active" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PetStatusSummaryText" Text="Mochi · 25 XP" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="20" Width="104" Padding="6,0" Margin="0,0,3,0">
                                <TextBox x:Name="PetCustomNameBox" MaxLength="18" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource AccentBrush}" FontSize="8" VerticalAlignment="Center" KeyDown="PetCustomNameBox_KeyDown" LostFocus="PetCustomNameBox_LostFocus" ToolTipService.ToolTip="Type custom pet name and press Enter" />
                            </Border>
                            <Button Click="PetNameBtn_Click" x:Name="PetNameBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0" ToolTipService.ToolTip="Cycle preset pet names">
                                <TextBlock x:Name="PetNameBtnText" Text="🎲" FontSize="8.5" FontWeight="Medium" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Render Style Picker (3D Realistic vs 2D Classic Backup) -->
                    <TextBlock Text="RENDER STYLE" Style="{StaticResource SettingsOverlineHeader}" Margin="0,0,0,4" />
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Click="PetRenderStylePickBtn_Click" x:Name="PetStyle3DBtn" Tag="Realistic3D" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="0,0,2,0" ToolTipService.ToolTip="GPU-accelerated realistic 3D pets with fur/scale shading">
                            <TextBlock Text="✨ 3D Realistic" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetRenderStylePickBtn_Click" x:Name="PetStyle2DBtn" Tag="Classic2D" Style="{StaticResource IslandButton}" Height="22" Padding="4,0" Margin="2,0,0,0" ToolTipService.ToolTip="Original 2D vector pets (preserved backup)">
                            <TextBlock Text="🎨 2D Classic" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                    </UniformGrid>

                    <!-- 6-Species Visual Picker -->
                    <TextBlock Text="SPECIES" Style="{StaticResource SettingsOverlineHeader}" Margin="0,0,0,4" />
                    <UniformGrid Columns="6" Margin="0,0,0,6">
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesCatBtn" Tag="Cat" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="0,0,2,0">
                            <TextBlock Text="🐱 Cat" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesDogBtn" Tag="Dog" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                            <TextBlock Text="🐶 Dog" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesBunnyBtn" Tag="Bunny" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                            <TextBlock Text="🐰 Bunny" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesFoxBtn" Tag="Fox" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                            <TextBlock Text="🦊 Fox" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesPandaBtn" Tag="Panda" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="1,0">
                            <TextBlock Text="🐼 Panda" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetSpeciesPickBtn_Click" x:Name="PetSpeciesDragonBtn" Tag="Dragon" Style="{StaticResource IslandButton}" Height="22" Padding="2,0" Margin="2,0,0,0">
                            <TextBlock Text="🐲 Dragon" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                    </UniformGrid>

                    <!-- 7-Accessory Wardrobe Picker -->
                    <TextBlock Text="WARDROBE" Style="{StaticResource SettingsOverlineHeader}" Margin="0,0,0,4" />
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="None" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccCrownBtn" Tag="Crown" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="👑 Crown" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccWizardBtn" Tag="WizardHat" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="🧙 Wizard" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccHeadphonesBtn" Tag="Headphones" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="🎧 DJ" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccSunglassesBtn" Tag="Sunglasses" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="🕶️ Shades" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccHaloBtn" Tag="Halo" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,3">
                            <TextBlock Text="😇 Halo" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                        <Button Click="PetAccessoryPickBtn_Click" x:Name="PetAccSproutBtn" Tag="Sprout" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,0,3">
                            <TextBlock Text="🌱 Sprout" FontSize="7.5" FontWeight="Medium" />
                        </Button>
                    </WrapPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Behavior Toggles -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="False">
                            <TextBlock Text="Auto-Roam Desktop" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Autonomously stroll along the taskbar when Roam Desktop is open" />
                            <CheckBox x:Name="PetAutoRoamToggleSwitch" Click="PetAutoRoamToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>
                        <DockPanel Grid.Column="2" LastChildFill="False">
                            <TextBlock Text="Smart Reactions" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="React to Pomodoro focus, low battery, high load &amp; late-night hours" />
                            <CheckBox x:Name="PetContextToggleSwitch" Click="PetContextToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Row 1: Surfaces & Reminder Cadence -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="Surfaces" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OpenPetPlaygroundBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,4,0" ToolTipService.ToolTip="Open full-sized interactive Pet Playground surface">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="8" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Playground" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Click="RoamDesktopBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0,0,4,0" ToolTipService.ToolTip="Detach companion to roam floating on desktop">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="8" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Roam Desktop" FontSize="8" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <Button Click="PetReminderCycleBtn_Click" x:Name="PetReminderCycleBtn" Style="{StaticResource IslandButton}" Height="20" Padding="8,0" Margin="0" ToolTipService.ToolTip="Cycle wellness reminder frequency">
                                <TextBlock x:Name="PetReminderCycleText" Text="Remind: 30m" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 2: Care & Wellness Actions -->
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Care" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="PetInteractBtn_Click" x:Name="PetInteractBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                <TextBlock Text="Pet" FontSize="8" FontWeight="Medium" />
                            </Button>
                            <Button Click="PetTreatBtn_Click" x:Name="PetTreatBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                <TextBlock x:Name="PetTreatText" Text="Treat: 0" FontSize="8" FontWeight="Medium" />
                            </Button>
                            <Button Click="PetTrickBtn_Click" x:Name="PetTrickBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                <TextBlock Text="Flip" FontSize="8" FontWeight="Medium" />
                            </Button>
                            <Button Click="PetHydrateBtn_Click" x:Name="PetHydrateBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,3,0">
                                <TextBlock x:Name="PetHydrateText" Text="Water: 0" FontSize="8" FontWeight="Medium" />
                            </Button>
                            <Button Click="PetStretchBtn_Click" x:Name="PetStretchBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                <TextBlock x:Name="PetStretchText" Text="Stretch: 0" FontSize="8" FontWeight="Medium" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
