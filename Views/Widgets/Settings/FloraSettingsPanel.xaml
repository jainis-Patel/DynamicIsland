<UserControl x:Class="DynamicIsland.Views.Widgets.Settings.FloraSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="400"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer x:Name="PanelScrollViewer"
                  PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                  CanContentScroll="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,4,6">

            <Border Style="{StaticResource SettingsGroupCard}" Margin="0">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Botanical Overlay" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="NatureThemeSubtext" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Text="Procedural foliage &amp; blooms" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="NatureActiveThemeBadge" Text="Ivy &amp; Blooms" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </DockPanel>

                    <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="7" Padding="2" Margin="0,0,0,4">
                        <UniformGrid Columns="3">
                            <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0,0,2,0">
                                <TextBlock x:Name="ThemesTabNoneText" Text="Disabled" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabIvyBtn" Tag="Ivy &amp; Blooms" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0,0,2,0">
                                <TextBlock x:Name="ThemesTabIvyText" Text="Ivy &amp; Blooms" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="IslandThemeBtn_Click" x:Name="ThemesTabMeadowBtn" Tag="Meadow" Style="{StaticResource IslandButton}" Height="21" Padding="4,0" Margin="0">
                                <TextBlock x:Name="ThemesTabMeadowText" Text="Wild Meadow" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Controls auto-dimmed when Botanical Overlay is Disabled -->
                    <StackPanel x:Name="FloraControlsGroup">
                        <Border Style="{StaticResource SettingsHairline}" />

                        <!-- Density Profiles -->
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Density Profile" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Click="NaturePresetBtn_Click" Tag="Minimalist" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                    <TextBlock Text="Minimal" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="NaturePresetBtn_Click" Tag="Subtle" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                    <TextBlock Text="Subtle" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="NaturePresetBtn_Click" Tag="Balanced" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,3,0">
                                    <TextBlock Text="Balanced" FontSize="8" FontWeight="Medium" />
                                </Button>
                                <Button Click="NaturePresetBtn_Click" Tag="Lush" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                    <TextBlock Text="Lush" FontSize="8" FontWeight="Medium" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SettingsHairline}" />

                        <!-- 2x2 Botanical Sliders -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Vine Density" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureDensityText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="70%" />
                                </DockPanel>
                                <Slider x:Name="NatureDensitySlider" ValueChanged="NatureDensitySlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="150" Value="70" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Bloom Frequency" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureBloomText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="75%" />
                                </DockPanel>
                                <Slider x:Name="NatureBloomSlider" ValueChanged="NatureBloomSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="150" Value="75" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Foliage Scale" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureScaleText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="85%" />
                                </DockPanel>
                                <Slider x:Name="NatureScaleSlider" ValueChanged="NatureScaleSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="40" Maximum="140" Value="85" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock Text="Cascade Drop" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="NatureDropText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="60 px" />
                                </DockPanel>
                                <Slider x:Name="NatureDropSlider" ValueChanged="NatureDropSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="20" Maximum="120" Value="60" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsHairline}" />

                        <!-- Butterflies -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Fluttering Companions" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="NatureButterflySubtext" Text="2 · Monarch &amp; Morpho" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly0Btn" Tag="0" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NatureButterfly0Text" Text="0" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly1Btn" Tag="1" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NatureButterfly1Text" Text="1" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly2Btn" Tag="2" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NatureButterfly2Text" Text="2" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly3Btn" Tag="3" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NatureButterfly3Text" Text="3" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="NatureButterflyBtn_Click" x:Name="NatureButterfly4Btn" Tag="4" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                    <TextBlock x:Name="NatureButterfly4Text" Text="4" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Ambient Pollen -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="Ambient Pollen Motes" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="NaturePollenText" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="14 motes" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="NaturePollenToggleSwitch" Click="NaturePollenToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" />
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="NaturePollenSlider" ValueChanged="NaturePollenSlider_ValueChanged" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="30" Value="14" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
