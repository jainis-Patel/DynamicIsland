<UserControl x:Class="DynamicIsland.Views.Widgets.Settings.NotificationsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="400"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer x:Name="PanelScrollViewer"
                  PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,4,6">

            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Notification Center" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Inspect ring buffer history and intercepted system toasts" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <Button Click="OpenNotifCenterBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="9,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open Center" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Do Not Disturb" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Suppress incoming banner animations and alert chimes" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="SettingsDndToggleSwitch" Click="DndToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Intercept Windows Toast Banners" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Dismiss native bottom-right popups and route exclusively to the capsule" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="ReplaceBannersToggleSwitch" Click="ReplaceBannersToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Group Notifications by App" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Stack consecutive alerts from the same application into collapsible cards" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="GroupNotifsToggleSwitch" Click="GroupNotifsToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Muted Apps Manager -->
            <Border Style="{StaticResource SettingsGroupCard}" Margin="0">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Muted Applications" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Click any chip to restore Island notification toasts for that app" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="MutedAppsCountText" Style="{StaticResource Digits}" Text="0 muted" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock x:Name="MutedAppsEmptyText" Text="No muted apps" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.75" Margin="0,2,0,2" />

                    <ItemsControl x:Name="MutedAppsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="UnmuteAppBtn_Click" Tag="{Binding}" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,4,4" ToolTipService.ToolTip="Click to unmute notifications from this app">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74F;" FontSize="7.5" Foreground="{DynamicResource AmberBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="8" FontWeight="Medium" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="6.5" Foreground="{DynamicResource SecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
