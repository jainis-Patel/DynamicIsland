<UserControl x:Class="DynamicIsland.Views.Widgets.Settings.DisplayPowerSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="400"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer x:Name="PanelScrollViewer"
                  PreviewMouseWheel="VerticalScrollViewer_PreviewMouseWheel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,4,6">

            <!-- Display & Geometry Group -->
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <!-- Target Display -->
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Target Display" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="MonitorStatusBadge" Text="Active" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="MonitorDetailsText" Style="{StaticResource Digits}" Text="Display 1: 1920 × 1080 @ 60 Hz" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="MonitorSwitchBtn_Click" x:Name="MonitorSwitchBtn" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,6,0">
                                <TextBlock x:Name="MonitorSwitchText" Text="Screen 1" FontSize="8" FontWeight="Medium" />
                            </Button>
                            <TextBlock Text="Follow" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTipService.ToolTip="Follow active mouse cursor monitor" />
                            <CheckBox x:Name="FollowMonitorToggleSwitch" Click="FollowMonitorToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" ToolTipService.ToolTip="Follow active mouse cursor monitor" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Row 1: Alignment, Notch & Floating PiP -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="DockButton_Click" x:Name="DockLeftBtn" Tag="Left" Style="{StaticResource IslandButton}" Height="19" Padding="7,0" Margin="0,0,2,0">
                                    <TextBlock Text="Left" FontSize="8" />
                                </Button>
                                <Button Click="DockButton_Click" x:Name="DockCenterBtn" Tag="Center" Style="{StaticResource IslandButton}" Height="19" Padding="7,0" Margin="0,0,2,0">
                                    <TextBlock Text="Center" FontSize="8" />
                                </Button>
                                <Button Click="DockButton_Click" x:Name="DockRightBtn" Tag="Right" Style="{StaticResource IslandButton}" Height="19" Padding="7,0" Margin="0">
                                    <TextBlock Text="Right" FontSize="8" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Notch" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <CheckBox x:Name="NotchBezelToggleSwitch" Click="NotchBezelToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" Margin="0,0,8,0" ToolTipService.ToolTip="Simulate hardware laptop notch bezel" />
                            <TextBlock Text="PiP" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTipService.ToolTip="Detach into Floating Picture-in-Picture window (Ctrl+Alt+F)" />
                            <CheckBox x:Name="FloatingPiPToggleSwitch" Click="FloatingPiPToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" ToolTipService.ToolTip="Detach into Floating Picture-in-Picture window (Ctrl+Alt+F)" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 2: Top Margin Slider -->
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,2">
                            <TextBlock Text="Top Margin Offset" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="NotchOffsetText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Text="0 px" />
                        </DockPanel>
                        <Slider ValueChanged="NotchOffsetSlider_ValueChanged" x:Name="NotchOffsetSlider" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="45" Value="0" />
                    </StackPanel>

                    <!-- Hardware Notch Preset Picker (Visible when Notch mode active) -->
                    <StackPanel x:Name="NotchPresetsGroup" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsHairline}" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Notch Preset" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Click="NotchPresetBtn_Click" x:Name="NotchPresetMBP16Btn" Tag="MacBookPro16" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NotchPresetMBP16Text" Text="MBP 16" FontSize="7.5" />
                                </Button>
                                <Button Click="NotchPresetBtn_Click" x:Name="NotchPresetMBP14Btn" Tag="MacBookPro14" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NotchPresetMBP14Text" Text="MBP 14" FontSize="7.5" />
                                </Button>
                                <Button Click="NotchPresetBtn_Click" x:Name="NotchPresetAirBtn" Tag="MacBookAir" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NotchPresetAirText" Text="Air" FontSize="7.5" />
                                </Button>
                                <Button Click="NotchPresetBtn_Click" x:Name="NotchPresetXpsBtn" Tag="DellXps" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0,0,2,0">
                                    <TextBlock x:Name="NotchPresetXpsText" Text="XPS" FontSize="7.5" />
                                </Button>
                                <Button Click="NotchPresetBtn_Click" x:Name="NotchPresetCustomBtn" Tag="Custom" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                    <TextBlock x:Name="NotchPresetCustomText" Text="Custom" FontSize="7.5" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Night Light & Color Temperature -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Night Light (Eye Comfort)" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Warm color temperature filter for evening sessions" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="NightLightToggleSwitch" Click="NightLightSettingsBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>
                    <StackPanel x:Name="NightLightWarmthGroup">
                        <DockPanel LastChildFill="False" Margin="0,0,0,2">
                            <TextBlock Text="Color Temperature" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                            <TextBlock x:Name="NightLightWarmthText" DockPanel.Dock="Right" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="3400 K" />
                        </DockPanel>
                        <Slider ValueChanged="NightLightWarmthSlider_ValueChanged" x:Name="NightLightWarmthSlider" Style="{StaticResource IslandSlider}" Minimum="2200" Maximum="5000" Value="3400" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Power Automation Group -->
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                        <TextBlock Text="Power Automation" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock x:Name="BatteryHealthSummaryText" DockPanel.Dock="Right" Style="{StaticResource Digits}" Text="Health: 98% · AC" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="False">
                            <TextBlock Text="MagSafe Pulse" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox x:Name="ChargingPulseToggleSwitch" Click="ChargingPulseToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>

                        <DockPanel Grid.Row="0" Grid.Column="2" LastChildFill="False">
                            <TextBlock Text="Auto Power Saver" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoPowerSaverToggleSwitch" Click="AutoPowerSaverToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>

                        <DockPanel Grid.Row="2" Grid.Column="0" LastChildFill="False">
                            <TextBlock Text="High-Load Droplet" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox x:Name="HighLoadAlertsToggleSwitch" Click="HighLoadAlertsToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>

                        <DockPanel Grid.Row="2" Grid.Column="2" LastChildFill="False">
                            <TextBlock Text="Auto AC Perf" FontSize="8.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoPowerAcToggleSwitch" Click="AutoPowerAcToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                        </DockPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <UniformGrid Columns="3">
                        <DockPanel LastChildFill="False" Margin="0,0,6,0">
                            <TextBlock Text="Low Battery" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                            <Button Click="LowBattThresholdBtn_Click" x:Name="LowBattThresholdBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                <TextBlock x:Name="LowBattThresholdText" Text="20%" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" />
                            </Button>
                        </DockPanel>

                        <DockPanel LastChildFill="False" Margin="3,0">
                            <TextBlock Text="CPU Alert" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                            <Button Click="HighCpuThresholdBtn_Click" x:Name="HighCpuThresholdBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                <TextBlock x:Name="HighCpuThresholdText" Text="80%" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" />
                            </Button>
                        </DockPanel>

                        <DockPanel LastChildFill="False" Margin="6,0,0,0">
                            <TextBlock Text="RAM Alert" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                            <Button Click="HighRamThresholdBtn_Click" x:Name="HighRamThresholdBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="19" Padding="6,0" Margin="0">
                                <TextBlock x:Name="HighRamThresholdText" Text="85%" Style="{StaticResource Digits}" FontSize="8" FontWeight="SemiBold" />
                            </Button>
                        </DockPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Browser & Tab Passthrough Group -->
            <Border Style="{StaticResource SettingsGroupCard}" Margin="0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,2">
                        <TextBlock Text="Browser &amp; Tab Passthrough" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Prevents blocking browser tabs, search bars, and top controls" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Visibility Mode: Always Visible vs Taskbar-Style Auto-Hide -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Visibility Mode" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="AutoHideModeSubtext" Text="Always visible at top edge" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="AutoHideModeBtn_Click" x:Name="AutoHideAlwaysBtn" Tag="AlwaysVisible" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0" ToolTipService.ToolTip="Keep Dynamic Island always visible">
                                    <TextBlock Text="Always Visible" FontSize="7.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="AutoHideModeBtn_Click" x:Name="AutoHideAutoBtn" Tag="AutoHide" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0" ToolTipService.ToolTip="Hide like Windows taskbar; hover top edge to pull back">
                                    <TextBlock Text="Auto-Hide" FontSize="7.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Expand Trigger Mode (includes Hover 380ms) -->
                    <StackPanel Margin="0,0,0,2">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="Expand Trigger" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Click Only prevents popups over tabs" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <UniformGrid Columns="4">
                            <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerClickBtn" Tag="ClickOnly" Style="{StaticResource IslandButton}" Height="20" Padding="4,0" Margin="0,0,2,0">
                                <TextBlock Text="Click Only" FontSize="7.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerSnappyBtn" Tag="HoverSnappy" Style="{StaticResource IslandButton}" Height="20" Padding="4,0" Margin="1,0">
                                <TextBlock Text="Hover 150ms" FontSize="7.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerRelaxedBtn" Tag="HoverRelaxed" Style="{StaticResource IslandButton}" Height="20" Padding="4,0" Margin="1,0">
                                <TextBlock Text="Hover 260ms" FontSize="7.5" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="ExpandTriggerBtn_Click" x:Name="ExpandTriggerDwellBtn" Tag="HoverDwell" Style="{StaticResource IslandButton}" Height="20" Padding="4,0" Margin="2,0,0,0">
                                <TextBlock Text="Hover 380ms" FontSize="7.5" HorizontalAlignment="Center" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Fast-Swipe Guard -->
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fast-Swipe Guard" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Ignore rapid pointer passes toward window titlebars" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="FastSwipeGuardToggleSwitch" Click="FastSwipeGuardToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Ghost Passthrough Modifier -->
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ghost Click-Through Key" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Hold key to make island transparent to clicks" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="GhostModifierBtn_Click" x:Name="GhostModCtrlBtn" Tag="Ctrl" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                <TextBlock Text="Ctrl" FontSize="8" />
                            </Button>
                            <Button Click="GhostModifierBtn_Click" x:Name="GhostModAltBtn" Tag="Alt" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0,0,2,0">
                                <TextBlock Text="Alt" FontSize="8" />
                            </Button>
                            <Button Click="GhostModifierBtn_Click" x:Name="GhostModNoneBtn" Tag="None" Style="{StaticResource IslandButton}" Height="20" Padding="7,0" Margin="0">
                                <TextBlock Text="Off" FontSize="8" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource SettingsHairline}" />

                    <!-- Quick Tuck -->
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Quick Tuck Gesture" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Double-click pill or Ctrl+Alt+Down to snooze for 5s" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="QuickTuckToggleSwitch" Click="QuickTuckToggleBtn_Click" DockPanel.Dock="Right" Style="{StaticResource IslandToggleSwitch}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Context Profiles Card -->
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Context Profiles" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Bundle DND, Pet, Auto-Hide &amp; Low RAM presets" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="Pomodoro" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <CheckBox x:Name="LinkPomodoroFocusToggle" Click="LinkPomodoroFocusToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" Margin="0,0,8,0" ToolTipService.ToolTip="Auto-activate Deep Focus profile when a Pomodoro timer starts" />
                            <TextBlock Text="Auto" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <CheckBox x:Name="AutoProfileSwitchToggle" Click="AutoProfileSwitchToggleBtn_Click" Style="{StaticResource IslandToggleSwitch}" ToolTipService.ToolTip="Auto-switch to Presenting when OBS, Zoom, Teams, or PowerPoint runs" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ProfileDefaultBtn" Tag="default" Click="ContextProfileBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,4,0">
                            <TextBlock Text="Default" FontSize="8" />
                        </Button>
                        <Button x:Name="ProfileFocusBtn" Tag="focus" Click="ContextProfileBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,4,0">
                            <TextBlock Text="Deep Focus" FontSize="8" />
                        </Button>
                        <Button x:Name="ProfileGamingBtn" Tag="gaming" Click="ContextProfileBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,4,0">
                            <TextBlock Text="Gaming" FontSize="8" />
                        </Button>
                        <Button x:Name="ProfilePresentingBtn" Tag="presenting" Click="ContextProfileBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0,0,4,0">
                            <TextBlock Text="Presenting" FontSize="8" />
                        </Button>
                        <Button x:Name="SaveCustomProfileBtn" Click="SaveCustomProfileBtn_Click" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Margin="0" ToolTipService.ToolTip="Save current settings as your Custom profile">
                            <TextBlock Text="+ Save Custom" FontSize="8" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
