<UserControl x:Class="DynamicIsland.Views.Widgets.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="470"
             AllowDrop="True" Drop="LauncherView_Drop" DragOver="LauncherView_DragOver">
    <UserControl.Resources>
        <!-- Sleek Glass Context Menu Style -->
        <Style x:Key="IslandContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" CornerRadius="10" Padding="4">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu Item Style -->
        <Style x:Key="IslandMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Apple Glass Tooltip (Eliminates ugly raw 'island:calc' Win32 popup) -->
        <Style x:Key="IslandTileTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" CornerRadius="8" Padding="9,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <StackPanel MaxWidth="190">
                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FriendlyDescription}" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1.5,0,3" TextWrapping="Wrap" />
                                <Border Height="0.5" Background="{DynamicResource CardBorderBrush}" Margin="0,1,0,2.5" />
                                <TextBlock Text="{Binding ActionHint}" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Fluent App Tile Template (Native Floating Icons, Soft Hover Highlight) -->
        <DataTemplate x:Key="UnifiedAppTileTemplate">
            <Border Width="142" Height="62" CornerRadius="11"
                    BorderThickness="1" Margin="0,0,5,5" Padding="4,2"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="350" ToolTipService.BetweenShowDelay="100"
                    AllowDrop="True" Drop="AppCard_Drop" DragOver="AppCard_DragOver"
                    MouseLeftButtonDown="AppCard_Click"
                    MouseRightButtonUp="AppCard_MouseRightButtonUp">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource IslandTileTooltipStyle}" />
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0DFFFFFF" />
                        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24FFFFFF" />
                                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Icon Area (Clean Floating App Icon or Subtle Widget Squircle) -->
                    <Grid Grid.Row="0" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,1,0,1.5">
                        <!-- Real App Icon: Floats natively on surface with no background box -->
                        <Image x:Name="AppIconImage" Source="{Binding IconSource}" Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Widget Squircle: Only shown for built-in tools for high-contrast color -->
                        <Border x:Name="GlyphBox" Width="26" Height="26" CornerRadius="8"
                                Background="{Binding IconBgBrush}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="11.5"
                                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="132" HorizontalAlignment="Center" />

                    <!-- Subtitle -->
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" FontSize="7.5"
                               Foreground="{DynamicResource SecondaryBrush}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="132" Margin="0,0.5,0,0" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="AppIconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="GlyphBox" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                    <Setter TargetName="AppIconImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GlyphBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,1,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Toolbar -->
        <DockPanel Grid.Row="0" Margin="2,0,2,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Apps &amp; Widgets" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="LauncherSubtitleBadge" Text="Quick launcher &amp; drop target" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Interactive Filter Tabs: [All] [Pinned] [Widgets] -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Button x:Name="TabAllBtn" Content="All" Click="TabAll_Click" Style="{StaticResource FilterPillButton}" />
                    <Button x:Name="TabPinnedBtn" Content="Pinned" Click="TabPinned_Click" Style="{StaticResource FilterPillButton}" Margin="3,0,0,0" />
                    <Button x:Name="TabWidgetsBtn" Content="Widgets" Click="TabWidgets_Click" Style="{StaticResource FilterPillButton}" Margin="3,0,0,0" />
                </StackPanel>

                <!-- Integrated Spotlight Search Pill -->
                <Border x:Name="SearchBoxHost" Margin="6,0,0,0" Height="20" CornerRadius="10"
                        Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid Margin="6,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="SearchInputBox" Width="96" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}" FontSize="8.5"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"
                                     TextChanged="SearchInputBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Search apps &amp; widgets..." FontSize="8"
                                       Foreground="{DynamicResource SecondaryBrush}" Opacity="0.55"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="1,0,0,0" />
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Click="ClearSearchBtn_Click" Visibility="Collapsed"
                                Style="{StaticResource FilterPillButton}" Height="14" Width="14" Padding="0" Margin="2,0,0,0"
                                Background="Transparent" BorderThickness="0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7" Foreground="{DynamicResource SecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="AddCustomAppBtn_Click" Style="{StaticResource IslandButton}" Height="23" Padding="8,0" Margin="0,0,2,0" ToolTipService.ToolTip="Pin new app (.exe, .lnk) or folder">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Pin App" FontSize="8.5" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Center Content: Smooth ScrollContainer with Clear Bottom Clearance -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LauncherScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly"
                      PreviewMouseWheel="LauncherView_PreviewMouseWheel">
            <StackPanel Margin="0,2,2,14">
                <!-- Unified Grid of All Apps & Widgets (3 columns of 142px + margins = 441px <= 456px) -->
                <ItemsControl x:Name="LauncherItemsControl" ItemTemplate="{StaticResource UnifiedAppTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty Search Results Prompt -->
                <Border x:Name="EmptySearchPrompt" Visibility="Collapsed" Height="44" Margin="0,8,0,6"
                        Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="No matching apps or widgets found" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Empty State Prompt (Visible only when Pinned filter is selected and 0 custom apps) -->
                <Border x:Name="EmptyAppsPrompt" Visibility="Collapsed" Height="44" Margin="0,4,0,6"
                        Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="9"
                        Cursor="Hand" MouseLeftButtonDown="AddCustomAppBtn_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="No custom apps pinned. Click here or drop .exe files to pin" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
