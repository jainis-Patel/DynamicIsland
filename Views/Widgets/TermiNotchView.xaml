<UserControl x:Class="DynamicIsland.Views.Widgets.TermiNotchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:DynamicIsland.Core"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="470">
    <Grid Margin="0,2,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Status -->
        <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackToLauncher_Click" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0,0,6,0" ToolTipService.ToolTip="Back to Apps &amp; Widgets">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TermiHeaderTitle" Text="Termi-Notch Console" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />

                <!-- AI Diff HUD Staged Indicator -->
                <Border x:Name="TermiDiffBadge" Visibility="Collapsed" Background="#220A84FF" BorderBrush="#350A84FF" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TermiDiffBadge_Click" ToolTipService.ToolTip="AI Agent Diff staged · Click to view diff">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="8.5" Foreground="#0A84FF" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TermiDiffBadgeText" Text="AI Diff Staged" FontSize="8.5" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TermiStatusText" Text="PowerShell / CMD · 0% CPU Idle" FontSize="8" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ClearConsoleBtn_Click" Style="{StaticResource IslandButton}" Height="21" Width="22" Padding="0" ToolTipService.ToolTip="Clear console output">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="{DynamicResource SecondaryBrush}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Preset Snippet Pills -->
        <ScrollViewer x:Name="SnippetsScrollViewer" Grid.Row="1" Margin="0,0,0,5" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
            <StackPanel x:Name="SnippetsPillStack" Orientation="Horizontal" VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- Live Terminal Stream Surface OR AI Diff Surface -->
        <Border Grid.Row="2" Background="#0C0D12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,5">
            <Grid>
                <!-- 1. Standard Shell Console -->
                <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="ConsoleOutputBox" Background="Transparent" Foreground="#E0E0E6" BorderThickness="0"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="9.5"
                             IsReadOnly="True" TextWrapping="Wrap"
                             Text="Dynamic Island Termi-Notch [Version 0.5.0]&#x0a;Ready. Click a snippet above or enter a command below.&#x0a;" />
                </ScrollViewer>

                <!-- 2. AI Diff Surface -->
                <ScrollViewer x:Name="DiffScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DiffLinesHost" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Action Bar: Command Prompt Input OR Diff Decision -->
        <Grid Grid.Row="3">
            <!-- 1. Normal Console Input Bar -->
            <DockPanel x:Name="ConsoleInputPanel" LastChildFill="True">
                <Button Click="RunCommandBtn_Click" x:Name="RunCommandBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="24" Padding="10,0" Margin="5,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Run" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Height="24" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="CommandInputBox" KeyDown="CommandInputBox_KeyDown" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="9.5" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- 2. AI Agent Diff Decision Action Bar -->
            <DockPanel x:Name="DiffDecisionPanel" Visibility="Collapsed" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2030D158" BorderBrush="#4030D158" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock x:Name="DiffStatsAddedText" Text="+0" FontSize="8.5" FontWeight="Bold" Foreground="#30D158" />
                    </Border>
                    <Border Background="#20FF453A" BorderBrush="#40FF453A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                        <TextBlock x:Name="DiffStatsRemovedText" Text="-0" FontSize="8.5" FontWeight="Bold" Foreground="#FF453A" />
                    </Border>
                    <TextBlock x:Name="DiffFileLabel" Text="code.diff" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="DiffBackBtn_Click" Style="{StaticResource IslandButton}" Height="23" Padding="7,0" Margin="0,0,4,0" ToolTipService.ToolTip="Return to Console">
                        <TextBlock Text="Console" FontSize="8.5" FontWeight="Medium" />
                    </Button>
                    <Button Click="DiffRejectBtn_Click" Style="{StaticResource IslandButton}" Height="23" Padding="9,0" Margin="0,0,4,0"
                            Background="#22FF453A" BorderBrush="#35FF453A" BorderThickness="1" ToolTipService.ToolTip="Reject AI Request (N / Esc)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#FF453A" Margin="0,0,3,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reject" FontSize="9" FontWeight="SemiBold" Foreground="#FF453A" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="DiffApproveBtn_Click" Style="{StaticResource IslandButton}" Height="23" Padding="9,0" Margin="0"
                            Background="#2230D158" BorderBrush="#3530D158" BorderThickness="1" ToolTipService.ToolTip="Approve AI Request (Y / Enter)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="8.5" Foreground="#30D158" Margin="0,0,3,0" VerticalAlignment="Center" />
                            <TextBlock Text="Approve" FontSize="9" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
