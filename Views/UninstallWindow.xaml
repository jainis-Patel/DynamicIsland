<Window x:Class="DynamicIsland.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Dynamic Island"
        Width="490" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif">

    <Window.Resources>
        <FontFamily x:Key="SetupIconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

        <!-- Red Accent CheckBox for Uninstall options -->
        <Style x:Key="UninstallCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCDFEA" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="18" Height="18"
                                    Background="#151722" BorderBrush="#2C2F42" BorderThickness="1.5"
                                    CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3.5,9.5 L 7,13 L 14.5,5"
                                      Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF453A" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF453A" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF6961" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Frame -->
    <Border Background="#0C0D12"
            BorderBrush="#242636"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" Color="#000000" Opacity="0.88" ShadowDepth="12" />
        </Border.Effect>

        <Grid Margin="28,24,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content Card -->
                <RowDefinition Height="Auto" /> <!-- Status / Progress / Success Card -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Warning Pill & Window Controls -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#251214" BorderBrush="#502226" BorderThickness="1.2"
                            CornerRadius="13" Height="26" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF453A" Margin="0,0,6,0" />
                            <TextBlock Text="✕" Foreground="#FF453A" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Uninstall Dynamic Island" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseBtn" Click="CloseBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        Foreground="#8A8D9F" FontSize="12" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cbd" Background="{TemplateBinding Background}" CornerRadius="15">
                                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="12" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cbd" Property="Background" Value="#1E202C" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 2. Content Card -->
            <Border Grid.Row="1" Background="#12131C" BorderBrush="#222434" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Are you sure you want to remove Dynamic Island from your computer?"
                               Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14" />

                    <CheckBox x:Name="RemoveUserDataCheck"
                              Content="Also delete custom settings, clipboard history, and saved widgets"
                              IsChecked="False" Style="{StaticResource UninstallCheckBox}" />
                </StackPanel>
            </Border>

            <!-- 3. Status, Progress & Success Area -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <Grid x:Name="StatusContainer" Margin="0,0,0,6" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF453A" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#85889C" />
                    </StackPanel>
                </Grid>

                <Border x:Name="ProgressBarContainer" Visibility="Collapsed" Height="5" Background="#181A26" CornerRadius="2.5" Margin="0,0,0,2">
                    <ProgressBar x:Name="UninstallProgressBar" Height="5" Background="Transparent" Foreground="#FF453A" BorderThickness="0">
                        <ProgressBar.Clip>
                            <RectangleGeometry RadiusX="2.5" RadiusY="2.5" Rect="0,0,434,5" />
                        </ProgressBar.Clip>
                    </ProgressBar>
                </Border>

                <!-- Success Badge -->
                <Border x:Name="SuccessCard" Visibility="Collapsed"
                        Background="#0F2218" BorderBrush="#1C452C" BorderThickness="1"
                        CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#30D158" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="M 6.5,12.5 L 10,16 L 17.5,8" Stroke="#000000" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dynamic Island Uninstalled" FontWeight="SemiBold" FontSize="13" Foreground="#30D158" />
                            <TextBlock Text="All program files and shortcuts have been cleanly removed." FontSize="11.5" Foreground="#8AE2A2" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Bottom Action Buttons -->
            <Grid Grid.Row="3">
                <Button x:Name="KeepBtn" Content="Keep Dynamic Island" Click="KeepBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Height="40" Padding="16,0" Background="Transparent" BorderThickness="0"
                        Foreground="#85889C" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="kbd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="kbd" Property="Background" Value="#1A1C28" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="UninstallBtn" Click="UninstallBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="40" MinWidth="170" Padding="20,0"
                        Background="#FF453A" BorderThickness="0"
                        Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ubd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ubd" Property="Opacity" Value="0.90" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ubd" Property="Opacity" Value="0.80" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ubd" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="UninstallBtnText" Text="Uninstall Dynamic Island" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
