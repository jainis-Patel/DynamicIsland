<Window x:Class="DynamicIsland.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Dynamic Island"
        Width="460" Height="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="#0E0E13"
            BorderBrush="#2A2A38"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Color="#000000" Opacity="0.8" ShadowDepth="8" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Status / Progress -->
                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header with draggable area & Close button -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2A1616" BorderBrush="#502424" BorderThickness="1"
                            CornerRadius="12" Width="36" Height="24" Margin="0,0,12,0">
                        <TextBlock Text="✕" Foreground="#FF453A" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Uninstall Dynamic Island" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="#8E8E93" FontSize="12" Cursor="Hand" />
            </Grid>

            <!-- Content Area -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Are you sure you want to remove Dynamic Island from your computer?"
                           Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14" />

                <CheckBox x:Name="RemoveUserDataCheck"
                          Content="Also delete custom settings, clipboard history, and saved widgets"
                          IsChecked="False" Style="{StaticResource ModernCheckBox}" />
            </StackPanel>

            <!-- Status & Progress -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,6" />
                <ProgressBar x:Name="UninstallProgressBar" Height="4" Visibility="Collapsed" Background="#242432" Foreground="#FF453A" BorderThickness="0">
                    <ProgressBar.Clip>
                        <RectangleGeometry RadiusX="2" RadiusY="2" Rect="0,0,412,4" />
                    </ProgressBar.Clip>
                </ProgressBar>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3">
                <Button x:Name="KeepBtn" Content="Keep Dynamic Island" Click="KeepBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Height="34" Padding="14,0" Background="Transparent" BorderThickness="0"
                        Foreground="#8E8E93" FontSize="13" Cursor="Hand" />

                <Button x:Name="UninstallBtn" Content="Uninstall" Click="UninstallBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="36" Padding="24,0" Background="#FF453A" BorderThickness="0"
                        Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
