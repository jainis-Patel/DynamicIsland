<Window x:Class="DynamicIsland.Views.NotesPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Quick Notes &amp; Scratchpad"
        Width="380" Height="460"
        MinWidth="320" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="NotesCard" Margin="10" CornerRadius="16" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Search & Actions Bar -->
                <RowDefinition Height="*" />    <!-- Main Content (Editor + Notes Drawer) -->
                <RowDefinition Height="Auto" /> <!-- Status Footer -->
            </Grid.RowDefinitions>

            <!-- Top Header & Window Controls -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B2010" BorderBrush="#FF9F0A" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,7,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;" FontSize="11" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Quick Notes" FontSize="11" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                    <Border x:Name="NotesCountBadge" Background="#1C1C26" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotesCountText" Text="0 notes" FontSize="8.5" Foreground="#8E8E93" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewNoteBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0" ToolTip="New Blank Note (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="8.5" Foreground="#30D158" Margin="0,0,3,0" VerticalAlignment="Center" />
                            <TextBlock Text="New" FontSize="8.5" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="ExportShelfBtn_Click" x:Name="ExportShelfBtn" Style="{StaticResource IslandButton}" Height="20" Padding="6,0" Margin="0,0,3,0" ToolTip="Export Note as Markdown file to Drop Shelf (Ctrl+Shift+E)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shelf" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="TogglePinBtn_Click" x:Name="TogglePinBtn" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0,0,3,0" ToolTip="Pin / Unpin Note">
                        <TextBlock x:Name="PinGlyphText" Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Click="DeleteNoteBtn_Click" x:Name="DeleteNoteBtn" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0,0,3,0" ToolTip="Delete Current Note">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="8.5" Foreground="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Click="CloseBtn_Click" Style="{StaticResource IslandButton}" Height="20" Width="20" Padding="0" Margin="0" ToolTip="Close (Esc)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Search Bar & Color Tag Selector -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1C1C26" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Height="24" Padding="6,0" Margin="0,0,8,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="9" Foreground="#8E8E93" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0" FontSize="9.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                    </DockPanel>
                </Border>

                <!-- Color Swatches -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="#FF9F0A" Click="ColorSwatch_Click" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Amber" Background="#FF9F0A" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#64D2FF" Click="ColorSwatch_Click" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Cyan" Background="#64D2FF" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#30D158" Click="ColorSwatch_Click" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Green" Background="#30D158" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#BF5AF2" Click="ColorSwatch_Click" Width="14" Height="14" Margin="0,0,4,0" ToolTip="Purple" Background="#BF5AF2" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="#FF453A" Click="ColorSwatch_Click" Width="14" Height="14" Margin="0" ToolTip="Red" Background="#FF453A" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area: Tabbed / Split into Editor & Notes History -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Active Note Editor -->
                <Border Grid.Row="0" Background="#14141C" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <TextBox x:Name="NoteEditorBox"
                                 TextChanged="NoteEditorBox_TextChanged"
                                 Background="Transparent"
                                 Foreground="#F5F5F7"
                                 BorderThickness="0"
                                 FontSize="11"
                                 FontFamily="Consolas, Cascadia Code, Segoe UI"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 CaretBrush="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="EditorPlaceholder"
                                   Text="# Note Title&#x0a;&#x0a;Jot down ideas, snippets, or tasks in markdown...&#x0a;• First line automatically becomes the note title.&#x0a;• Export to Shelf sends a ready .md file."
                                   FontSize="10.5"
                                   Foreground="#484852"
                                   IsHitTestVisible="False"
                                   Margin="3,2,0,0"
                                   Visibility="Visible" />
                    </Grid>
                </Border>

                <!-- Splitter Divider with Recent Notes label -->
                <DockPanel Grid.Row="1" Margin="0,6,0,4" LastChildFill="False">
                    <TextBlock Text="ALL NOTES" FontSize="8" FontWeight="Bold" Foreground="#6E6E78" VerticalAlignment="Center" />
                    <Button Click="ToggleNotesListBtn_Click" x:Name="ToggleNotesListBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="16" Padding="4,0" ToolTip="Toggle Notes List">
                        <TextBlock x:Name="ToggleNotesListText" Text="Hide List" FontSize="7.5" Foreground="#8E8E93" />
                    </Button>
                </DockPanel>

                <!-- Recent Notes Drawer List -->
                <Border x:Name="NotesListBorder" Grid.Row="2" Background="#14141C" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A24" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,5" Margin="0,0,0,3"
                                            Cursor="Hand" MouseLeftButtonDown="NoteRow_Click" ToolTip="Click to open in editor">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1A1A24" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#252535" />
                                                        <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tag Color Pill -->
                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,1,6,1" Background="{Binding ColorTag}" />

                                            <!-- Title & Preview -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                    <TextBlock Style="{StaticResource Glyph}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" Text="&#xE718;" FontSize="7.5" Foreground="#FF9F0A" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding PreviewSnippet}" FontSize="8.5" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Date & Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding FormattedDate}" FontSize="7.5" Foreground="#5E5E66" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <Button Tag="{Binding Id}" Click="RowExportBtn_Click" Style="{StaticResource IslandButton}" Height="18" Width="18" Padding="0" Margin="0,0,2,0" ToolTip="Export to Drop Shelf">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="7.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Tag="{Binding Id}" Click="RowDeleteBtn_Click" Style="{StaticResource IslandButton}" Height="18" Width="18" Padding="0" ToolTip="Delete note">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7.5" Foreground="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom Status Footer -->
            <DockPanel Grid.Row="3" Margin="0,6,0,0" LastChildFill="False">
                <TextBlock x:Name="StatusInfoText" Text="Ready · Auto-saved locally" FontSize="8" Foreground="#6E6E78" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Esc to close · Ctrl+N new · Ctrl+Shift+E shelf" FontSize="7.5" Foreground="#5E5E66" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
