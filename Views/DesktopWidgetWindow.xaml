<Window x:Class="DynamicIsland.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Dynamic Island Desktop Widget"
        Width="264" Height="162"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WidgetHeaderIconBtn" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tactile Micro Pill Button for Interactive Widget Actions -->
            <Style x:Key="WidgetMicroPillBtn" TargetType="Button">
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="#22FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontSize" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBd" Property="Background" Value="#24FFFFFF" />
                                    <Setter TargetName="PillBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource DockActiveBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="7"
            CornerRadius="20"
            Background="{DynamicResource PillBackgroundBrush}"
            BorderBrush="{DynamicResource PillStrokeBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            Cursor="SizeAll"
            MouseEnter="RootCard_MouseEnter"
            MouseLeave="RootCard_MouseLeave"
            MouseLeftButtonDown="RootCard_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <!-- Ambient Radial Halo (Tinted per Widget Category or Album Artwork) -->
            <Ellipse x:Name="WidgetAmbientHalo"
                     Width="240" Height="96"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-30,-38,0,0"
                     Opacity="0.20"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="AmbientHaloStop" Color="#FF9F0A" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Subtle Top Specular Glass Rim -->
            <Border CornerRadius="20"
                    BorderBrush="#16FFFFFF"
                    BorderThickness="0,1,0,0"
                    IsHitTestVisible="False" />

            <Grid Margin="13,10,13,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Row 0: Header (Tinted Squircle + Title | Window Controls) ── -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Border x:Name="HeaderIconBadge"
                                Width="20" Height="20"
                                CornerRadius="6.5"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource ChipBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,6,0">
                            <TextBlock x:Name="HeaderGlyphText"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE9D9;"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="WIDGET"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderControlsCluster"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Opacity="0.68">
                        <Button x:Name="OpacityToggleBtn"
                                Click="OpacityToggleBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                ToolTip="Toggle Translucent Ghost Mode (100% / 78%)">
                            <TextBlock x:Name="OpacityToggleGlyph"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE7A6;"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                        </Button>
                        <Button x:Name="PinTopmostBtn"
                                Click="PinTopmostBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                ToolTip="Toggle Always On Top">
                            <TextBlock x:Name="PinTopmostGlyph"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE718;"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                        </Button>
                        <Button x:Name="OpenInIslandBtn"
                                Click="OpenInIslandBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                ToolTip="Open Full View in Dynamic Island (or Double-Click)">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE8A7;"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                        </Button>
                        <Button x:Name="CloseWidgetBtn"
                                Click="CloseWidgetBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                ToolTip="Unpin Desktop Widget">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE711;"
                                       FontSize="8"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ── Row 1: Hero Content Stage (Supports Left Visual Leaf/Artwork + Hero Value + Right Action Cluster) ── -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Optional Left Visual Slot A: Album Artwork Squircle (Media Widget) -->
                    <Border x:Name="MediaArtworkHost"
                            Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="10"
                            Background="#18FFFFFF"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,9,0"
                            ClipToBounds="True"
                            core:RoundedClip.ClipChild="True"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            MouseLeftButtonDown="MediaArtworkHost_Click"
                            ToolTip="Click to focus media player">
                        <Grid>
                            <TextBlock x:Name="MediaArtworkFallback"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE8D6;"
                                       FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="MediaArtworkImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Optional Left Visual Slot B: Apple Calendar Date Leaf (Calendar Widget) -->
                    <Border x:Name="CalendarDateLeafHost"
                            Grid.Column="0"
                            Width="36" Height="38"
                            CornerRadius="10"
                            Background="#16FFFFFF"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,9,0"
                            ClipToBounds="True"
                            core:RoundedClip.ClipChild="True"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF453A">
                                <TextBlock x:Name="CalendarLeafDayOfWeekText"
                                           Text="SUN"
                                           FontSize="6.5"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CalendarLeafDayNumText"
                                       Grid.Row="1"
                                       Style="{StaticResource Digits}"
                                       Text="22"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Optional Left Visual Slot C: Sculpted Live-Filling Battery Cell (Battery Widget) -->
                    <StackPanel x:Name="BatteryVisualCellHost"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border Width="58" Height="28"
                                CornerRadius="7.5"
                                Background="#16000000"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1.4"
                                Padding="2"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="BatteryCellFillBar"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="4.5"
                                        Width="46"
                                        Background="#30D158"
                                        ClipToBounds="True">
                                    <Rectangle x:Name="BatteryChargeShimmer"
                                               Width="24"
                                               HorizontalAlignment="Left"
                                               Opacity="0"
                                               IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="BatteryShimmerTranslate" X="-26" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                                <TextBlock x:Name="BatteryCellBoltGlyph"
                                           Style="{StaticResource Glyph}"
                                           Text="&#xE945;"
                                           FontSize="11.5"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border Width="3" Height="10"
                                CornerRadius="0,2,2,0"
                                Background="#48FFFFFF"
                                VerticalAlignment="Center"
                                Margin="1.5,0,0,0" />
                    </StackPanel>

                    <!-- Center Hero Readout (Always Populated) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroValueText"
                                   Style="{StaticResource Digits}"
                                   Text="—"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeroSubtitleText"
                                   Text="Live desktop telemetry"
                                   FontSize="9"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1.5,0,0" />
                    </StackPanel>

                    <!-- Right Action Cluster (Media Transport Prev/Play/Next OR Single Inline Action Button) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button x:Name="MediaPrevBtn"
                                Click="MediaPrevBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                Width="23" Height="23"
                                Margin="0,0,2,0"
                                Visibility="Collapsed"
                                ToolTip="Previous Track">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="9.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </Button>

                        <Button x:Name="InlineActionBtn"
                                Click="InlineActionBtn_Click"
                                Style="{StaticResource CircleButton}"
                                Width="27" Height="27"
                                Visibility="Collapsed"
                                ToolTip="Quick Action">
                            <TextBlock x:Name="InlineActionGlyph"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE768;"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>

                        <Button x:Name="MediaNextBtn"
                                Click="MediaNextBtn_Click"
                                Style="{StaticResource WidgetHeaderIconBtn}"
                                Width="23" Height="23"
                                Margin="2,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="Next Track">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="9.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Row 2: Rich Widget-Specific Interactive / Telemetry Strip ── -->
                <Grid Grid.Row="2" Margin="0,5,0,5">
                    <!-- A. Standard / Multi-Channel Progress Bars (Vitals, Battery, Timer, Media, Storage, Audio) -->
                    <StackPanel x:Name="BarsStripPanel">
                        <Grid x:Name="MetricBarHost" Height="4.5" Visibility="Collapsed">
                            <Border Background="{DynamicResource IslandSliderTrackBrush}" CornerRadius="2.25" />
                            <Border x:Name="MetricBarFill" Background="{DynamicResource AccentBrush}" CornerRadius="2.25" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid x:Name="MetricBar2Host" Height="3.5" Margin="0,3.5,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource IslandSliderTrackBrush}" CornerRadius="1.75" />
                            <Border x:Name="MetricBar2Fill" Background="#0A84FF" CornerRadius="1.75" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid x:Name="MetricBar3Host" Height="3.5" Margin="0,3.5,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource IslandSliderTrackBrush}" CornerRadius="1.75" />
                            <Border x:Name="MetricBar3Fill" Background="#BF5AF2" CornerRadius="1.75" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                    </StackPanel>

                    <!-- B. Network Dual Throughput Sub-Cards (Network Widget) -->
                    <Grid x:Name="NetworkDualCardsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,4">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="↓" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="NetDownPillText" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,4">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="↑" FontSize="9.5" FontWeight="Bold" Foreground="#0A84FF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="NetUpPillText" Style="{StaticResource Digits}" Text="0 KB/s" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- C. Unified Segmented Power Plan Switcher Strip (Battery Widget) -->
                    <Border x:Name="BatteryPlanStrip"
                            Background="#10FFFFFF"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="2"
                            Margin="0,2,0,0"
                            Visibility="Collapsed">
                        <UniformGrid Columns="3">
                            <Button x:Name="PlanEcoBtn" Tag="PowerSaver" Click="BatteryPlanBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Eco" Margin="0,0,2,0" BorderThickness="0" ToolTip="Switch to Power Saver Plan" />
                            <Button x:Name="PlanBalBtn" Tag="Balanced" Click="BatteryPlanBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Balanced" Margin="1,0" BorderThickness="0" ToolTip="Switch to Balanced Power Plan" />
                            <Button x:Name="PlanPerfBtn" Tag="Performance" Click="BatteryPlanBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Turbo" Margin="2,0,0,0" BorderThickness="0" ToolTip="Switch to High Performance Plan" />
                        </UniformGrid>
                    </Border>

                    <!-- D. Pomodoro Focus Timer Quick Presets Strip (Timer Widget) -->
                    <StackPanel x:Name="TimerPresetStrip" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                        <Button Tag="15" Click="TimerPresetBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="15m" ToolTip="Start 15-minute focus sprint" />
                        <Button Tag="25" Click="TimerPresetBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="25m" ToolTip="Start 25-minute Pomodoro" />
                        <Button Tag="45" Click="TimerPresetBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="45m" ToolTip="Start 45-minute deep work session" />
                        <Button Click="TimerResetBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Reset" Margin="0" ToolTip="Reset Countdown Timer" />
                    </StackPanel>

                    <!-- E. Audio Volume & Endpoint Strip (Audio Widget) -->
                    <StackPanel x:Name="AudioControlStrip" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                        <Button x:Name="AudioMutePillBtn" Click="AudioMutePillBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Mute" ToolTip="Toggle Master Mute" />
                        <Button Tag="-0.1" Click="AudioStepVolBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="-10%" ToolTip="Volume Down 10%" />
                        <Button Tag="0.1" Click="AudioStepVolBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="+10%" ToolTip="Volume Up 10%" />
                        <Button Click="AudioSwitchOutputBtn_Click" Style="{StaticResource WidgetMicroPillBtn}" Content="Output ⇄" Margin="0" ToolTip="Cycle Default Audio Output Device" />
                    </StackPanel>
                </Grid>

                <!-- ── Row 3: Footer Context Line + Quick Utility Action + Status Badge ── -->
                <DockPanel Grid.Row="3" LastChildFill="False">
                    <TextBlock x:Name="FooterText"
                               Text="Pinned on desktop"
                               FontSize="8"
                               Foreground="{DynamicResource SecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="148"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Context-Aware Footer Utility Pill (e.g. Boost RAM, Copy IP, Sync Weather, Open C:, Join) -->
                        <Button x:Name="FooterUtilityBtn"
                                Click="FooterUtilityBtn_Click"
                                Style="{StaticResource WidgetMicroPillBtn}"
                                Height="17"
                                Padding="6,0"
                                Margin="0,0,5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="FooterUtilityText"
                                       Text="Action"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </Button>

                        <Border x:Name="StatusBadge"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource ChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="5,1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusBadgeText"
                                       Style="{StaticResource Digits}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="LIVE" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
