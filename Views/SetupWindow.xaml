<Window x:Class="DynamicIsland.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Setup"
        Width="490" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="#0E0E13"
            BorderBrush="#2A2A38"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Color="#000000" Opacity="0.8" ShadowDepth="8" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Hero / Description -->
                <RowDefinition Height="*" />    <!-- Options Card -->
                <RowDefinition Height="Auto" /> <!-- Status / Progress -->
                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header with draggable area & Close button -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Island pill icon -->
                    <Border Background="#1C1C24" BorderBrush="#3A3A4C" BorderThickness="1"
                            CornerRadius="12" Width="38" Height="24" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF9F0A" Margin="0,0,4,0" />
                            <Ellipse Width="6" Height="6" Fill="#30D158" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Dynamic Island" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="v0.3.0" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,2,0,0" />
                </StackPanel>

                <Button x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="#8E8E93" FontSize="12" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Hero Subtitle -->
            <TextBlock Grid.Row="1"
                       Text="Install the fluid, interactive Dynamic Island notch overlay on Windows 10 &amp; 11 with live media controls, audio visualizer, Wi-Fi scanner, and widgets."
                       Foreground="#9E9EA8" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18" />

            <!-- Options Card -->
            <Border Grid.Row="2" Background="#14141C" BorderBrush="#242432" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="INSTALLATION LOCATION" FontSize="10" FontWeight="Bold" Foreground="#6E6E78" Margin="0,0,0,4" />
                    <TextBlock x:Name="InstallPathText" Text="%LocalAppData%\Programs\DynamicIsland"
                               FontSize="11.5" Foreground="#007AFF" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#6E6E78" Margin="0,0,0,6" />
                    <CheckBox x:Name="AutoStartCheck" Content="Launch Dynamic Island when Windows starts" IsChecked="True" Style="{StaticResource ModernCheckBox}" />
                    <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu shortcut" IsChecked="True" Style="{StaticResource ModernCheckBox}" />
                    <CheckBox x:Name="DesktopCheck" Content="Create Desktop shortcut" IsChecked="True" Style="{StaticResource ModernCheckBox}" />
                </StackPanel>
            </Border>

            <!-- Status and Progress Bar -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock x:Name="StatusText" Text="Ready to install" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,6" />
                <ProgressBar x:Name="InstallProgressBar" Height="4" Visibility="Collapsed" Background="#242432" Foreground="#FF9F0A" BorderThickness="0">
                    <ProgressBar.Clip>
                        <RectangleGeometry RadiusX="2" RadiusY="2" Rect="0,0,442,4" />
                    </ProgressBar.Clip>
                </ProgressBar>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="4">
                <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Height="34" Padding="16,0" Background="Transparent" BorderThickness="0"
                        Foreground="#8E8E93" FontSize="13" Cursor="Hand" />

                <Button x:Name="ActionBtn" Content="Install Now" Click="ActionBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="36" Padding="24,0" Background="#FF9F0A" BorderThickness="0"
                        Foreground="#000000" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
