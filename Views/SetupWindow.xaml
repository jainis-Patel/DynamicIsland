<Window x:Class="DynamicIsland.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Setup"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource InstallerFontFamily}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/InstallerTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Window Frame (Fixed 480x440 px, 12px radius, solid #121214 with 1px #FFFFFF14 outline) -->
    <Border x:Name="SetupWindowFrame"
            Width="480" Height="440"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushOutline}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect x:Name="SetupShadow"
                              BlurRadius="32"
                              Color="#000000"
                              Opacity="0.6"
                              ShadowDepth="8"
                              Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" /> <!-- Custom draggable titlebar -->
                <RowDefinition Height="*" />  <!-- Vertically centered content area -->
            </Grid.RowDefinitions>

            <!-- 1. Top 40px Draggable Title Bar Area -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <!-- Back Button (shown only when in Options sub-pane) -->
                <Button x:Name="OptionsBackBtn"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Style="{StaticResource InstallerLinkButton}"
                        Click="BackToMain_Click"
                        Visibility="Collapsed"
                        ToolTip="Back">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 10,4 L 4,10 L 10,16"
                              Stroke="{StaticResource BrushTextSecondary}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Back" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Window Close Button (top-right) -->
                <Button x:Name="CloseWindowBtn"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Style="{StaticResource InstallerCloseButton}"
                        Click="CloseBtn_Click"
                        ToolTip="Close"
                        Focusable="False" />
            </Grid>

            <!-- 2. Main Work Area (Outer padding: 32px, vertically centered) -->
            <Grid Grid.Row="1" Margin="32,0,32,24" VerticalAlignment="Center">

                <!-- ════════════════════════════════════════════════════════════ -->
                <!--  MAIN VIEW CONTAINER (Ready / Progress / Done / Error)       -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="MainViewContainer" VerticalAlignment="Center">

                    <!-- STATE 1: READY (Upgrade or Fresh Install) -->
                    <StackPanel x:Name="ReadyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- Centered 64px App Icon -->
                        <Border Width="64" Height="64"
                                CornerRadius="16"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                Background="{StaticResource BrushElevated}"
                                Margin="0,0,0,16">
                            <Image Source="pack://application:,,,/Assets/app_256.png"
                                   Width="64" Height="64"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Headline (Title 22px semibold #F5F5F7) -->
                        <TextBlock x:Name="ReadyTitleText"
                                   Text="Install Dynamic Island"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6" />

                        <!-- Subtitle (Body 14px regular #A1A1A6) -->
                        <TextBlock x:Name="ReadySubtitleText"
                                   Text="A fluid, responsive island on your desktop."
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   LineHeight="20"
                                   Margin="0,0,0,16" />

                        <!-- First-Time Setup Quick Customization (hidden on upgrades) -->
                        <Border x:Name="FirstTimeSetupPanel"
                                Visibility="Collapsed"
                                Background="{StaticResource BrushElevated}"
                                BorderBrush="{StaticResource BrushOutline}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,0,0,18"
                                MaxWidth="390">
                            <StackPanel>
                                <!-- Visual Style -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Style" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="StyleOledBtn" Tag="Classic OLED" Content="Classic OLED" Click="StylePresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="0" Padding="8,0" FontSize="11" Margin="0,0,4,0" />
                                        <Button x:Name="StyleGlassBtn" Tag="Liquid Glass" Content="Liquid Glass" Click="StylePresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="0" Padding="8,0" FontSize="11" Margin="0,0,4,0" />
                                        <Button x:Name="StyleNatureBtn" Tag="Living Nature" Content="Living Nature" Click="StylePresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="0" Padding="8,0" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Dock Position -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Position" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="DockLeftBtn" Tag="Left" Content="Left" Click="DockPresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="46" Padding="8,0" FontSize="11" Margin="0,0,4,0" />
                                        <Button x:Name="DockCenterBtn" Tag="Center" Content="Center" Click="DockPresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="54" Padding="8,0" FontSize="11" Margin="0,0,4,0" />
                                        <Button x:Name="DockRightBtn" Tag="Right" Content="Right" Click="DockPresetBtn_Click" Style="{StaticResource InstallerSecondaryButton}" Height="24" MinWidth="48" Padding="8,0" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Virtual Pet -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Virtual Pet Companion" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="SetupPetToggle" Grid.Column="1" Style="{StaticResource InstallerToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons (Single primary action + secondary text button) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Button x:Name="CancelBtn"
                                    Content="Cancel"
                                    Style="{StaticResource InstallerSecondaryButton}"
                                    Click="Cancel_Click"
                                    IsCancel="True"
                                    Margin="0,0,12,0" />
                            <Button x:Name="ActionBtn"
                                    Content="Install"
                                    Style="{StaticResource InstallerPrimaryButton}"
                                    Click="ActionBtn_Click"
                                    IsDefault="True" />
                        </StackPanel>

                        <!-- Progressive Disclosure Link: Options -->
                        <Button x:Name="OptionsLinkBtn"
                                Content="Options"
                                Style="{StaticResource InstallerLinkButton}"
                                Click="OpenOptions_Click"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- STATE 2: UPDATING / INSTALLING -->
                    <StackPanel x:Name="ProgressStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- App Icon -->
                        <Border Width="64" Height="64"
                                CornerRadius="16"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                Background="{StaticResource BrushElevated}"
                                Margin="0,0,0,16">
                            <Image Source="pack://application:,,,/Assets/app_256.png"
                                   Width="64" Height="64"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Progress Title (Title 22px semibold) -->
                        <TextBlock x:Name="ProgressTitleText"
                                   Text="Installing Dynamic Island…"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6" />

                        <!-- Progress Status line (Body 14px regular #A1A1A6) -->
                        <TextBlock x:Name="ProgressStatusText"
                                   Text="Almost done…"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,20" />

                        <!-- 4px Thin Rounded Amber Progress Bar -->
                        <ProgressBar x:Name="InstallProgressBar"
                                     Style="{StaticResource InstallerProgressBar}"
                                     Width="280"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,24" />

                        <!-- Cancel text button -->
                        <Button x:Name="ProgressCancelBtn"
                                Content="Cancel"
                                Style="{StaticResource InstallerSecondaryButton}"
                                Click="Cancel_Click"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- STATE 3: DONE (You're all set.) -->
                    <StackPanel x:Name="DoneStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Neutral Checkmark Badge (Primary text color #F5F5F7, NOT green) -->
                        <Border Width="56" Height="56"
                                CornerRadius="28"
                                Background="{StaticResource BrushElevated}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path x:Name="DoneCheckPath"
                                  Data="M 17,28 L 24,35 L 39,19"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <!-- Done Title (Title 22px semibold) -->
                        <TextBlock x:Name="DoneTitleText"
                                   Text="You're all set."
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6" />

                        <!-- Done Subtitle (Body 14px regular) -->
                        <TextBlock x:Name="DoneSubtitleText"
                                   Text="Dynamic Island is up to date."
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14" />

                        <!-- First-Time Quick-Start Tips (hidden on upgrades) -->
                        <StackPanel x:Name="FirstTimeTipsPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Border Background="{StaticResource BrushElevated}" BorderBrush="{StaticResource BrushOutline}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" MaxWidth="380">
                                <TextBlock Text="Hover top pill to expand · Ctrl+Alt+G for Command Palette · Drag files onto pill for Drop Shelf"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           LineHeight="17" />
                            </Border>
                            <Button x:Name="OpenNotifSettingsBtn"
                                    Content="Enable Windows Notification access…"
                                    Style="{StaticResource InstallerLinkButton}"
                                    Click="OpenNotifSettingsBtn_Click"
                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Buttons: Open Dynamic Island / Close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Close"
                                    Style="{StaticResource InstallerSecondaryButton}"
                                    Click="CloseBtn_Click"
                                    Margin="0,0,12,0" />
                            <Button x:Name="LaunchBtn"
                                    Content="Open Dynamic Island"
                                    Style="{StaticResource InstallerPrimaryButton}"
                                    Click="Launch_Click"
                                    IsDefault="True" />
                        </StackPanel>
                    </StackPanel>

                    <!-- STATE 4: ERROR (Failure recovery) -->
                    <StackPanel x:Name="ErrorStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Error Icon (#FF453A) -->
                        <Border Width="56" Height="56"
                                CornerRadius="28"
                                Background="{StaticResource BrushElevated}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Data="M 28,16 L 28,28 M 28,34 L 28,36"
                                  Stroke="{StaticResource BrushError}"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <!-- Error Title -->
                        <TextBlock x:Name="ErrorTitleText"
                                   Text="Couldn't finish the update."
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6" />

                        <!-- Error Reason (One sentence, plain English) -->
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="Close any running instances of Dynamic Island and try again."
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   LineHeight="20"
                                   Margin="0,0,0,20" />

                        <!-- Buttons: Try again / Close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Content="Close"
                                    Style="{StaticResource InstallerSecondaryButton}"
                                    Click="CloseBtn_Click"
                                    Margin="0,0,12,0" />
                            <Button Content="Try again"
                                    Style="{StaticResource InstallerPrimaryButton}"
                                    Click="Retry_Click"
                                    IsDefault="True" />
                        </StackPanel>

                        <!-- Copy technical details link -->
                        <Button x:Name="CopyDetailsBtn"
                                Content="Copy details"
                                Style="{StaticResource InstallerLinkButton}"
                                Click="CopyDetails_Click"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                </Grid>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!--  OPTIONS VIEW CONTAINER (Progressive disclosure sub-pane)     -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Grid x:Name="OptionsViewContainer"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      MaxWidth="416">
                    <StackPanel>
                        <!-- Options Title -->
                        <TextBlock Text="Options"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,0,0,18" />

                        <!-- Install Location Section -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Install location"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="InstallPathText"
                                           Text="%LocalAppData%\Programs\DynamicIsland"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Change…"
                                    Style="{StaticResource InstallerSecondaryButton}"
                                    Height="28" MinWidth="68" Padding="10,0"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    VerticalAlignment="Center"
                                    Click="BrowseFolderBtn_Click" />
                        </Grid>

                        <!-- Drive Free Space line (Caption 12px) -->
                        <TextBlock x:Name="DriveSpaceText"
                                   Text="24.2 GB free on C:"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource BrushTextDisabled}"
                                   Margin="0,0,0,16" />

                        <!-- Subtle 1px Divider -->
                        <Border Height="1" Background="{StaticResource BrushDivider}" Margin="0,0,0,16" />

                        <!-- Toggle 1: Autostart -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Start when I sign in to Windows"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoStartToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource InstallerToggleSwitch}"
                                      IsChecked="True"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Toggle 2: Desktop Shortcut -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Add a desktop shortcut"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="DesktopShortcutToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource InstallerToggleSwitch}"
                                      IsChecked="False"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Toggle 3: Start Menu Shortcut -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Add to Start menu"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="StartMenuToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource InstallerToggleSwitch}"
                                      IsChecked="True"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Done Button (Returns to Main Screen) -->
                        <Button Content="Done"
                                Style="{StaticResource InstallerPrimaryButton}"
                                Height="34" MinWidth="88"
                                HorizontalAlignment="Right"
                                Click="BackToMain_Click" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
