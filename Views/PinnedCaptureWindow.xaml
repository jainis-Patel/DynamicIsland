<Window x:Class="DynamicIsland.Views.PinnedCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinned Screen Capture"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel">
    <Border Margin="8" CornerRadius="10" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Border CornerRadius="9" ClipToBounds="True">
                <Image x:Name="CaptureImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Floating top-right mini controls -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" CornerRadius="8" Background="#D812121A" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Button Click="CopyBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" ToolTip="Copy Image">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9.5" Foreground="#F5F5F7" />
                    </Button>
                    <Button Click="CloseBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" ToolTip="Close Pin">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9.5" Foreground="#FF453A" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Floating bottom-right resize grip -->
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="3" Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta" Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <Path Data="M 10,4 L 4,10 M 10,7 L 7,10 M 10,10 L 10,10" Stroke="#60FFFFFF" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="2" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
