<Window x:Class="DynamicIsland.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Mini Player"
        Width="388" Height="228"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Minimal circle button for detached player toolbars -->
            <Style x:Key="PlayerCircleBtn" TargetType="Button" BasedOn="{StaticResource CircleButton}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>

            <!-- Active / Accent-highlighted button style -->
            <Style x:Key="PlayerAccentCircleBtn" TargetType="Button" BasedOn="{StaticResource PlayerCircleBtn}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="#0A0A0C" />
                <Setter Property="BorderBrush" Value="#00000000" />
            </Style>

            <!-- Pill Segment Tab Button -->
            <Style x:Key="PlayerSegmentBtn" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SegBd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SegBd" Property="Background" Value="#18FFFFFF" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Shadow Padding Frame -->
    <Grid Margin="10">
        <!-- Root Card Container: Continuous Squircle matching Dynamic Island -->
        <Border x:Name="RootCard"
                Background="{DynamicResource PillBackgroundBrush}"
                BorderBrush="{DynamicResource PillStrokeBrush}"
                BorderThickness="1"
                CornerRadius="26"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- Dynamic Ambient Halo (Reacts to Album Artwork Color) -->
                <Ellipse x:Name="MiniAmbientHalo" Width="380" Height="140"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-40,0,0"
                         Opacity="0.22" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="MiniAmbientBrush">
                            <GradientStop x:Name="MiniAmbientStop" Color="#FF9F0A" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  MODE 1: FULL EXPANDED PLAYER VIEW                    -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="FullPlayerView" Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header (Artwork + Info + Window Controls) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Timeline Scrubber -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Transport & Media Controls -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Action Toolbar (Volume, Queue, Lyrics, Search) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Expandable Drawer Host (Song List / Lyrics) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Header ──────────────────────────────── -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Artwork Squircle with Click-to-Focus Player -->
                        <Border Width="50" Height="50" CornerRadius="13"
                                Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                ClipToBounds="True" VerticalAlignment="Center" Cursor="Hand"
                                MouseLeftButtonDown="Artwork_Click"
                                ToolTipService.ToolTip="Click to open active media player">
                            <Grid>
                                <TextBlock x:Name="MiniArtFallback" Style="{StaticResource Glyph}"
                                           Text="&#xE8D6;" FontSize="20"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="MiniArtImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Track Metadata & Interactive Badges -->
                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MiniTitleText" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"
                                       Text="Not Playing" Cursor="Hand" MouseLeftButtonDown="Title_Click"
                                       ToolTipService.ToolTip="Click to copy Track Title" />

                            <TextBlock x:Name="MiniArtistText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,1.5,0,0" Text="System Audio" />

                            <!-- Badge Strip: Source App + Live Equalizer Wave -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                <!-- Source App Badge with Brand Logo & Cycle Support -->
                                <Border x:Name="SourceAppBadge" CornerRadius="6" Background="#18FFFFFF"
                                        BorderBrush="#25FFFFFF" BorderThickness="1" Padding="6,1.5" Cursor="Hand"
                                        MouseLeftButtonDown="SourceBadge_Click"
                                        ToolTipService.ToolTip="Click to cycle active media players">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox x:Name="SourceAppLogoBox" Width="9.5" Height="9.5" Margin="0,0,3.5,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path x:Name="SourceAppLogoPath" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
                                        </Viewbox>
                                        <TextBlock x:Name="SourceAppIcon" Style="{StaticResource Glyph}"
                                                   Text="&#xE8D6;" FontSize="8.5"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,3.5,0" />
                                        <TextBlock x:Name="SourceAppText" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" Text="Media" />
                                        <TextBlock x:Name="SourceCycleIcon" Style="{StaticResource Glyph}"
                                                   Text="&#xE8D8;" FontSize="8"
                                                   Foreground="{DynamicResource SecondaryBrush}" Margin="3.5,0,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- Mini Live Audio Equalizer Bars -->
                                <Border Margin="6,0,0,0" CornerRadius="6" Background="#14FFFFFF"
                                        BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="4,2" Height="17" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="12">
                                        <Rectangle x:Name="EqBar0" Style="{StaticResource Bar}" Height="7" Width="2" Margin="1,0" VerticalAlignment="Bottom" />
                                        <Rectangle x:Name="EqBar1" Style="{StaticResource Bar}" Height="11" Width="2" Margin="1,0" VerticalAlignment="Bottom" />
                                        <Rectangle x:Name="EqBar2" Style="{StaticResource Bar}" Height="9" Width="2" Margin="1,0" VerticalAlignment="Bottom" />
                                        <Rectangle x:Name="EqBar3" Style="{StaticResource Bar}" Height="6" Width="2" Margin="1,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Border>

                                <!-- Album / Track Position Badge (e.g. #3 of 12) -->
                                <Border x:Name="TrackIndexBadge" Margin="6,0,0,0" CornerRadius="6"
                                        Background="#10FFFFFF" Padding="5,1.5" Visibility="Collapsed">
                                    <TextBlock x:Name="TrackIndexText" Style="{StaticResource Digits}"
                                               FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Text="#1" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Window Header Action Cluster -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Pin / Always on Top Toggle -->
                            <Button x:Name="PinButton" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24"
                                    ToolTipService.ToolTip="Toggle Always-on-Top" Click="PinButton_Click">
                                <TextBlock x:Name="PinGlyph" Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="9.5" />
                            </Button>

                            <!-- Mini Pill Compact Toggle -->
                            <Button x:Name="CompactPillToggleBtn" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="3,0,0,0"
                                    ToolTipService.ToolTip="Switch to Compact Floating Pill" Click="CompactMode_Click">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="9.5" />
                            </Button>

                            <!-- Dock to Island Button -->
                            <Button x:Name="DockButton" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="3,0,0,0"
                                    ToolTipService.ToolTip="Dock back to Dynamic Island" Click="DockToIsland_Click">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A6;" FontSize="9.5" />
                            </Button>

                            <!-- Close Button -->
                            <Button x:Name="CloseButton" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="3,0,0,0"
                                    ToolTipService.ToolTip="Close Detached Player" Click="Close_Click">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Row 1: Timeline Slider ─────────────────────── -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="MiniPosText" Grid.Column="0" Style="{StaticResource Digits}"
                                   FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center" Text="0:00" />

                        <Slider x:Name="MiniTimelineSlider" Grid.Column="1" Style="{StaticResource IslandSlider}"
                                Margin="6,0" Minimum="0" Maximum="100" Value="0"
                                PreviewMouseLeftButtonDown="MiniTimelineSlider_PreviewMouseDown"
                                PreviewMouseMove="MiniTimelineSlider_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="MiniTimelineSlider_PreviewMouseUp" />

                        <TextBlock x:Name="MiniDurText" Grid.Column="2" Style="{StaticResource Digits}"
                                   FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Text="0:00" />
                    </Grid>

                    <!-- ── Row 2: Transport & Media Controls ──────────── -->
                    <Grid Grid.Row="2" Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Centered Transport Pill Cluster -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Shuffle Button -->
                            <Button x:Name="MiniShuffleBtn" Style="{StaticResource PlayerCircleBtn}" Width="28" Height="28" Margin="0,0,4,0"
                                    Click="Shuffle_Click" ToolTipService.ToolTip="Toggle Shuffle">
                                <TextBlock x:Name="MiniShuffleGlyph" Style="{StaticResource Glyph}" FontSize="10.5" Text="&#xE8B1;" />
                            </Button>

                            <!-- Previous Track Button -->
                            <Button x:Name="MiniPrevBtn" Style="{StaticResource PlayerCircleBtn}" Width="30" Height="30" Margin="2,0"
                                    Click="Prev_Click" ToolTipService.ToolTip="Previous Track">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE892;" />
                            </Button>

                            <!-- Apple-style Primary Play/Pause Pill Button -->
                            <Button x:Name="MiniPlayPauseBtn" Style="{StaticResource PlayerCircleBtn}"
                                    Width="36" Height="36" Margin="5,0"
                                    Background="{DynamicResource MediaPlayButtonBgBrush}"
                                    Foreground="{DynamicResource MediaPlayButtonFgBrush}"
                                    Click="PlayPause_Click" ToolTipService.ToolTip="Play / Pause">
                                <TextBlock x:Name="MiniPlayPauseGlyph" Style="{StaticResource Glyph}"
                                           FontSize="13" Text="&#xE768;" />
                            </Button>

                            <!-- Next Track Button -->
                            <Button x:Name="MiniNextBtn" Style="{StaticResource PlayerCircleBtn}" Width="30" Height="30" Margin="2,0"
                                    Click="Next_Click" ToolTipService.ToolTip="Next Track">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE893;" />
                            </Button>

                            <!-- Repeat Mode Button -->
                            <Button x:Name="MiniRepeatBtn" Style="{StaticResource PlayerCircleBtn}" Width="28" Height="28" Margin="4,0,0,0"
                                    Click="Repeat_Click" ToolTipService.ToolTip="Cycle Repeat (Off / All / One)">
                                <TextBlock x:Name="MiniRepeatGlyph" Style="{StaticResource Glyph}" FontSize="10.5" Text="&#xE8EE;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Row 3: Action Toolbar (Volume, Queue, Lyrics, Search) -->
                    <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,4"
                            Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Volume Slider Cluster -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <!-- Action Buttons Cluster -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Volume Control (Mute Toggle + Inline Slider) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MiniVolumeMuteBtn" Style="{StaticResource PlayerCircleBtn}" Width="22" Height="22"
                                        Click="VolumeMute_Click" ToolTipService.ToolTip="Toggle Mute">
                                    <TextBlock x:Name="MiniVolumeGlyph" Style="{StaticResource Glyph}" FontSize="9.5" Text="&#xE767;" />
                                </Button>
                                <Slider x:Name="MiniVolumeSlider" Style="{StaticResource IslandSlider}"
                                        Width="68" Margin="5,0,0,0" Minimum="0" Maximum="100" Value="50"
                                        ValueChanged="VolumeSlider_ValueChanged" ToolTipService.ToolTip="System Master Volume" />
                            </StackPanel>

                            <!-- Right Tools: Queue / Lyrics / Search / Copy -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Song Queue Drawer Toggle -->
                                <Button x:Name="ToggleSongListBtn" Style="{StaticResource PlayerCircleBtn}"
                                        Width="Auto" Height="24" Padding="7,0" Margin="0,0,3,0"
                                        Click="ToggleSongList_Click" ToolTipService.ToolTip="Fetch song list &amp; view active players / history">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="9.5" Margin="0,0,3.5,0" />
                                        <TextBlock x:Name="QueueBtnLabel" FontSize="9.5" FontWeight="SemiBold" Text="Songs" />
                                    </StackPanel>
                                </Button>

                                <!-- Synced Lyrics Drawer Toggle -->
                                <Button x:Name="ToggleLyricsBtn" Style="{StaticResource PlayerCircleBtn}"
                                        Width="Auto" Height="24" Padding="7,0" Margin="0,0,3,0"
                                        Click="ToggleLyrics_Click" ToolTipService.ToolTip="Toggle Synced Karaoke Lyrics">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4F;" FontSize="9.5" Margin="0,0,3.5,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="Lyrics" />
                                    </StackPanel>
                                </Button>

                                <!-- Search on Spotify / Web Button -->
                                <Button x:Name="SearchTrackBtn" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="0,0,3,0"
                                        Click="SearchTrack_Click" ToolTipService.ToolTip="Search track on Spotify / YouTube">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="9.5" />
                                </Button>

                                <!-- Copy Track Info Button -->
                                <Button x:Name="CopyTrackBtn" Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24"
                                        Click="CopyTrack_Click" ToolTipService.ToolTip="Copy Track &amp; Artist to Clipboard">
                                    <TextBlock x:Name="CopyTrackGlyph" Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="9.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Row 4: Expandable Drawer Host ──────────────── -->
                    <Grid Grid.Row="4" x:Name="DrawerHost" Margin="0,8,0,0" Visibility="Collapsed">

                        <!-- ─── Drawer A: Songs & Active Players Hub ───── -->
                        <Border x:Name="SongListDrawer" Background="#12FFFFFF" BorderBrush="#1FFFFFFF"
                                BorderThickness="1" CornerRadius="16" Padding="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Segmented Tab Control + Refresh Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Segmented Pills: [Album Tracks] [Active Players] [History] -->
                                    <Border Background="#16000000" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="TabAlbumTracksBtn" Style="{StaticResource PlayerSegmentBtn}"
                                                    Content="Album Tracks" Click="TabAlbumTracks_Click" />
                                            <Button x:Name="TabActivePlayersBtn" Style="{StaticResource PlayerSegmentBtn}"
                                                    Content="Active Players" Click="TabActivePlayers_Click" />
                                            <Button x:Name="TabHistoryBtn" Style="{StaticResource PlayerSegmentBtn}"
                                                    Content="History" Click="TabHistory_Click" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Refresh / Fetch Button -->
                                    <Button Grid.Column="1" x:Name="RefreshTracksBtn" Style="{StaticResource PlayerCircleBtn}"
                                            Width="22" Height="22" Click="RefreshTracks_Click"
                                            ToolTipService.ToolTip="Refresh &amp; fetch latest tracks">
                                        <TextBlock x:Name="RefreshTracksGlyph" Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="9" />
                                    </Button>
                                </Grid>

                                <!-- Content Panels for each Tab -->
                                <Grid Grid.Row="1">
                                    <!-- TAB 1: Album Tracklist View -->
                                    <Grid x:Name="AlbumTracksPanel" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Album Header Summary -->
                                        <TextBlock x:Name="AlbumSummaryText" Grid.Row="0" FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource SecondaryBrush}" Margin="4,0,0,4"
                                                   TextTrimming="CharacterEllipsis" Text="Fetching album tracklist..." />

                                        <!-- Tracks ScrollViewer -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="AlbumTracksListHost" />
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- TAB 2: Active Windows Media Players View -->
                                    <Grid x:Name="ActivePlayersPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource SecondaryBrush}" Margin="4,0,0,4"
                                                   Text="Active Players across Windows (Click to switch):" />

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ActivePlayersListHost" />
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- TAB 3: Session History View -->
                                    <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource SecondaryBrush}" Margin="4,0,0,4"
                                                   Text="Recently Played in this Session:" />

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="HistoryListHost" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ─── Drawer B: Synchronized Karaoke Lyrics ───── -->
                        <Border x:Name="LyricsDrawer" Background="#12FFFFFF" BorderBrush="#1FFFFFFF"
                                BorderThickness="1" CornerRadius="16" Padding="10,8" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Lyrics Header with Provider indicator -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               Text="♪ Synced Karaoke Lyrics (LRCLIB)" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LyricsStatusText" FontSize="9.5" Foreground="{DynamicResource SecondaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Text="" />
                                </Grid>

                                <!-- Karaoke Stage: Previous, Active (Highlighted), Next -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="LyricsStageHost" VerticalAlignment="Center">
                                        <TextBlock x:Name="LyricLinePrev" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"
                                                   Opacity="0.4" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2" />
                                        <TextBlock x:Name="LyricLineCurrent" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,5" Text="♪ Loading lyrics..." />
                                        <TextBlock x:Name="LyricLineNext" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"
                                                   Opacity="0.5" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  MODE 2: COMPACT FLOATING PILL VIEW                   -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="CompactPillView" Margin="10,6,10,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Mini 28x28 Artwork with Brand Pip -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                            Background="#18FFFFFF" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="11"
                                       Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CompactArtImage" Stretch="UniformToFill" />
                            <Border x:Name="CompactBrandPip" Width="10" Height="10" CornerRadius="5" Background="#D5000000"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Visibility="Collapsed">
                                <Viewbox Width="6.5" Height="6.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="CompactBrandPath" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title & Artist (Compact Marquee) -->
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactTitleText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="Not Playing" />
                        <TextBlock x:Name="CompactArtistText" FontSize="9"
                                   Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Text="System Audio" />
                    </StackPanel>

                    <!-- Compact Controls: Play/Pause, Next, Expand -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Click="PlayPause_Click">
                            <TextBlock x:Name="CompactPlayPauseGlyph" Style="{StaticResource Glyph}" FontSize="9.5" Text="&#xE768;" />
                        </Button>
                        <Button Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="3,0,0,0" Click="Next_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE893;" />
                        </Button>
                        <Button Style="{StaticResource PlayerCircleBtn}" Width="24" Height="24" Margin="3,0,0,0"
                                Click="ExpandFromCompact_Click" ToolTipService.ToolTip="Expand Player">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>