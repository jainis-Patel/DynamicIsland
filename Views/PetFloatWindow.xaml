<Window x:Class="DynamicIsland.Views.PetFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Desktop Companion Roam"
        Width="146" Height="136"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FloatMicroBtn" TargetType="Button">
                <Setter Property="Width" Value="19" />
                <Setter Property="Height" Value="19" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Shadow Padding Frame -->
    <Grid Margin="8">
        <!-- Root Acrylic Continuous Squircle Card -->
        <Border x:Name="RootCard"
                Background="{DynamicResource PillBackgroundBrush}"
                BorderBrush="{DynamicResource PillStrokeBrush}"
                BorderThickness="1.2"
                CornerRadius="20"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid Margin="5,4,5,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Micro Toolbar (Reveals on Hover) -->
                <DockPanel Grid.Row="0" x:Name="TopToolbar" Opacity="0.3" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FloatPetSpeciesGlyph" Text="🐾" FontSize="8.5" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <TextBlock x:Name="FloatPetNameText" Text="Mochi" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="SpecialAction_Click" Style="{StaticResource FloatMicroBtn}" Margin="0,0,3,0" ToolTipService.ToolTip="Play signature species move">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" FontSize="8" Foreground="{DynamicResource CyanBrush}" />
                        </Button>
                        <Button Click="ReturnToIsland_Click" Style="{StaticResource FloatMicroBtn}" ToolTipService.ToolTip="Return companion to island capsule">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7.5" Foreground="{DynamicResource SecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Center: Big Roam Pet (98x80 px) -->
                <core:VirtualPetControl x:Name="FloatPet"
                                        Grid.Row="1"
                                        Width="98" Height="80"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Pet_Click"
                                        MouseRightButtonUp="Pet_RightClick"
                                        ToolTipService.ToolTip="Click to pet · Right-click for flip · Drag window to move" />

                <!-- Bottom Micro Pill (Score & Mood) -->
                <Border Grid.Row="2" Background="#12FFFFFF" CornerRadius="6" Padding="6,1" HorizontalAlignment="Center" Margin="0,1,0,1">
                    <TextBlock x:Name="FloatStatusText" Text="❤️ 85 · Happy" FontSize="7.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
