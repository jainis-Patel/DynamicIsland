<Window x:Class="DynamicIsland.Views.PetFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Desktop Companion Roam"
        Width="116" Height="106"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FloatMicroBtn" TargetType="Button">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="BorderBrush" Value="#2FFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3EFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Completely Background-Free Transparent Stage: Only the Pet renders on Desktop -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hover-Only Micro Pill Toolbar (Hidden at rest: Opacity=0, IsHitTestVisible=False) -->
        <Border Grid.Row="0"
                x:Name="TopToolbar"
                HorizontalAlignment="Center"
                Background="#D4101116"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="5,2"
                Margin="0,0,0,2"
                Opacity="0"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FloatPetNameText" Text="Mochi" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,5,0" MaxWidth="48" TextTrimming="CharacterEllipsis" />
                <Button Click="SpecialAction_Click" Style="{StaticResource FloatMicroBtn}" Margin="0,0,2.5,0" ToolTipService.ToolTip="Play signature species move">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" FontSize="7.5" Foreground="{DynamicResource CyanBrush}" />
                </Button>
                <Button x:Name="AutoRoamToggleBtn" Click="AutoRoamToggle_Click" Style="{StaticResource FloatMicroBtn}" Margin="0,0,2.5,0" ToolTipService.ToolTip="Toggle autonomous desktop roaming">
                    <TextBlock x:Name="AutoRoamGlyph" Style="{StaticResource Glyph}" Text="&#xE816;" FontSize="7.5" Foreground="{DynamicResource AccentBrush}" />
                </Button>
                <Button Click="ReturnToIsland_Click" Style="{StaticResource FloatMicroBtn}" ToolTipService.ToolTip="Return companion to island capsule">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="7" Foreground="{DynamicResource SecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Frameless Pet Directly on Desktop -->
        <core:VirtualPetControl x:Name="FloatPet"
                                Grid.Row="1"
                                Width="96" Height="80"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                RenderTransformOrigin="0.5,0.5"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="Pet_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Pet_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Pet_PreviewMouseLeftButtonUp"
                                MouseRightButtonUp="Pet_RightClick"
                                ToolTipService.ToolTip="Click to pet · Right-click for flip · Drag to move">
            <core:VirtualPetControl.RenderTransform>
                <ScaleTransform x:Name="FloatPetFlipScale" ScaleX="1" ScaleY="1" />
            </core:VirtualPetControl.RenderTransform>
        </core:VirtualPetControl>
    </Grid>
</Window>
