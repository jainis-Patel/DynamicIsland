<Window x:Class="DynamicIsland.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Clipboard Picker"
        Width="296" Height="272"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="ClipboardCard" Margin="10" CornerRadius="16" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid Margin="11,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="Quick Paste Picker" FontSize="10.5" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                </StackPanel>
                <Button Click="PopQueueBtn_Click" x:Name="PopQueueBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="18" Padding="6,0" Visibility="Collapsed" ToolTip="Pop &amp; copy next item in sequential paste queue">
                    <TextBlock x:Name="PopQueueBtnText" Text="Queue (0)" FontSize="8.5" FontWeight="Bold" Foreground="#30D158" />
                </Button>
            </DockPanel>

            <!-- Search Box -->
            <Border Grid.Row="1" Background="#1C1C26" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Height="24" Padding="6,0" Margin="0,0,0,6">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="9" Foreground="#8E8E93" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0" FontSize="10" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                </DockPanel>
            </Border>

            <!-- Clips List -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClipsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#181820" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,4"
                                    Cursor="Hand" MouseLeftButtonDown="ClipRow_Click" ToolTip="Click to copy · Shift+Click for Plain Text">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="{Binding Id}" Click="PlainCopyBtn_Click" Style="{StaticResource IslandButton}" Height="17" Padding="5,0" Margin="0,0,3,0" ToolTip="Copy as Plain Text (strip formatting)">
                                            <TextBlock Text="Plain" FontSize="7.5" FontWeight="SemiBold" Foreground="#0A84FF" />
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="QueueAddBtn_Click" Style="{StaticResource IslandButton}" Height="17" Padding="5,0" ToolTip="Add to Sequential Paste Queue">
                                            <TextBlock Text="+Q" FontSize="7.5" FontWeight="Bold" Foreground="#30D158" />
                                        </Button>
                                    </StackPanel>
                                    <Border Background="{Binding BadgeColorBrush}" CornerRadius="3" Padding="3.5,0.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeTag}" FontSize="7" FontWeight="Bold" Foreground="#0B0B0E" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="9.5" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Grid>
    </Border>
</Window>
