<Window x:Class="DynamicIsland.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DynamicIsland.Core"
        Title="Quick Clipboard Picker"
        Width="388" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="ClipboardCard" Margin="10" CornerRadius="18" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource PillStrokeBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="24" Height="24" Margin="0,0,7,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Quick Paste Picker" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Click="PopQueueBtn_Click" x:Name="PopQueueBtn" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Height="22" Padding="8,0" Visibility="Collapsed" ToolTip="Pop &amp; copy next item in sequential paste queue">
                    <TextBlock x:Name="PopQueueBtnText" Text="Queue (0)" FontSize="9" FontWeight="Bold" Foreground="#30D158" />
                </Button>
            </DockPanel>

            <!-- Search Box -->
            <Border Grid.Row="1" Background="{DynamicResource ChipBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="28" Padding="9,0" Margin="0,0,0,9">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" />
                </DockPanel>
            </Border>

            <!-- Clips List -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ClipsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,5"
                                    Cursor="Hand" MouseLeftButtonDown="ClipRow_Click" ToolTip="Click to copy · Shift+Click for Plain Text">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel LastChildFill="True">
                                    <!-- Right: Quick Plain / Queue Actions -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Tag="{Binding Id}" Click="PlainCopyBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6.5,0" Margin="0,0,4,0" ToolTip="Copy as Plain Text (strip formatting)">
                                            <TextBlock Text="Plain" FontSize="8" FontWeight="SemiBold" Foreground="#0A84FF" />
                                        </Button>
                                        <Button Tag="{Binding Id}" Click="QueueAddBtn_Click" Style="{StaticResource IslandButton}" Height="20" Padding="6.5,0" ToolTip="Add to Sequential Paste Queue">
                                            <TextBlock Text="+Q" Style="{StaticResource Digits}" FontSize="8" FontWeight="Bold" Foreground="#30D158" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Left: Visual Thumbnail or Swatch + Type Tag -->
                                    <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,9,0">
                                        <Border Width="38" Height="28" CornerRadius="7" ClipToBounds="True" core:RoundedClip.ClipChild="True"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="{Binding SwatchBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Border Background="{Binding BadgeColorBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsColor}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TypeTag}" FontSize="7.5" FontWeight="Bold" Foreground="#0B0B0E" />
                                        </Border>
                                    </Grid>

                                    <!-- Center: 2-Line Snippet + Metadata -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewSnippet}" FontSize="10" FontWeight="Medium" LineHeight="13.5" MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Opacity="0.85" TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="TimeAgo" />
                                                    <Binding Path="CardFooterText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
