root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,props,targets}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{json,md}]
indent_style = space
indent_size = 2
