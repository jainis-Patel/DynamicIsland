<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ TFM exposes the WinRT projections (Windows.Media.Control, Windows.System.Power, Windows.Devices.*). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <!-- Per-Monitor V2 DPI awareness so GetCursorPos/GetWindowRect return physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI loopback capture + FFT for the live audio meter. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <Target Name="SyncPublishFolder" AfterTargets="Build" Condition="Exists('$(ProjectDir)publish')">
    <Exec Command="powershell -NoProfile -Command &quot;Remove-Item -Force '$(ProjectDir)publish\DynamicIsland.dll.old','$(ProjectDir)publish\DynamicIsland.exe.old' -ErrorAction SilentlyContinue; if (Test-Path '$(ProjectDir)publish\DynamicIsland.dll') { Move-Item -Force '$(ProjectDir)publish\DynamicIsland.dll' '$(ProjectDir)publish\DynamicIsland.dll.old' -ErrorAction SilentlyContinue }; if (Test-Path '$(ProjectDir)publish\DynamicIsland.exe') { Move-Item -Force '$(ProjectDir)publish\DynamicIsland.exe' '$(ProjectDir)publish\DynamicIsland.exe.old' -ErrorAction SilentlyContinue }; Copy-Item -Force '$(TargetDir)DynamicIsland.dll' '$(ProjectDir)publish\DynamicIsland.dll' -ErrorAction SilentlyContinue; Copy-Item -Force '$(TargetDir)DynamicIsland.exe' '$(ProjectDir)publish\DynamicIsland.exe' -ErrorAction SilentlyContinue; Remove-Item -Force '$(ProjectDir)publish\DynamicIsland.dll.old','$(ProjectDir)publish\DynamicIsland.exe.old' -ErrorAction SilentlyContinue&quot;"
          IgnoreExitCode="true" />
  </Target>

</Project>
