<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ TFM exposes the WinRT projections (Windows.Media.Control, Windows.System.Power, Windows.Devices.*). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <!-- Per-Monitor V2 DPI awareness so GetCursorPos/GetWindowRect return physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Authors>Jainis Patel</Authors>
    <Company>Jainis Patel</Company>
    <Product>Dynamic Island for Windows</Product>
    <Description>Liquid macOS-style Dynamic Island for Windows 10 and 11 created by Jainis Patel</Description>
    <Copyright>Copyright © 2026 Jainis Patel</Copyright>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- Avoid emitting 13 unused localized satellite resource folders in bin/ and publish/ -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>false</NuGetAudit>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="scratch\**" />
    <None Remove="scratch\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WASAPI loopback capture + FFT for the live audio meter. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app_256.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\LiquidGlass\Shaders\*.cso">
      <LogicalName>DynamicIsland.src.LiquidGlass.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


</Project>
